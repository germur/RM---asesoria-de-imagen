---
import "../styles/experience.css";
import BaseHead from "../components/seo/BaseHead.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import CookieConsent from "../components/ui/CookieConsent.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { cn } from "../lib/utils";

interface Props {
    title: string;
    description: string;
    class?: string;
    schema?: string | object;
    navbarTheme?: "light" | "dark";
    noindex?: boolean;
    breadcrumbsInFlow?: boolean;
}

const {
    title,
    description,
    class: className,
    schema,
    navbarTheme = "dark",
    noindex = false,
    breadcrumbsInFlow = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <BaseHead title={title} description={description} schema={schema} noindex={noindex} />
    </head>
    <body data-page={Astro.url.pathname} data-section={Astro.url.pathname.split("/")[1] || "inicio"}
        class={cn(
            "min-h-screen bg-brand-white text-brand-black font-sans antialiased flex flex-col",
            className,
        )}
    >
        <a class="skip-content" href="#contenido">Saltar al contenido</a>
        <Navbar theme={navbarTheme} />

        <Breadcrumbs theme={navbarTheme} inFlow={breadcrumbsInFlow} />

        <main id="contenido" class="flex-1 w-full relative">
            <slot />
        </main>

        <Footer />
        <CookieConsent />

        <script>
            // Global scroll-reveal observer for .reveal elements
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-in');
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -80px 0px' });

            document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
        </script>
    </body>
</html>
