---
import ServiceSymbol from './ServiceSymbol.astro';
const offers=[
 {id:'color',label:'Mis colores',kind:'color' as const,title:'Quiero conocer mi paleta.',intro:'Dos modalidades con alcances distintos. El informe digital parte de fotografías; la sesión presencial permite comparar textiles y aprender a combinarlos.',prices:[{label:'Informe digital',value:'$150.000',currency:'COP',note:'Análisis personal por fotografías.'},{label:'Sesión presencial',value:'$1.000.000',currency:'COP',note:'2,5–3 horas. Informe digital incluido.'}],items:['Orientación para preparar las fotografías del estudio digital.','Comparación de textiles en la modalidad presencial.','Informe con tu paleta y montajes de círculos cromáticos.'],note:'El test gratuito ofrece una orientación inicial; no sustituye el estudio personalizado.',href:'/servicios/colorimetria-bogota/',interest:'colorimetria',link:'Comparar las modalidades'},
 {id:'wardrobe',label:'Mi armario',kind:'wardrobe' as const,title:'Tengo ropa. Me faltan combinaciones.',intro:'Una revisión de tu armario y una ruta de compras preparada para las prendas, ocasiones y necesidades que quieres resolver.',prices:[{label:'Fondo de armario y personal shopper',value:'$1.600.000',currency:'COP',note:'Revisión a domicilio y jornada de compras acompañada.'}],items:['Revisión, depuración e inventario de tus prendas.','Orientación rápida de color y morfología.','Preparación de marcas y tiendas, y compras acompañadas.'],note:'Bogotá y alrededores. Confirma presupuesto para prendas, gastos incluidos y desplazamientos a otras ciudades.',href:'/servicios/asesoria-imagen-hombres-bogota/',interest:'fondo-armario',link:'Explorar el fondo de armario'},
 {id:'integral',label:'Un cambio integral',kind:'integral' as const,title:'Quiero trabajar mi imagen como un conjunto.',intro:'Identidad, cabello, color, vestuario y decisiones para distintos escenarios de tu vida. Un acompañamiento más amplio, desarrollado por fases.',prices:[{label:'Inversión publicada del programa integral',value:'1.650',currency:'USD',note:'Once fases. Aproximadamente un año de acompañamiento.'}],items:['Diagnóstico de identidad, visagismo, colorimetría y morfología.','Armario, rutas de compra y trabajo capilar dentro del alcance acordado.','Vestuario, etiqueta y protocolo para distintos contextos.'],note:'Valor expresado en dólares estadounidenses. Confirma pagos, encuentros, entregables y gastos adicionales con el estudio.',href:'/servicios/asesoria-integral-imagen/#inversion',interest:'integral',link:'Conocer las once fases'},
 {id:'hair',label:'Mi cabello',kind:'hair' as const,title:'Mi prioridad es el corte, el color o el peinado.',intro:'Una consulta específica para trabajar cabello, forma y preferencias. Puedes empezar por lo que necesitas ahora.',prices:[{label:'Según el servicio',value:'A consultar',currency:'',note:'El equipo confirma alcance y valor antes de reservar.'}],items:['Corte, color, peinado o visagismo según tu necesidad.','Una conversación sobre tu cabello, preferencias y rutina.','Confirmación del servicio y sus condiciones con el estudio.'],note:'Una cita de peluquería tiene un alcance distinto del programa integral; no necesitas contratar un proceso completo para consultar.',href:'/servicios/peluqueria/',interest:'peluqueria',link:'Explorar peluquería y visagismo'},
];
---
<section class="price-explorer" id="comparar" aria-labelledby="price-explorer-title">
 <header class="pe-heading"><div><p class="pe-kicker">01 / ENCUENTRA TU PUNTO DE PARTIDA</p><h2 id="price-explorer-title">No todos buscamos<br/><em>el mismo cambio.</em></h2></div><p>Elige lo que hoy quieres resolver. Compara la inversión publicada y el acompañamiento que hay detrás.</p></header>
 <div class="pe-choices" aria-label="Elegir una necesidad" hidden>{offers.map((offer,i)=><button type="button" data-choice={offer.id} aria-pressed={i===0?'true':'false'} aria-controls={`offer-${offer.id}`}><span class="pe-choice-icon"><ServiceSymbol kind={offer.kind}/></span><span>{offer.label}</span><b aria-hidden="true">↗</b></button>)}</div>
 <div>{offers.map((offer,i)=><section class={`pe-offer pe-${offer.id}`} id={`offer-${offer.id}`} data-offer={offer.id} aria-labelledby={`offer-title-${offer.id}`}>
  <div class="pe-art" aria-hidden="true"><span class="pe-art-meta">RM / 0{i+1}<small>ESTUDIO DE<br/>IMAGEN PERSONAL</small></span><div class="pe-symbol"><ServiceSymbol kind={offer.kind}/></div>{offer.id==='color'?<div class="pe-swatches">{['#4c2639','#c41230','#b77d69','#ded2bd','#243c42'].map(color=><i style={`background:${color}`}/>)}</div>:<span class="pe-art-line">{offer.id==='wardrobe'?'REVISAR → COMBINAR → ELEGIR':offer.id==='integral'?'IDENTIDAD → IMAGEN → CRITERIO':'FORMA → TEXTURA → MOVIMIENTO'}</span>}<p>{offer.title}</p><small>Ilustración conceptual del servicio</small></div>
  <div class="pe-info"><p class="pe-kicker">0{i+1} / {offer.label}</p><h3 id={`offer-title-${offer.id}`}>{offer.title}</h3><p class="pe-intro">{offer.intro}</p><div class:list={['pe-prices',{'pe-duo':offer.prices.length>1}]}>{offer.prices.map(price=><div><span>{price.label}</span><strong>{price.value}<small>{price.currency}</small></strong><p>{price.note}</p></div>)}</div><ul>{offer.items.map(text=><li><span aria-hidden="true">↗</span>{text}</li>)}</ul><p class="pe-note">{offer.note}</p><div class="pe-actions"><a class="pe-button" href={`/contacto/?interes=${offer.interest}#form`}>Consultar este servicio <span aria-hidden="true">↗</span></a><a class="pe-link" href={offer.href}>{offer.link} →</a></div></div>
 </section>)}</div>
 <p class="pe-footnote">COP = pesos colombianos · USD = dólares estadounidenses. Confirma valores vigentes, disponibilidad y condiciones antes de reservar.</p>
</section>
<script>
document.querySelectorAll<HTMLElement>('.price-explorer').forEach(root=>{const choices=root.querySelector<HTMLElement>('.pe-choices');const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-choice]'));const panels=Array.from(root.querySelectorAll<HTMLElement>('[data-offer]'));const select=(id:string)=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.choice===id)));panels.forEach(p=>p.hidden=p.dataset.offer!==id);};buttons.forEach(b=>b.addEventListener('click',()=>select(b.dataset.choice!)));select('color');if(choices)choices.hidden=false;});
</script>
<style>
.price-explorer{--pe-red:var(--color-brand-primary,#c41230);padding:65px 0;scroll-margin-top:130px}.price-explorer [hidden]{display:none!important}.pe-heading{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:32px}.pe-kicker{font-size:10px;letter-spacing:.14em;line-height:1.8;color:var(--pe-red);text-transform:uppercase;font-weight:500}.pe-heading h2{font:52px/1.05 'Playfair Display',Georgia,serif;letter-spacing:-.04em;margin-top:17px;color:#111}.pe-heading h2 em{color:var(--pe-red);font-weight:400}.pe-heading>p{max-width:310px;color:#626262;font-size:14px;line-height:1.9}.pe-choices{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:20px}.pe-choices button{display:flex;align-items:center;gap:12px;padding:18px 15px;border:1px solid #d3d3d3;text-align:left;font-size:12px;cursor:pointer;min-height:76px;transition:background .2s,color .2s}.pe-choice-icon{width:34px;height:34px;flex-shrink:0}.pe-choices b{color:var(--pe-red);margin-left:auto;font-weight:400;font-size:19px}.pe-choices button[aria-pressed=true]{background:#151515;color:#fff;border-color:#151515;--symbol-fill:#151515}.pe-choices button[aria-pressed=true] b{color:#ff8a9f}.pe-offer{display:grid;grid-template-columns:.72fr 1.28fr;border:1px solid #ddd;min-width:0}.pe-offer+.pe-offer{margin-top:25px}.pe-art{background:#151515;color:#fff;position:relative;min-height:580px;padding:30px;display:flex;flex-direction:column;justify-content:end;--symbol-fill:#151515;overflow:hidden}.pe-art-meta{position:absolute;top:25px;left:30px;display:flex;align-items:center;gap:20px;font:27px Georgia,serif}.pe-art-meta small{font:6px/1.7 Arial,sans-serif;letter-spacing:.12em;color:#ddd}.pe-symbol{position:absolute;top:115px;left:50%;width:230px;height:230px;transform:translateX(-50%) rotate(-8deg);color:#ddd8d0}.pe-color .pe-symbol{color:#dfb3be}.pe-swatches{display:flex;position:absolute;top:325px;left:50%;transform:translateX(-50%) rotate(-5deg);padding:10px;background:#f5f5f3;box-shadow:8px 12px 25px #0005}.pe-swatches i{width:39px;height:62px}.pe-art-line{position:absolute;left:25px;right:25px;top:375px;font-size:8px;letter-spacing:.1em;border-top:1px solid #555;padding-top:20px;text-align:center;color:#bbb}.pe-art>p{font:32px/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.025em;margin:25px 0}.pe-art>small{font-size:8px;color:#aaa}.pe-info{padding:35px 38px;min-width:0}.pe-info h3{font:32px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.03em;margin:17px 0;color:#111}.pe-intro{font-size:13px;line-height:1.9;color:#626262}.pe-prices{display:grid;margin:25px 0;border-block:1px solid #ddd}.pe-duo{grid-template-columns:1fr 1fr;gap:20px}.pe-prices>div{padding:22px 0;min-width:0}.pe-prices>div>span{font-size:10px;color:#626262}.pe-prices strong{display:flex;align-items:baseline;gap:8px;font:clamp(29px,3vw,43px)/1.2 'Playfair Display',Georgia,serif;letter-spacing:-.04em;margin-top:8px;color:#111}.pe-prices strong small{font:9px Arial,sans-serif;color:var(--pe-red);letter-spacing:.02em}.pe-prices p{font-size:10px;line-height:1.8;color:#626262;margin-top:9px}.pe-info ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}.pe-info li{font-size:12px;line-height:1.8;display:flex;gap:12px}.pe-info li>span{color:var(--pe-red);font-size:18px;flex-shrink:0}.pe-note{font-size:11px;color:#626262;line-height:1.9;margin:23px 0}.pe-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.pe-button{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;min-height:54px;padding:17px 23px;background:var(--pe-red);color:white;font-size:12px}.pe-button>span{font-size:22px;line-height:1}.pe-button:hover{background:#a00f28}.pe-link{font-size:11px;color:var(--pe-red);text-decoration:underline;text-underline-offset:5px;min-height:44px;display:inline-flex;align-items:center}.pe-footnote{font-size:10px;color:#626262;line-height:1.9;margin-top:20px;max-width:700px}.price-explorer :is(a,button):focus-visible{outline:3px solid var(--pe-red);outline-offset:4px}
@media(max-width:1000px){.pe-heading h2{font-size:44px}.pe-info{padding:28px}.pe-symbol{width:190px;height:190px}.pe-swatches i{width:31px}.pe-choices button{padding:15px 10px;gap:9px;font-size:11px}.pe-choice-icon{width:28px;height:28px}.pe-art{padding:25px}}
@media(max-width:700px){.price-explorer{padding:40px 0}.pe-heading{display:block;margin-bottom:25px}.pe-heading h2{font-size:37px}.pe-heading>p{max-width:none;font-size:13px;margin-top:20px}.pe-choices{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.pe-choices button{padding:12px 10px;min-height:65px}.pe-offer{grid-template-columns:minmax(0,1fr)}.pe-art{min-height:210px;height:210px;justify-content:center;padding:25px 20px}.pe-art-meta{top:17px;left:20px;font-size:21px}.pe-art-meta small{font-size:5px}.pe-symbol{width:140px;height:140px;top:32px;left:auto;right:9px;transform:rotate(-10deg)}.pe-art>p{font-size:25px;max-width:49%;margin:40px 0 0}.pe-art>small{position:absolute;bottom:12px;left:20px;font-size:6px}.pe-swatches{top:auto;bottom:23px;left:auto;right:10px;transform:rotate(-5deg);padding:6px}.pe-swatches i{width:22px;height:35px}.pe-art-line{display:none}.pe-info{padding:25px 20px}.pe-info h3{font-size:29px}.pe-info .pe-kicker{font-size:8px}.pe-duo{gap:15px}.pe-prices strong{font-size:29px;flex-wrap:wrap;gap:3px 6px}.pe-prices>div>span{font-size:9px}.pe-actions{display:grid;gap:10px}.pe-button{width:100%}.pe-footnote{font-size:9px}}
@media(prefers-reduced-motion:reduce){.pe-choices button{transition:none}}
</style>
