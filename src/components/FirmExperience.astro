const people=[
 {id:'roger',name:'Roger Murillo',role:'Asesor de imagen · Peinador · Maquillador',image:'/images/roger-portrait-bw.webp',number:'01',years:'35',specialty:'Visagismo, cabello y vestuario.',intro:'Su trabajo conecta las proporciones, el estilo y las ocasiones de tu vida. El punto de partida puede ser un corte, tu armario o un proceso de imagen más amplio.',areas:['Visagismo','Peluquería','Fondo de armario','Asesoría integral'],bio:[{title:'Formación y enfoque',text:'Psicólogo de formación y coach certificado en PNL. Su trayectoria como asesor de imagen, peinador y maquillador reúne trabajo con artistas, modelos, reinas de belleza y profesionales.'},{title:'Experiencia en imagen y medios',text:'Trabajó en Nueva York con Osmel Sousa y Paul Mickel como colorista profesional y se especializó en caracterización en la academia Lady Berth. Su trayectoria incluye televisión colombiana, dirección de arte y maquillaje para comerciales y docencia de Psicología del Mercado en la Universidad de los Andes y la Universidad Antonio Nariño.'},{title:'Trayectoria y publicación',text:'Nombrado Campeón de Campeones en 1993 por Silueta. Su experiencia incluye participación en Intercoiffure. Es coautor del libro Revoluciona tu Imagen.'}],link:'/servicios/asesoria-imagen-hombres-bogota/',action:'Conocer fondo de armario y compras'},
 {id:'adriana',name:'Adriana Garzón',role:'Asesora de imagen · Especialista en color',image:'/images/adriana-portrait-bw.webp',number:'02',years:'22',specialty:'Color, forma y sensibilidad artística.',intro:'Relaciona colorimetría, cabello y estilo personal. Su formación como estilista y asesora de imagen se encuentra con su práctica de la pintura y el retrato.',areas:['Colorimetría','Diseño de color','Visagismo','Asesoría de imagen'],bio:[{title:'Formación en imagen y color',text:'Estilista profesional, especialista en colorimetría y asesora de imagen. Su formación publicada incluye certificaciones del IDB (Institute of Design Barcelona), el New York Institute y el Instituto de Imagen Personal.'},{title:'Áreas de trabajo',text:'Su experiencia abarca colorimetría digital y con textiles, visagismo aplicado, análisis morfológico, asesoría integral, personal shopping y fondo de armario.'},{title:'El color también como lenguaje artístico',text:'Pintora al óleo y dibujante de retratos. Es coautora del libro Revoluciona tu Imagen. Su interés por el color y el dibujo acompaña su mirada sobre estilo e identidad.'}],link:'/servicios/colorimetria-bogota/',action:'Conocer el estudio de colorimetría'}
];
---
<div class="firm-experience">
 <section class="firm-cover" aria-labelledby="firm-title"><div class="firm-cover-inner"><div class="firm-cover-copy"><span class="firm-label"><i></i>LA FIRMA / BOGOTÁ</span><p class="firm-cover-pre">Dos miradas. Un mismo criterio.</p><h1 id="firm-title">Roger Murillo <br/><em>& Adriana <br/>Garzón.</em></h1><p class="firm-cover-intro">Cabello, color y vestuario.<br/>Personas antes que fórmulas.</p><div class="firm-cover-actions"><a href="#equipo">Conoce al equipo <span aria-hidden="true">↘︎</span></a><a href="/servicios/">Explorar servicios ↗</a></div></div><div class="firm-cover-portraits">{people.map(person=><a href={`#${person.id}`} class={`cover-${person.id}`} aria-label={`Conocer a ${person.name}`}><img src={person.image} alt={person.name} width="640" height="900" fetchpriority={person.id==='roger'?'high':undefined}/><span class="cover-photo-label"><small>{person.number} / LA FIRMA</small><strong>{person.name}</strong><span aria-hidden="true">↗</span></span></a>)}<span class="firm-cover-side" aria-hidden="true">IMAGE ADVISORS / ROGER MURILLO</span></div></div><div class="firm-cover-bottom"><span>Asesores de imagen en Bogotá</span><span>Estudio privado · Atención con cita previa</span><a href="#forma-de-trabajar">Descubre nuestra forma de trabajar ↓</a></div></section>
 <nav class="firm-index" aria-label="Recorrer La Firma"><span>LA FIRMA</span><a href="#equipo">01 El equipo</a><a href="#forma-de-trabajar">02 La experiencia</a><a href="#servicios-firma">03 Tu siguiente paso</a></nav>
 <section class="firm-team" id="equipo" aria-labelledby="firm-team-title"><header><div><span class="firm-label">QUIÉNES TE ACOMPAÑAN</span><h2 id="firm-team-title">Experiencia que<br/><em>se vuelve personal.</em></h2></div><p>Roger y Adriana comparten una mirada sobre la imagen. Sus trayectorias aportan perspectivas propias al cabello, el color y el vestuario.</p></header>
 <div class="firm-person-tabs" role="tablist" aria-label="Conocer a los asesores">{people.map((person,i)=><button disabled type="button" role="tab" id={`firm-tab-${person.id}`} aria-controls={person.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><img src={person.image} alt="" width="70" height="70"/><span><small>{person.number} / ASESORÍA PERSONAL</small><strong>{person.name}</strong></span><b aria-hidden="true">↗</b></button>)}</div>
 {people.map(person=><div class={`firm-person person-${person.id}`} role="tabpanel" id={person.id} aria-labelledby={`firm-tab-${person.id}`} tabindex="0"><figure><img src={person.image} alt={`${person.name}, asesoría de imagen en Bogotá`} width="700" height="900" loading="lazy"/><figcaption><strong>{person.years}<span>AÑOS DE<br/>TRAYECTORIA</span></strong><span>Cabello / Color / Imagen</span></figcaption></figure><div class="firm-person-copy"><span class="firm-label">{person.role}</span><h3>{person.specialty}</h3><p>{person.intro}</p><ul class="firm-expertise" aria-label="Áreas de trabajo">{person.areas.map(area=><li>{area}</li>)}</ul><div class="firm-bio">{person.bio.map((item,i)=><details name={`bio-${person.id}`} open={i===0}><summary><span>{item.title}</span><b aria-hidden="true">+</b></summary><p>{item.text}</p></details>)}</div><div class="firm-profile-links"><a href={person.link}>{person.action}<span aria-hidden="true">↗</span></a><a href="/libro/">Libro Revoluciona tu Imagen ↗</a></div></div></div>)}
 </section>
 <section id="forma-de-trabajar" class="firm-method" aria-labelledby="firm-method-title"><div class="firm-method-inner"><div class="firm-door-art" aria-hidden="true"><span class="door-grid"></span><span class="door-light"></span><span class="door-frame"><i></i></span><span class="door-floor"></span><span class="door-mark">RM.</span><span class="door-art-note">Representación conceptual del estudio privado</span></div><div class="firm-method-copy"><span class="firm-label">A PUERTA CERRADA</span><h2 id="firm-method-title">Un espacio privado.<br/><em>Tu contexto al centro.</em></h2><p>Una necesidad puntual o un proceso más amplio. La atención comienza por escuchar lo que buscas y acordar una forma de trabajar.</p><ol class="firm-method-steps"><li><span>01</span><div><h3>Escuchar.</h3><p>Qué quieres cambiar, qué prefieres conservar y en qué momentos necesitas tu imagen.</p></div></li><li><span>02</span><div><h3>Observar.</h3><p>Cabello, color, proporciones o vestuario, según el servicio que estás consultando.</p></div></li><li><span>03</span><div><h3>Definir contigo.</h3><p>Una propuesta con alcance, condiciones y disponibilidad antes de reservar.</p></div></li></ol></div></div><div class="firm-location"><div><span>EL ESTUDIO / BOGOTÁ</span><p>Calle 163 B No. 48-80, Local 208<br/>Edificio Britalia Comercial y Empresarial</p></div><div><span>ATENCIÓN CON CITA PREVIA</span><p>Consulta el lugar y la modalidad de tu servicio.<br/>El fondo de armario incluye visita a domicilio.</p></div><a href="/contacto/">Ubicación y contacto <span aria-hidden="true">↗</span></a></div></section>
 <section class="firm-next" id="servicios-firma" aria-labelledby="firm-next-title"><header><span class="firm-label">TU NECESIDAD MARCA EL INICIO</span><h2 id="firm-next-title">No todo cambio<br/>empieza <em>en el mismo lugar.</em></h2><p>Puedes consultar por tu cabello, tu paleta personal o un proceso de vestuario e imagen. No necesitas contratarlo todo.</p></header><div class="firm-paths"><a href="/servicios/peluqueria/" class="firm-path path-hair"><span>01 / CABELLO</span><svg viewBox="0 0 200 140" aria-hidden="true"><path d="M40 140Q-5 30 96 10Q190 0 159 140M70 140Q23 43 98 34Q160 25 134 140M93 140Q50 53 100 56Q133 51 112 140" fill="none" stroke="currentColor" stroke-width="10"/></svg><h3>Corte, color<br/>y visagismo.</h3><p>Para trabajar tu cabello y cómo lo llevas.</p><span class="firm-path-action">Explorar peluquería <b aria-hidden="true">↗</b></span></a><a href="/servicios/colorimetria-bogota/" class="firm-path path-color"><span>02 / COLOR PERSONAL</span><div class="firm-color-fan" aria-hidden="true">{['#8a3c52','#b27e66','#bbaa85','#718779','#345768'].map((color,i)=><i style={`--color:${color};--n:${i}`}/>)}</div><h3>Tu paleta.<br/>Tu forma de combinar.</h3><p>Informe digital o una sesión presencial.</p><span class="firm-path-action">Explorar colorimetría <b aria-hidden="true">↗</b></span></a><a href="/servicios/" class="firm-path path-image"><span>03 / VESTUARIO E IMAGEN</span><svg viewBox="0 0 200 140" aria-hidden="true"><path d="M85 24q0-17 15-17t15 15q0 8-15 17l-71 41h142L100 39M65 80l35 41 35-41M100 121v19" fill="none" stroke="currentColor" stroke-width="3"/><path d="m65 80-30 16-15 44h160l-15-44-30-16-35 41z" fill="currentColor" opacity=".15"/></svg><h3>Armario, compras<br/>y asesoría personal.</h3><p>Un servicio específico o un acompañamiento integral.</p><span class="firm-path-action">Comparar servicios <b aria-hidden="true">↗</b></span></a></div><div class="firm-close"><p>¿Prefieres contarnos<br/><em>qué tienes en mente?</em></p><a href="/contacto/">Conversemos <span aria-hidden="true">↗</span></a><a class="firm-close-secondary" href="/casos-de-exito/">Conocer historias reales ↗</a></div></section>
</div>
<script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.firm-person-tabs [role=tab]'));const panels=Array.from(document.querySelectorAll<HTMLElement>('.firm-person[role=tabpanel]'));
 if(tabs.length){const select=(n:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.disabled=false;tab.setAttribute('aria-selected',String(i===n));tab.tabIndex=i===n?0:-1;panels[i].hidden=i!==n;});if(focus)tabs[n].focus();};const syncHash=()=>{const n=panels.findIndex(p=>'#'+p.id===location.hash);if(n>=0)select(n);};select(0);syncHash();addEventListener('hashchange',syncHash);document.querySelectorAll<HTMLAnchorElement>('.firm-cover-portraits a').forEach(a=>a.addEventListener('click',()=>select(a.hash==='#adriana'?1:0)));tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();select(event.key==='Home'?0:event.key==='End'?1:(i+1)%2,true);}});});}
</script>
