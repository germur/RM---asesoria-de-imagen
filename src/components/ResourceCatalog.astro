---
interface Item { href:string; title:string; description:string; meta:string; category:string; image?:string; motif?:string }
interface Props { items:Item[]; label:string }
const {items,label}=Astro.props;
const categories=[...new Set(items.map(item=>item.category))];
const schema={'@context':'https://schema.org','@type':'ItemList',name:label,itemListElement:items.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.title,url:new URL(item.href,'https://rogermurillo.co').href}))};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<section class="resource-catalog" data-resource-catalog aria-label={label}>
 <div class="rc-wrap"><div class="rc-toolbar"><span class="rc-count" aria-live="polite">{items.length} recursos para explorar</span><div class="rc-filters" aria-label="Filtrar recursos" hidden><button type="button" aria-pressed="true" data-category="all">Todo</button>{categories.map(category=><button type="button" aria-pressed="false" data-category={category}>{category}</button>)}</div></div>
 <div class="rc-grid">{items.map((item,i)=><a class:list={['rc-resource',{'rc-featured':i===0}]} href={item.href} data-resource-category={item.category}>
   <div class:list={['rc-art',`rc-tone-${i%4}`]}>{item.image?<img src={item.image} alt="" width="800" height="600" loading="lazy"/>:<div class="rc-diagram" aria-hidden="true">{item.motif==='color'?<div class="rc-color-papers">{['#86544d','#be9e7b','#67765c','#a7a58b','#354b52'].map((c,j)=><span style={`--c:${c};--n:${j}`} />)}</div>:item.motif==='face'?<svg viewBox="0 0 240 240" fill="none"><ellipse cx="120" cy="115" rx="65" ry="86"/><path d="M35 115h170M120 15v210M55 60l130 110M55 170L185 60"/><circle cx="120" cy="115" r="103"/></svg>:item.motif==='body'?<svg viewBox="0 0 240 240" fill="none"><path d="M70 35h100l-26 85 40 90H56l40-90zM48 35h144M48 120h144M48 210h144M120 15v210"/></svg>:<div class="rc-letters">{item.motif==='voice'?'Aa':'RM.'}<span>Imagen / Criterio / Identidad</span></div>}</div>}<span class="rc-number">0{i+1}</span><span class="rc-art-label">{item.category}</span><span class="rc-open" aria-hidden="true">↗</span></div>
   <div class="rc-copy"><span class="rc-meta">{item.meta}</span><h2>{item.title}</h2><p>{item.description}</p><span class="rc-action">Explorar recurso <span aria-hidden="true">↗</span></span></div>
  </a>)}</div></div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-resource-catalog]').forEach(root=>{
  const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-resource-category]'));
  root.querySelector<HTMLElement>('.rc-filters')!.hidden=false;
  buttons.forEach(button=>button.addEventListener('click',()=>{
   const category=button.dataset.category;let count=0;
   buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
   cards.forEach(card=>{card.hidden=category!=='all'&&card.dataset.resourceCategory!==category;if(!card.hidden)count++;});
   root.querySelector('.rc-count')!.textContent=`${count} ${count===1?'recurso para explorar':'recursos para explorar'}`;
  }));
 });
</script>
<style>
 .resource-catalog{padding:42px 0 75px;background:#f3f3f3}.rc-wrap{max-width:1280px;padding:0 48px;margin:auto}.rc-toolbar{display:flex;align-items:center;justify-content:space-between;gap:25px;border-bottom:1px solid #d2d2d2;padding-bottom:25px;margin-bottom:30px}.rc-count{font-size:10px;letter-spacing:.08em;color:#727272}.rc-filters{display:flex;gap:7px;flex-wrap:wrap}.rc-filters[hidden],.rc-resource[hidden]{display:none}.rc-filters button{font-size:11px;padding:11px 18px;border:1px solid #d0d0d0;border-radius:30px;min-height:42px;color:#616161;cursor:pointer;transition:background .2s,color .2s}.rc-filters button[aria-pressed=true],.rc-filters button:hover{background:#3c3c3c;color:#fff;border-color:#3c3c3c}.rc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px 26px}.rc-resource{display:flex;flex-direction:column;border-bottom:1px solid #c9c9c9;padding-bottom:22px;min-width:0}.rc-art{height:230px;background:#d9d9d9;position:relative;overflow:hidden}.rc-art img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.rc-resource:hover .rc-art img{transform:scale(1.045)}.rc-number{position:absolute;top:17px;left:18px;font:12px Georgia,serif;color:#5a5a5a;background:#f5f5f5db;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%}.rc-art-label{position:absolute;left:18px;bottom:17px;background:#f0f0f0ed;color:#4d4d4d;padding:6px 10px;font-size:8px;letter-spacing:.14em;text-transform:uppercase}.rc-open{position:absolute;right:15px;bottom:15px;width:34px;height:34px;border-radius:50%;background:#f2f2f2e8;color:#454545;display:flex;align-items:center;justify-content:center;font-size:20px;transition:transform .2s}.rc-resource:hover .rc-open{transform:rotate(15deg)}.rc-copy{padding-top:22px;flex:1;display:flex;flex-direction:column}.rc-meta{font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:#727272;display:block;margin-bottom:12px}.rc-copy h2{font:28px/1.15 'Playfair Display',Georgia,serif;letter-spacing:-.025em;color:#313131;margin-bottom:13px}.rc-copy p{font-size:13px;line-height:1.85;color:#6e6e6e;margin-bottom:22px}.rc-action{font-size:11px;color:#3e3e3e;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:auto}.rc-action>span{font-size:20px}.rc-tone-1{background:#d4d4d4}.rc-tone-2{background:#e0e0e0}.rc-tone-3{background:#cdcdcd}.rc-diagram{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}.rc-diagram svg{width:210px;height:210px;stroke:#676767;stroke-width:1;opacity:.8}.rc-color-papers{position:relative;width:170px;height:170px}.rc-color-papers>span{position:absolute;inset:15px 35px 5px;width:85px;background:var(--c);transform-origin:bottom center;transform:rotate(calc(-45deg + var(--n)*23deg));border-radius:40px 40px 3px 3px;box-shadow:4px 8px 12px #0002}.rc-letters{font:italic 80px 'Playfair Display',Georgia,serif;color:#6e6e6e;letter-spacing:-.06em;display:flex;flex-direction:column;align-items:center}.rc-letters span{font:8px Arial,sans-serif;letter-spacing:.14em;margin-top:5px;text-transform:uppercase}.rc-resource:focus-visible,.rc-filters button:focus-visible{outline:3px solid #b3423c;outline-offset:5px}@media(min-width:950px){.rc-featured{grid-column:span 2;display:grid;grid-template-columns:1.1fr .9fr;gap:28px;background:#e2e2e2;padding:0 25px 0 0;border:0}.rc-featured .rc-art{height:100%;min-height:340px}.rc-featured .rc-copy{padding:30px 0}.rc-featured h2{font-size:34px}.rc-featured .rc-diagram{transform:scale(1.25)}}@media(max-width:949px){.rc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rc-wrap{padding:0 24px}.rc-toolbar{align-items:start;flex-direction:column}.rc-art{height:230px}}@media(max-width:600px){.resource-catalog{padding:28px 0 50px}.rc-grid{grid-template-columns:1fr;gap:30px}.rc-art{height:260px}.rc-filters button{padding:10px 14px}.rc-copy h2{font-size:29px}}
 @media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
