---
import seasons from '@/data/color_seasons.json';
const families=['invierno','verano','otono','primavera'];
const names:Record<string,string>={invierno:'Invierno',verano:'Verano',otono:'Otoño',primavera:'Primavera'};
---
<section class="season-atlas" data-season-atlas aria-label="Explora las doce estaciones de colorimetría"><div class="sa-toolbar"><p>Referencias digitales / 12 paletas</p><div class="sa-filters" hidden><button type="button" aria-pressed="true" data-season-filter="all">Todas</button>{families.map(f=><button type="button" aria-pressed="false" data-season-filter={f}>{names[f]}</button>)}</div></div><div class="sa-grid">{seasons.map((season,i)=><a href={`/herramientas/colorimetria/${season.slug}/`} class="sa-palette" data-season-family={season.id.startsWith('oto')?'otono':season.id.split('-')[0]}><span class="sa-number">0{i+1}</span><div class="sa-colors" aria-hidden="true">{season.palette.best_colors.map(c=><i style={`background:${c}`} />)}</div><div class="sa-name"><h2>{season.name.split(' (')[0]}</h2><span aria-hidden="true">↗</span></div><p>Explora colores, neutros y combinaciones</p></a>)}</div><p class="sa-note">Las muestras cambian según la pantalla y la iluminación. Estas familias de color son una guía de exploración, no un diagnóstico personal.</p></section>
<script>
 const atlas=document.querySelector('[data-season-atlas]');
 if(atlas){atlas.querySelector<HTMLElement>('.sa-filters')!.hidden=false;const buttons=Array.from(atlas.querySelectorAll<HTMLButtonElement>('[data-season-filter]'));buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));atlas.querySelectorAll<HTMLElement>('[data-season-family]').forEach(card=>card.hidden=button.dataset.seasonFilter!=='all'&&card.dataset.seasonFamily!==button.dataset.seasonFilter);}));}
</script>
<style>
 .season-atlas{max-width:1280px;padding:40px 48px 70px;margin:auto}.sa-toolbar{display:flex;align-items:center;justify-content:space-between;gap:25px;padding-bottom:25px;border-bottom:1px solid #d5d8c7;margin-bottom:30px}.sa-toolbar>p{font-size:10px;letter-spacing:.1em;color:#7c7d68}.sa-filters{display:flex;gap:7px;flex-wrap:wrap}.sa-filters[hidden],.sa-palette[hidden]{display:none}.sa-filters button{font-size:11px;border:1px solid #d3d9c5;border-radius:30px;padding:12px 18px;color:#65734f;min-height:44px}.sa-filters button[aria-pressed=true]{background:#34472d;color:#fff;border-color:#34472d}.sa-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px 28px}.sa-palette{padding-top:20px;border-top:1px solid #d7d8c9}.sa-number{display:block;font:11px Georgia,serif;color:#858976;margin-bottom:18px}.sa-colors{height:155px;display:flex;align-items:end;background:#eae7dd;padding:20px 18px 0;gap:7px;overflow:hidden}.sa-colors i{display:block;flex:1;height:100%;border-radius:50px 50px 0 0;box-shadow:2px 0 5px #0001;transition:transform .3s}.sa-colors i:nth-child(2n){height:83%}.sa-palette:hover i{transform:translateY(10px)}.sa-palette:hover i:nth-child(2n){transform:translateY(-5px)}.sa-name{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:20px 0 10px}.sa-name h2{font:27px 'Playfair Display',Georgia,serif;color:#35422b}.sa-name>span{font-size:22px;color:#677951}.sa-palette>p{font-size:11px;color:#85866f}.sa-note{font-size:12px;color:#7a7c68;line-height:1.8;border-top:1px solid #d6d8c7;padding-top:25px;margin-top:40px;max-width:700px}@media(max-width:900px){.season-atlas{padding:30px 24px 50px}.sa-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sa-toolbar{align-items:start;flex-direction:column}}@media(max-width:500px){.sa-grid{grid-template-columns:1fr;gap:25px}.sa-colors{height:170px}.sa-filters button{padding:11px 14px}}
</style>
