---
import "@fontsource/playfair-display";
import "@fontsource/inter";
import "../../styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    schema?: string | object;
    noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/images/roger-adriana-duo.webp", schema, noindex = false } = Astro.props;

// ─── Entidad global: Organization + WebSite ───
// Es la "entidad ancla" que Google y los LLMs usan para identificar la marca.
// Se emite en TODAS las paginas. Otros schemas pueden referenciarla via @id.
const ORG_ID = "https://rogermurillo.co/#organization";
const globalSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": ["ProfessionalService", "Organization"],
            "@id": ORG_ID,
            name: "Roger Murillo Asesoría de Imagen",
            alternateName: "Roger Murillo Image Advisors",
            url: "https://rogermurillo.co",
            logo: {
                "@type": "ImageObject",
                url: "https://rogermurillo.co/images/logo_rm.png",
            },
            image: "https://rogermurillo.co/images/roger-adriana-duo.webp",
            description:
                "Consultoría de imagen personal y ejecutiva a puerta cerrada en Bogotá. Especialistas en visagismo, colorimetría y estilo estratégico.",
            telephone: "+573214189010",
            email: "contacto@rogermurillo.co",
            priceRange: "$$$",
            address: {
                "@type": "PostalAddress",
                streetAddress: "Calle 163 B No. 48-80, Local 208, Edificio Britalia Comercial y Empresarial",
                addressLocality: "Bogotá",
                addressRegion: "Cundinamarca",
                addressCountry: "CO",
            },
            areaServed: [
                { "@type": "City", name: "Bogotá" },
                { "@type": "Country", name: "Colombia" },
            ],
            knowsAbout: [
                "Asesoría de imagen",
                "Visagismo",
                "Colorimetría",
                "Imagen ejecutiva",
                "Estilo personal",
                "Peluquería de autor",
            ],
            founder: [
                { "@type": "Person", name: "Roger Murillo", "@id": "https://rogermurillo.co/nosotros/#roger" },
                { "@type": "Person", name: "Adriana Garzón", "@id": "https://rogermurillo.co/nosotros/#adriana" },
            ],
            openingHoursSpecification: {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
                opens: "09:00",
                closes: "19:00",
            },
            sameAs: ["https://www.instagram.com/rogermurilloai/"],
        },
        {
            "@type": "WebSite",
            "@id": "https://rogermurillo.co/#website",
            url: "https://rogermurillo.co",
            name: "Roger Murillo Asesoría de Imagen",
            inLanguage: "es",
            publisher: { "@id": ORG_ID },
        },
    ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Google Search Console verification -->
<meta name="google-site-verification" content="jDC900a9GT3nol6gclgHA78XBd6ABy12mXHA0DUVtbw" />

{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Google Tag Manager: GA4, eventos y Clarity se administran en el contenedor. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  var productionTracking = ['rogermurillo.co', 'www.rogermurillo.co'].includes(location.hostname);
  var trackingAccepted = false;
  var trackingLoaded = false;
  try { trackingAccepted = localStorage.getItem('cookiesAccepted') === 'true'; } catch (error) {}
  // Compatibilidad con los formularios y herramientas existentes; el envío lo hace GTM.
  function gtag(command, name, parameters) {
    if (command === 'event') {
      if (productionTracking && !trackingAccepted) return;
      window.dataLayer.push({ rm_event: null });
      window.dataLayer.push({ event: name, rm_event: parameters || {} });
    } else {
      window.dataLayer.push(arguments);
    }
  }
  gtag('consent', 'default', {
    analytics_storage: 'denied', ad_storage: 'denied',
    ad_user_data: 'denied', ad_personalization: 'denied'
  });
  // Clarity recibe la misma decisión antes de cargar su etiqueta oficial.
  window.clarity = window.clarity || function () {
    (window.clarity.q = window.clarity.q || []).push(arguments);
  };
  function enableTracking() {
    trackingAccepted = true;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    window.clarity('consentv2', { analytics_Storage: 'granted', ad_Storage: 'denied' });
    if (!productionTracking || trackingLoaded) return;
    trackingLoaded = true;
    window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var containerScript = document.createElement('script');
    containerScript.async = true;
    containerScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5RH99FDW';
    document.head.appendChild(containerScript);
  }
  window.addEventListener('rm:analytics-consent', enableTracking);
  if (trackingAccepted) enableTracking();
  try {
    if (!sessionStorage.getItem('rm_entry_context')) {
      var referrerHost = document.referrer ? new URL(document.referrer).hostname : '';
      sessionStorage.setItem('rm_entry_context', JSON.stringify({ entry: location.pathname, referrer: referrerHost }));
    }
  } catch (error) { /* La navegación y los formularios no dependen del almacenamiento. */ }

  // ─── Eventos clave (conversiones) ───
  // Delegacion global: cubre todos los CTAs del sitio sin tocarlos uno a uno.
  // El envío aceptado es el contacto; los clics son señales previas.
  // Configuración manual de GA4: docs/medicion-y-verificacion.md.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a');
    if (!a) return;
    var href = a.getAttribute('href') || '';
    var ubicacion = a.dataset.ctaLocation || (location.pathname || '/');
    var tool = a.dataset.toolFunnel;
    if (['colorimetria', 'rostro', 'cuerpo', 'impacto', 'reto'].includes(tool)) {
      gtag('event', 'herramienta_servicio_click', { herramienta: tool, servicio: a.dataset.toolService, pagina: location.pathname });
    }

    if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
      gtag('event', 'contacto_whatsapp', { pagina: ubicacion, destino: href });
    } else if (href.indexOf('tel:') === 0) {
      gtag('event', 'contacto_telefono', { pagina: ubicacion });
    } else if (href.indexOf('mailto:') === 0) {
      gtag('event', 'contacto_email', { pagina: ubicacion });
    } else if (/^\/contacto\/?($|[#?])/.test(href)) {
      var interest = new URL(href, location.origin).searchParams.get('interes');
      var allowedInterests = ['peluqueria', 'integral', 'ejecutiva', 'colorimetria', 'colorimetria-digital', 'colorimetria-presencial', 'fondo-armario', 'visagismo', 'automaquillaje', 'curso-colorimetria-profesional'];
      gtag('event', 'click_agendar', { pagina: ubicacion, interes: allowedInterests.includes(interest) ? interest : 'general' });
    } else if (href.indexOf('pay.hotmart.com') !== -1 || href.indexOf('hotmart.com') !== -1) {
      gtag('event', 'click_comprar_curso', { pagina: ubicacion, destino: href });
    }
  }, { passive: true });
</script>

<!-- Font preloads (optional with @fontsource, but good for CLS) -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Entidad global (Organization + WebSite) en todas las paginas -->
<script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />

<!-- Schema especifico de la pagina. Acepta string (JSON) u objeto. -->
{schema && (
    <script type="application/ld+json" set:html={typeof schema === "string" ? schema : JSON.stringify(schema)} />
)}
