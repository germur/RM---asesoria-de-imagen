---
import ServiceDiscovery from './ServiceDiscovery.astro';
interface Props { current?: string }
const { current } = Astro.props;
const routes = [
    { id: 'colorimetria', title: 'Colorimetría personal', description: 'Informe digital por $150.000 COP o sesión presencial de 2,5 a 3 horas por $1.000.000 COP, con informe incluido.', href: '/servicios/colorimetria-bogota/' },
    { id: 'hombres', title: 'Asesoría para hombres', description: 'Fondo de armario y personal shopper por $1.600.000 COP. Revisión a domicilio y ruta de compras preparada.', href: '/servicios/asesoria-imagen-hombres-bogota/' },
    { id: 'peluqueria', title: 'Cabello, corte y visagismo', description: 'Quieres revisar tu corte, color o peinado según tu rostro y tu rutina.', href: '/servicios/peluqueria/' },
    { id: 'integral', title: 'Asesoría de imagen integral', description: 'Buscas acompañamiento en color, vestuario, armario y compras, además del cabello.', href: '/servicios/asesoria-integral-imagen/' },
    { id: 'ejecutiva', title: 'Imagen ejecutiva', description: 'Necesitas adaptar tu presencia y vestuario a reuniones, escenarios profesionales o un nuevo cargo.', href: '/servicios/imagen-ejecutiva-autoridad/' },
];
---
<ServiceDiscovery routes={routes.filter(route => route.id !== current)} current={current} />
