---
import CasePhoto from "./CasePhoto.astro";
interface Props { before:string; after:string; name:string }
const {before,after,name}=Astro.props;
---
<div class="image-comparison" data-image-comparison>
 <div class="ic-stage"><CasePhoto src={after} alt={`${name}, después del proceso de asesoría integral`} width="1000" height="1250" loading="lazy"/><CasePhoto class="ic-before" src={before} alt={`${name}, antes del proceso de asesoría integral`} width="1000" height="1250" loading="lazy"/><span class="ic-label ic-label-before">Antes</span><span class="ic-label ic-label-after">Después</span><span class="ic-line" aria-hidden="true"><i>↔</i></span></div>
 <div class="ic-controls"><button type="button" data-show-before disabled>Ver antes</button><label><span>Comparar el proceso de {name}</span><input type="range" min="0" max="100" value="50" aria-label={`Proporción visible del antes de ${name}`} aria-valuetext="Antes visible al 50 por ciento" disabled/></label><button type="button" data-show-after disabled>Ver después</button></div>
 <p class="ic-note">Desliza el control o usa las flechas del teclado. Las fotografías pertenecen a un proceso integral individual.</p>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-image-comparison]').forEach(root=>{
  const range=root.querySelector<HTMLInputElement>('input')!;const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('button'));
  range.disabled=false;buttons.forEach(button=>button.disabled=false);
  const update=(value:string)=>{range.value=value;root.style.setProperty('--comparison',`${value}%`);range.setAttribute('aria-valuetext',`Antes visible al ${value} por ciento`);root.querySelector<HTMLElement>('.ic-label-before')!.hidden=Number(value)===0;root.querySelector<HTMLElement>('.ic-label-after')!.hidden=Number(value)===100;};
  range.addEventListener('input',()=>update(range.value));root.querySelector('[data-show-before]')?.addEventListener('click',()=>update('100'));root.querySelector('[data-show-after]')?.addEventListener('click',()=>update('0'));
 });
</script>
<style>
 .image-comparison{--comparison:50%}.ic-stage{position:relative;aspect-ratio:4/3;overflow:hidden;background:#d6dbca}.ic-stage :is(img,svg){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;pointer-events:none}.ic-stage .ic-before{clip-path:inset(0 calc(100% - var(--comparison)) 0 0)}.ic-line{position:absolute;left:var(--comparison);top:0;bottom:0;width:1px;background:#fff9;pointer-events:none}.ic-line i{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:#f8f5eb;color:#3c4f2c;display:flex;align-items:center;justify-content:center;font:22px Arial,sans-serif;box-shadow:0 2px 15px #0003}.ic-label{position:absolute;top:20px;padding:8px 13px;background:#f8f5e9e8;backdrop-filter:blur(10px);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#3a4e2a}.ic-label-before{left:20px}.ic-label-after{right:20px}.ic-controls{display:flex;align-items:center;gap:24px;background:#f2f0e5;border:1px solid #d6dcc8;padding:20px 25px}.ic-controls button{font-size:11px;color:#4d6539;white-space:nowrap;min-height:44px}.ic-controls label{flex:1}.ic-controls label>span{font-size:9px;letter-spacing:.06em;color:#606c4d;display:block;margin-bottom:10px}.ic-controls input{width:100%;accent-color:#506a3a;cursor:ew-resize;height:44px}.ic-note{font-size:10px!important;line-height:1.8!important;color:#606c4d!important;text-align:center;margin-top:15px}.ic-controls button:focus-visible,.ic-controls input:focus-visible{outline:3px solid #b36446;outline-offset:4px}@media(max-width:600px){.ic-stage{aspect-ratio:3/4}.ic-controls{gap:15px;padding:15px}.ic-controls button{font-size:10px}.ic-controls label>span{font-size:8px}.ic-label{top:12px;font-size:8px}.ic-label-before{left:12px}.ic-label-after{right:12px}}
</style>
