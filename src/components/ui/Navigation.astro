---
import { primaryNavigation, navigationPanels } from '@/data/navigation';
const { theme='dark' }=Astro.props;
const pathname=Astro.url.pathname;
const active=(href:string)=>pathname===href||(href!=='/'&&pathname.startsWith(href));
---
<header id="main-header" class:list={['rm-navigation',{'scrolled':theme==='light'}]} data-theme={theme}>
 <div class="rn-utility"><div><span class="rn-location"><i aria-hidden="true"></i>Estudio privado · Bogotá</span><span class="rn-utility-end"><a href="/blog/">Journal</a><a href="/contacto/#form">Conversemos</a><span>Atención con cita previa</span></span></div></div>
 <div class="rn-bar">
  <a class="rn-brand" href="/" aria-label="Roger Murillo · Inicio"><img src="/images/logo_rm.png" alt="Roger Murillo Asesoría de Imagen" width="210" height="46" /></a>
  <nav class="rn-desktop" id="nav-desktop" aria-label="Navegación principal">{primaryNavigation.map((item,i)=><div class:list={['rn-item',{'rn-current':active(item.href)}]} data-mega={item.key}>
   <a class="nav-link" data-nav-key={item.key} href={item.href} aria-current={pathname===item.href?'page':active(item.href)?'location':undefined}><span class="rn-nav-number" aria-hidden="true">0{i+1}</span>{item.label}</a>
   {item.key&&<button type="button" class="rn-disclosure" id={`nav-trigger-${item.key}`} data-menu-trigger={item.key} aria-label={`Explorar ${item.label}`} aria-expanded="false" aria-controls={`nav-panel-${item.key}`}><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></button>}
  </div>)}</nav>
  <div class="rn-actions"><a class="rn-consult" href="/contacto/"><span>Consultar mi caso</span><span aria-hidden="true">↗</span></a><button type="button" id="mobile-menu-btn" class="rn-mobile-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"><span aria-hidden="true"><i></i><i></i></span><span>Menú</span></button></div>
 </div>
 {navigationPanels.map(panel=><div class="rn-panel mega-menu" id={`nav-panel-${panel.key}`} data-mega-panel={panel.key} hidden aria-labelledby={`nav-trigger-${panel.key}`}>
  <div class="rn-panel-inner">
   <div class="rn-feature"><span class="rn-eyebrow">{panel.eyebrow}</span><h2>{panel.title}</h2><p>{panel.description}</p><a href={panel.href}>{panel.action}<span aria-hidden="true">↗</span></a><div class="rn-feature-art">{panel.image?<img src={panel.image} alt={panel.imageAlt} width="600" height="400" loading="lazy"/>:<div class="rn-lab-art" aria-hidden="true">{['#81594f','#b8a582','#8a977b','#405e60','#c6c9b2'].map((color,i)=><i style={`--color:${color};--i:${i}`} />)}<span>Explorar / Observar / Elegir</span></div>}</div></div>
   <nav class="rn-panel-links" aria-label={panel.label}>{panel.links.map((link,i)=><a href={link.href} class:list={[{'is-destination':pathname===link.href}]} aria-current={pathname===link.href?'page':undefined}><span class="rn-link-number">0{i+1}</span><span><strong>{link.title}</strong><small>{link.description}</small></span><span class="rn-link-detail">{link.detail}<b aria-hidden="true">↗</b></span></a>)}</nav>
   <div class="rn-extras"><span class="rn-eyebrow">{panel.extraLabel}</span>{panel.extras.map(link=><a href={link.href}>{link.title}<span aria-hidden="true">↗</span></a>)}<div class="rn-help"><span>¿No sabes cuál elegir?</span><a href="/contacto/">Te orientamos <span aria-hidden="true">↗</span></a></div></div>
  </div><div class="rn-panel-bottom"><span>Roger Murillo & Adriana Garzón</span><button type="button" data-close-navigation>Cerrar explorador <span aria-hidden="true">×</span></button></div>
 </div>)}
</header>
<div class="rn-shade" data-close-navigation hidden aria-hidden="true"></div>
<div id="mobile-menu" class="rn-mobile" role="dialog" aria-modal="true" aria-label="Navegación del sitio" hidden inert>
 <div class="rn-mobile-head"><a href="/" aria-label="Roger Murillo · Inicio"><img src="/images/logo_rm.png" alt="Roger Murillo" width="170" height="38"/></a><button type="button" id="close-menu-btn" aria-label="Cerrar menú">Cerrar <span aria-hidden="true">×</span></button></div>
 <div class="rn-mobile-scroll"><span class="rn-eyebrow">Tu imagen / Tu siguiente paso</span><nav aria-label="Navegación móvil">
  {primaryNavigation.map((item,i)=>item.key?<details class:list={["rn-mobile-group",{"rn-mobile-current":active(item.href)}]} name="mobile-navigation"><summary><span>0{i+1}</span>{item.label}<b aria-hidden="true">+</b></summary><div><a class="rn-mobile-hub" href={item.href}>Ver {item.label.toLowerCase()} <span aria-hidden="true">↗</span></a>{navigationPanels.find(panel=>panel.key===item.key)!.links.map(link=><a href={link.href}><strong>{link.title}</strong><small>{link.detail}</small></a>)}{navigationPanels.find(panel=>panel.key===item.key)!.extras.map(link=><a href={link.href}>{link.title}</a>)}</div></details>:<a class="rn-mobile-direct" href={item.href} aria-current={pathname===item.href?'page':active(item.href)?'location':undefined}><span>0{i+1}</span>{item.label}<b aria-hidden="true">↗</b></a>)}
 </nav><div class="rn-mobile-utility"><a href="/blog/">Journal ↗</a><a href="/productos/">Productos del estudio ↗</a><a href="/contacto/">Ubicación y contacto ↗</a></div></div>
 <div class="rn-mobile-foot"><span>Bogotá · Atención con cita previa</span><a href="/contacto/">Consultar mi caso <span aria-hidden="true">↗</span></a></div>
</div>
<script>
 const header=document.getElementById('main-header')!;
 const panels=Array.from(header.querySelectorAll<HTMLElement>('[data-mega-panel]'));
 const triggers=Array.from(header.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]'));
 const shade=document.querySelector<HTMLElement>('.rn-shade')!;
 const menu=document.getElementById('mobile-menu')!;
 const mobileTrigger=document.getElementById('mobile-menu-btn')!;
 const mobileClose=document.getElementById('close-menu-btn')!;
 let openKey:string|null=null;let timer:ReturnType<typeof setTimeout>;let savedOverflow='';
 const closePanels=(returnFocus=false)=>{
  clearTimeout(timer);const oldKey=openKey;openKey=null;panels.forEach(panel=>{panel.hidden=true;panel.classList.remove('is-open');});triggers.forEach(trigger=>trigger.setAttribute('aria-expanded','false'));header.classList.remove('is-expanded');shade.hidden=true;
  if(returnFocus&&oldKey)triggers.find(trigger=>trigger.dataset.menuTrigger===oldKey)?.focus();
 };
 const openPanel=(key:string,focus=false)=>{
  if(!matchMedia('(min-width:1120px)').matches)return;clearTimeout(timer);openKey=key;
  panels.forEach(panel=>{const active=panel.dataset.megaPanel===key;panel.hidden=!active;panel.classList.toggle('is-open',active);});triggers.forEach(trigger=>trigger.setAttribute('aria-expanded',String(trigger.dataset.menuTrigger===key)));header.classList.add('is-expanded');shade.hidden=false;
  if(focus)panels.find(panel=>panel.dataset.megaPanel===key)?.querySelector<HTMLElement>('a')?.focus();
 };
 triggers.forEach(trigger=>trigger.addEventListener('click',()=>openKey===trigger.dataset.menuTrigger?closePanels():openPanel(trigger.dataset.menuTrigger!)));
 header.querySelectorAll<HTMLElement>('[data-mega]').forEach(item=>{
  const key=item.dataset.mega!;item.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse'){clearTimeout(timer);timer=setTimeout(()=>openPanel(key),140);}});
  item.addEventListener('pointerleave',()=>{clearTimeout(timer);timer=setTimeout(()=>{if(!panels.some(panel=>panel.contains(document.activeElement)))closePanels();},240);});
  item.addEventListener('keydown',event=>{if(event.key==='ArrowDown'){event.preventDefault();openPanel(key,true);}});
 });
 panels.forEach(panel=>{panel.addEventListener('pointerenter',()=>clearTimeout(timer));panel.addEventListener('pointerleave',()=>{timer=setTimeout(()=>{if(!panel.contains(document.activeElement))closePanels();},240);});});
 header.addEventListener('focusout',()=>requestAnimationFrame(()=>{if(!header.contains(document.activeElement))closePanels();}));
 document.querySelectorAll('[data-close-navigation]').forEach(el=>el.addEventListener('click',()=>closePanels(true)));
 document.addEventListener('pointerdown',event=>{if(openKey&&!header.contains(event.target as Node))closePanels();});
 const closeMobile=(focus=true)=>{if(menu.hidden)return;menu.hidden=true;menu.setAttribute('inert','');mobileTrigger.setAttribute('aria-expanded','false');document.body.style.overflow=savedOverflow;if(focus)mobileTrigger.focus();};
 mobileTrigger.addEventListener('click',()=>{closePanels();savedOverflow=document.body.style.overflow;menu.hidden=false;menu.removeAttribute('inert');mobileTrigger.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';mobileClose.focus();});
 mobileClose.addEventListener('click',()=>closeMobile());menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>closeMobile(false)));
 menu.addEventListener('keydown',event=>{
  if(event.key==='Tab'){const elements=Array.from(menu.querySelectorAll<HTMLElement>('a,button,summary')).filter(el=>el.getClientRects().length);const first=elements[0],last=elements.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}}
 });
 document.addEventListener('keydown',event=>{if(event.key==='Escape'){if(!menu.hidden)closeMobile();else closePanels(true);}});
 const breakpoint=matchMedia('(min-width:1120px)');breakpoint.addEventListener('change',()=>{closePanels();if(breakpoint.matches)closeMobile(false);});
 const onScroll=()=>header.classList.toggle('scrolled',header.dataset.theme==='light'||scrollY>32);addEventListener('scroll',onScroll,{passive:true});onScroll();
</script>
<style>
 .rm-navigation{position:fixed;left:0;right:0;top:0;z-index:60;color:#f2f2f2;background:linear-gradient(#1117,#1110);transition:background .25s,color .25s;border-bottom:1px solid transparent}
 .rn-utility{height:32px;border-bottom:1px solid #ffffff1c}.rn-utility>div{max-width:1344px;padding:0 32px;margin:auto;height:100%;display:flex;align-items:center;justify-content:space-between;gap:25px;font-size:9px;letter-spacing:.1em;color:#fff9}.rn-location{display:flex;align-items:center;gap:9px}.rn-location i{height:5px;width:5px;border-radius:50%;background:#858585}.rn-utility-end{display:flex;gap:24px;align-items:center}.rn-utility-end>span{border-left:1px solid #ffffff26;padding-left:24px}.rn-utility a{transition:color .2s}.rn-utility a:hover{color:#fff}
 .rn-bar{max-width:1344px;padding:0 32px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:22px;height:73px}.rn-brand{flex-shrink:0;display:flex;align-items:center}.rn-brand img{width:175px;height:auto;max-height:40px;object-fit:contain;filter:brightness(0) invert(1)}
 .rn-desktop{display:flex;align-items:center;padding:5px;background:#ffffff12;border:1px solid #ffffff14;border-radius:40px;gap:3px}.rn-item{display:flex;align-items:center;border-radius:30px;position:relative;transition:background .2s}.rn-item>a{min-height:44px;display:flex;align-items:center;gap:8px;padding:12px 8px 12px 13px;font-size:12px;white-space:nowrap}.rn-item:not([data-mega])>a{padding-right:15px}.rn-nav-number{font-size:8px;opacity:.5;font-family:Arial,sans-serif}.rn-disclosure{padding:12px 10px 12px 0;min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center;border-radius:0 24px 24px 0;cursor:pointer}.rn-disclosure svg{transition:transform .2s}.rn-disclosure[aria-expanded=true] svg{transform:rotate(180deg)}.rn-current{background:#ffffff1c}.rn-current:after{content:'';position:absolute;left:25%;right:25%;bottom:4px;height:2px;background:#838383;border-radius:3px}.rn-item:hover{background:#ffffff16}
 .rn-actions{display:flex;align-items:center;gap:12px;flex-shrink:0}.rn-consult{display:flex;align-items:center;justify-content:space-between;gap:22px;border:1px solid #ffffff5c;border-radius:30px;padding:12px 18px;min-height:44px;font-size:10px;transition:background .2s,color .2s}.rn-consult>span:last-child{font-size:18px;line-height:1}.rn-consult:hover{background:#eeeeee;color:#2f2f2f}.rn-mobile-toggle{display:none;align-items:center;gap:9px;min-height:44px;min-width:44px;cursor:pointer;font-size:10px}.rn-mobile-toggle>span:first-child{display:grid;gap:5px;width:20px}.rn-mobile-toggle i{display:block;height:1px;background:currentColor;width:20px}
 .rm-navigation.scrolled,.rm-navigation.is-expanded{background:#f5f5f5f5;backdrop-filter:blur(20px);color:#363636;border-bottom-color:#d6d6d6;box-shadow:0 4px 24px #17171705}.scrolled .rn-utility,.is-expanded .rn-utility{border-bottom-color:#d6d6d6}.scrolled .rn-utility>div,.is-expanded .rn-utility>div{color:#5c5c5c}.scrolled .rn-utility a:hover,.is-expanded .rn-utility a:hover{color:#3a3a3a}.scrolled .rn-utility-end>span,.is-expanded .rn-utility-end>span{border-color:#cecece}.scrolled .rn-brand img,.is-expanded .rn-brand img{filter:brightness(0)}.scrolled .rn-desktop,.is-expanded .rn-desktop{background:#eaeaea;border-color:#e0e0e0}.scrolled .rn-current,.is-expanded .rn-current{background:#fbfbfb;box-shadow:0 2px 6px #20202010}.scrolled .rn-item:hover,.is-expanded .rn-item:hover{background:#dedede}.scrolled .rn-consult,.is-expanded .rn-consult{background:#3a3a3a;color:#f8f8f8;border-color:#3a3a3a}.scrolled .rn-consult:hover,.is-expanded .rn-consult:hover{background:#585858}
 .rn-panel[hidden],.rn-mobile[hidden],.rn-shade[hidden]{display:none}.rn-panel{position:absolute;left:24px;right:24px;top:calc(100% + 12px);max-width:1296px;margin:auto;background:#f2f2f2;color:#3a3a3a;border:1px solid #d3d3d3;box-shadow:0 25px 70px #18181826;border-radius:7px;max-height:calc(100dvh - 140px);overflow-y:auto;overscroll-behavior:contain;animation:nav-enter .2s ease-out}.rn-panel-inner{display:grid;grid-template-columns:.86fr 1.65fr .7fr;gap:35px;padding:32px 32px 25px}.rn-eyebrow{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#5c5c5c;display:block;line-height:1.7;margin-bottom:17px}.rn-feature h2{font:30px/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.025em;max-width:270px;color:#393939;margin-bottom:14px}.rn-feature>p{font-size:12px;line-height:1.9;color:#5c5c5c;margin-bottom:18px;max-width:280px}.rn-feature>a{display:flex;align-items:center;justify-content:space-between;font-size:10px;padding-bottom:12px;border-bottom:1px solid #c4c4c4;color:#464646}.rn-feature>a>span{font-size:19px}.rn-feature-art{position:relative;height:145px;margin-top:20px;overflow:hidden;background:#d8d8d8}.rn-feature-art>img{width:100%;height:100%;object-fit:cover;object-position:center 32%;filter:grayscale(.5)}
 .rn-panel-links>a{display:flex;align-items:center;gap:15px;border-bottom:1px solid #d8d8d8;padding:17px 10px 17px 0;min-height:78px;transition:background .2s,padding .2s}.rn-panel-links>a:first-child{padding-top:8px}.rn-panel-links>a:hover,.rn-panel-links>a.is-destination{background:#e6e6e6;padding-left:10px}.rn-link-number{font:9px Georgia,serif;color:#5c5c5c;align-self:start;padding-top:5px}.rn-panel-links strong{display:block;font:20px/1.15 'Playfair Display',Georgia,serif;letter-spacing:-.02em;color:#3a3a3a;margin-bottom:6px}.rn-panel-links small{display:block;font-size:11px;line-height:1.6;color:#5c5c5c}.rn-link-detail{margin-left:auto;display:flex;align-items:center;gap:13px;text-align:right;font-size:9px;line-height:1.6;color:#5c5c5c;max-width:120px;flex-shrink:0}.rn-link-detail b{font-size:20px;font-weight:300;color:#5c5c5c}.rn-extras{border-left:1px solid #d8d8d8;padding-left:26px}.rn-extras>a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;font-size:11px;line-height:1.5;color:#5c5c5c;border-bottom:1px solid #dcdcdc}.rn-extras>a>span{font-size:17px}.rn-help{margin-top:32px;background:#e4e4e4;padding:17px 15px}.rn-help>span{font-size:10px;color:#5c5c5c}.rn-help>a{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#444444;padding-top:10px}.rn-panel-bottom{display:flex;align-items:center;justify-content:space-between;padding:12px 32px;background:#e9e9e9;border-top:1px solid #d7d7d7;font-size:9px;color:#5c5c5c}.rn-panel-bottom button{font-size:9px;display:flex;align-items:center;gap:18px;min-height:30px;cursor:pointer}.rn-panel-bottom button span{font-size:18px}.rn-shade{position:fixed;inset:106px 0 0;background:#1818183b;backdrop-filter:blur(4px);z-index:55}.rn-lab-art{height:100%;position:relative;display:flex;align-items:end;justify-content:center;padding-bottom:20px}.rn-lab-art i{position:absolute;bottom:35px;left:calc(33% + var(--i)*7%);height:82px;width:39px;background:var(--color);border-radius:30px 30px 3px 3px;transform:rotate(calc(-30deg + var(--i)*15deg));transform-origin:bottom center;box-shadow:3px 4px 8px #0001}.rn-lab-art>span{font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:#5c5c5c;z-index:1}
 .rn-mobile{position:fixed;inset:0;z-index:90;background:#f2f2f2;color:#3a3a3a;display:flex;flex-direction:column;animation:nav-enter .2s ease-out}.rn-mobile-head{height:74px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid #d4d4d4;flex-shrink:0}.rn-mobile-head img{width:155px;height:auto;filter:brightness(0)}.rn-mobile-head button{display:flex;align-items:center;gap:17px;font-size:11px;min-height:44px}.rn-mobile-head button span{font-size:27px;font-weight:300}.rn-mobile-scroll{padding:27px 24px;overflow:auto;overscroll-behavior:contain;flex:1;min-height:0}.rn-mobile-group,.rn-mobile-direct{border-bottom:1px solid #d1d1d1}.rn-mobile-group>summary,.rn-mobile-direct{display:flex;align-items:center;gap:20px;padding:22px 0;font:31px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.03em;list-style:none;cursor:pointer}.rn-mobile-group>summary::-webkit-details-marker{display:none}.rn-mobile-group>summary>span,.rn-mobile-direct>span{font:9px Georgia,serif;color:#5c5c5c;letter-spacing:0}.rn-mobile-group summary b,.rn-mobile-direct b{margin-left:auto;font:23px Arial,sans-serif;color:#5c5c5c}.rn-mobile-group[open] summary b{transform:rotate(45deg)}.rn-mobile-group.rn-mobile-current>summary{color:#424242;background:#e4e4e4;padding-left:12px}.rn-mobile-direct[aria-current]{background:#e4e4e4;padding-left:12px;color:#424242}.rn-mobile-group>div{padding:0 0 20px 29px}.rn-mobile-group>div>a{display:block;font-size:13px;padding:13px 0;line-height:1.5;color:#5e5e5e;border-top:1px solid #e1e1e1}.rn-mobile-group strong{display:block;font-weight:400}.rn-mobile-group small{font-size:9px;color:#5c5c5c;display:block;margin-top:4px}.rn-mobile-group .rn-mobile-hub{display:flex;justify-content:space-between;font-size:11px;color:#3a3a3a;margin-bottom:8px}.rn-mobile-utility{display:flex;flex-wrap:wrap;gap:15px 22px;margin-top:28px}.rn-mobile-utility a{display:inline-flex;align-items:center;min-height:44px;font-size:10px;color:#5c5c5c}.rn-mobile-foot{padding:16px 24px 20px;border-top:1px solid #d4d4d4;background:#e8e8e8;flex-shrink:0;padding-bottom:max(20px,env(safe-area-inset-bottom))}.rn-mobile-foot>span{font-size:9px;color:#5c5c5c;display:block;margin-bottom:12px}.rn-mobile-foot>a{display:flex;justify-content:space-between;align-items:center;min-height:50px;padding:14px 20px;background:#3b3b3b;color:#f8f8f8;font-size:12px}.rn-mobile-foot>a>span{font-size:21px}
 :is(.rm-navigation,.rn-mobile) :is(a,button,summary):focus-visible{outline:3px solid #858585;outline-offset:3px}.rn-shade:focus-visible{outline:0}@keyframes nav-enter{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
 @media(max-width:1119px){.rn-desktop{display:none}.rn-mobile-toggle{display:flex}.rn-panel{display:none}.rn-bar{gap:20px}.rn-consult{gap:16px}}
 @media(max-width:767px){.rn-utility{display:none}.rn-bar{height:64px;padding:0 20px;gap:15px}.rn-brand img{width:145px;max-height:34px}.rn-actions{gap:16px}.rn-consult{padding:10px 12px;font-size:9px;min-height:39px;gap:12px}.rn-consult>span:first-child{font-size:0}.rn-consult>span:first-child:after{content:'Consultar';font-size:10px}.rn-mobile-toggle>span:last-child{display:none}.rn-mobile-toggle{min-width:44px;justify-content:center}.rn-shade{top:65px}}
 @media(max-width:380px){.rn-bar{padding:0 16px;gap:10px}.rn-brand img{width:125px}.rn-actions{gap:8px}.rn-consult{padding:10px;gap:8px}}
 @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<style>
.rn-consult,.scrolled .rn-consult,.is-expanded .rn-consult{background:#C41230!important;color:#fff!important;border-color:#C41230!important}.rn-consult:hover,.scrolled .rn-consult:hover,.is-expanded .rn-consult:hover{background:#a10f28!important;color:#fff!important}.rn-current:after,.rn-location i{background:#C41230!important}.rn-panel{border-top:3px solid #C41230}.rn-link-number,.rn-link-detail b,.rn-eyebrow{color:#C41230!important}.rn-help{background:#171717!important;color:#fff!important}.rn-help>span{color:#ddd!important}.rn-help>a{color:#fff!important}.rn-mobile-foot>a{background:#C41230!important;color:#fff!important}.rn-mobile-group.rn-mobile-current>summary,.rn-mobile-direct[aria-current]{color:#C41230!important;background:#fff0f2!important}.rn-panel-links>a:hover,.rn-panel-links>a.is-destination{background:#fff0f2!important}.rn-panel-links>a:hover strong{color:#C41230!important}
</style>
