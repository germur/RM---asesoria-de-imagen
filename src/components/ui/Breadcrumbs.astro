---
import { CaretRight, House } from "@phosphor-icons/react";

const { pathname } = Astro.url;
const segments = pathname.split("/").filter(Boolean);

// Mapa de nombres legibles para rutas
const routeNames: Record<string, string> = {
    herramientas: "Diagnóstico",
    servicios: "Servicios",
    academia: "Academia",
    contacto: "Contacto",
    libro: "Libro",
    "test-colorimetria": "Test de Color",
};

// No mostrar breadcrumbs en home (la raíz no lleva breadcrumb)
if (pathname === "/") return null;

// Rutas intermedias que SI existen como pagina propia. El resto de los
// segmentos son solo agrupadores en la URL (ej. /herramientas/colorimetria/)
// y se muestran como texto, no como enlace, para no apuntar a un 404.
const HUB_ROUTES = new Set([
    "/servicios/",
    "/academia/",
    "/herramientas/",
    "/blog/",
]);

const { theme = 'dark' } = Astro.props;
const isDark = theme === 'dark';

const textClass = isDark ? "text-gray-300" : "text-gray-500";
const hoverClass = isDark ? "hover:text-white" : "hover:text-brand-primary";
const activeClass = isDark ? "text-white" : "text-brand-primary";

// ─── BreadcrumbList schema (SEO + LLMs) ───
const SITE = "https://rogermurillo.co";
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        ...segments.map((segment, index) => {
            const route = `/${segments.slice(0, index + 1).join("/")}/`;
            const isLast = index === segments.length - 1;
            return {
                "@type": "ListItem",
                position: index + 2,
                name: (routeNames[segment] || segment.replace(/-/g, " ")).replace(/\b\w/g, (c) => c.toUpperCase()),
                // Solo declaramos `item` cuando la URL existe de verdad
                ...(isLast || HUB_ROUTES.has(route) ? { item: `${SITE}${route}` } : {}),
            };
        }),
    ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav aria-label="Breadcrumb" class="absolute top-20 left-0 w-full z-40">
    <div class="container mx-auto px-6 py-4">
    <ol
        class={`flex items-center space-x-2 text-xs uppercase tracking-widest font-medium ${textClass}`}
    >
        <li>
            <a
                href="/"
                class={`${hoverClass} transition-colors flex items-center gap-1`}
            >
                <House weight="bold" size={14} />
                <span class="sr-only">Inicio</span>
            </a>
        </li>

        {
            segments.map((segment, index) => {
                const isLast = index === segments.length - 1;
                const href = `/${segments.slice(0, index + 1).join("/")}/`;
                const name = routeNames[segment] || segment.replace(/-/g, " ");
                const isLinkable = !isLast && HUB_ROUTES.has(href);

                return (
                    <>
                        <li class="opacity-50">
                            <CaretRight size={12} weight="bold" />
                        </li>
                        <li>
                            {isLinkable ? (
                                <a
                                    href={href}
                                    class={`${hoverClass} transition-colors`}
                                >
                                    {name}
                                </a>
                            ) : (
                                <span
                                    class={isLast ? `${activeClass} font-bold` : undefined}
                                    aria-current={isLast ? "page" : undefined}
                                >
                                    {name}
                                </span>
                            )}
                        </li>
                    </>
                );
            })
        }
    </ol>
    </div>
</nav>
