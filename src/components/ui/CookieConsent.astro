<div
    id="cookie-banner"
    class="cookie-notice fixed z-50 transform translate-y-full transition-transform duration-300"
>
    <div class="max-w-3xl text-center md:text-left">
        <p class="text-sm font-light text-gray-300 leading-relaxed">
            <span class="cookie-title"
                >Tu privacidad.</span
            >
            Usamos cookies para analizar las visitas al sitio. Consulta nuestra <a
                href="/legales/privacidad/"
                class="cookie-policy"
                >política de privacidad</a
            >.
        </p>
    </div>

    <div class="flex gap-4 shrink-0">
        <button
            id="accept-cookies"
            class="cookie-accept"
        >
            Aceptar
        </button>
    </div>
</div>
<style>
 .cookie-notice{left:20px;bottom:18px;width:420px;max-width:calc(100vw - 40px);background:#f8f5ed;border:1px solid #d8d9ca;box-shadow:0 12px 40px #20291822;padding:20px 22px;color:#4a5540;display:flex;align-items:center;gap:18px;border-radius:4px}
 .cookie-notice.translate-y-full{transform:translateY(calc(100% + 35px))}
 .cookie-notice p{font-size:11px;line-height:1.8;color:#626b56;text-align:left}.cookie-title{display:block;color:#2a3c24;font:19px Georgia,serif;margin-bottom:6px}.cookie-policy{text-decoration:underline;text-underline-offset:3px;color:#34472d}.cookie-accept{background:#34472d;color:#fff;padding:12px 15px;min-height:44px;font-size:10px;cursor:pointer}.cookie-accept:hover{background:#526747}.cookie-accept:focus-visible{outline:3px solid #b3433f;outline-offset:3px}@media(max-width:600px){.cookie-notice{left:12px;bottom:12px;max-width:calc(100vw - 24px);padding:16px;gap:12px}}
</style>

<script>
    // Lógica de "Vibecoding": Sin plugins pesados, puro JS nativo
    const banner = document.getElementById("cookie-banner");
    const acceptBtn = document.getElementById("accept-cookies");

    // Solo mostrar si no ha aceptado antes
    if (!localStorage.getItem("cookiesAccepted")) {
        // Retraso de 2.5s para no agobiar al usuario apenas entra (UX Premium)
        setTimeout(() => {
            banner?.classList.remove("translate-y-full");
            const dice = document.getElementById("dice-fab");
            if (dice) dice.style.bottom = "100px";
        }, 2500);
    }

    acceptBtn?.addEventListener("click", () => {
        localStorage.setItem("cookiesAccepted", "true");
        banner?.classList.add("translate-y-full");
        const dice = document.getElementById("dice-fab");
        if (dice) dice.style.bottom = "";

        // Aquí se podrían disparar los eventos de consentimiento de GA4/Meta si fuera necesario
        // window.gtag('consent', 'update', { ... });
    });
</script>
