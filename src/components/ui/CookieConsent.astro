<div
    id="cookie-banner"
    class="cookie-notice fixed z-50 transform translate-y-full transition-transform duration-300"
>
    <div class="max-w-3xl text-center md:text-left">
        <p class="text-sm font-light text-gray-300 leading-relaxed">
            <span class="cookie-title"
                >Tu privacidad.</span
            >
            Usamos cookies para analizar las visitas al sitio. Consulta nuestra <a
                href="/legales/privacidad/"
                class="cookie-policy"
                >política de privacidad</a
            >.
        </p>
    </div>

    <div class="flex gap-4 shrink-0">
        <button
            id="accept-cookies"
            class="cookie-accept"
        >
            Aceptar
        </button>
    </div>
</div>
<style>
 .cookie-notice{left:20px;bottom:18px;width:420px;max-width:calc(100vw - 40px);background:#151515;border:1px solid #393939;box-shadow:0 12px 40px #00000033;padding:20px 22px;color:#eeeeee;display:flex;align-items:center;gap:18px;border-radius:4px}
 .cookie-notice.translate-y-full{transform:translateY(calc(100% + 35px))}
 .cookie-notice p{font-size:11px;line-height:1.8;color:#dddddd;text-align:left}.cookie-title{display:block;color:#ffffff;font:19px Georgia,serif;margin-bottom:6px}.cookie-policy{text-decoration:underline;text-underline-offset:3px;color:#ff8a9f}.cookie-accept{background:#C41230;color:#fff;padding:12px 15px;min-height:44px;font-size:10px;cursor:pointer}.cookie-accept:hover{background:#a10c25}.cookie-accept:focus-visible{outline:3px solid #ff8a9f;outline-offset:3px}@media(max-width:600px){.cookie-notice{left:12px;bottom:12px;max-width:calc(100vw - 24px);padding:16px;gap:12px}}
</style>

<script>
    // Lógica de "Vibecoding": Sin plugins pesados, puro JS nativo
    const banner = document.getElementById("cookie-banner");
    const acceptBtn = document.getElementById("accept-cookies");

    // Solo mostrar si no ha aceptado antes
    let accepted = false;
    try { accepted = localStorage.getItem("cookiesAccepted") === "true"; } catch (error) {}
    if (!accepted) {
        // Retraso de 2.5s para no agobiar al usuario apenas entra (UX Premium)
        setTimeout(() => {
            banner?.classList.remove("translate-y-full");
            const dice = document.getElementById("dice-fab");
            if (dice) dice.style.bottom = "100px";
        }, 2500);
    }

    acceptBtn?.addEventListener("click", () => {
        try { localStorage.setItem("cookiesAccepted", "true"); } catch (error) {}
        window.dispatchEvent(new Event('rm:analytics-consent'));
        banner?.classList.add("translate-y-full");
        const dice = document.getElementById("dice-fab");
        if (dice) dice.style.bottom = "";

    });
</script>
