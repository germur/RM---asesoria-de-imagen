---
interface Props { current?:'hair'|'personal'|'hub' }
const {current='hub'}=Astro.props;
const paths=[{id:'hair',tag:'COLORACIÓN CAPILAR',title:'Quiero cambiar mi cabello.',description:'Tono, mechas, iluminación o un cambio de color: el punto de partida es tu cabello y el resultado que buscas.',href:'/servicios/peluqueria/',action:'Explorar corte y color',note:'Técnica, preparación y precio se confirman según el servicio.'},{id:'personal',tag:'COLORIMETRÍA PERSONAL',title:'Quiero conocer mi paleta.',description:'Un análisis de los colores para tu vestuario, con informe digital o una sesión presencial con textiles.',href:'/servicios/colorimetria-bogota/',action:'Comparar estudios de color',note:'Digital $150.000 COP · Presencial $1.000.000 COP.'}];
---
<section class="color-paths" aria-labelledby="color-paths-title"><header><span>UNA PALABRA / DOS NECESIDADES</span><h2 id="color-paths-title">¿Color en tu cabello<br/>o en tu <em>paleta personal?</em></h2><p>Elige por lo que quieres resolver. La coloración del cabello y el estudio de colorimetría personal tienen alcances distintos.</p></header><div class="cp-lanes">{paths.map((p,i)=><article class:list={['cp-lane',{'cp-dark':i===1}]}><div class={`cp-art cp-art-${p.id}`} aria-hidden="true">{p.id==='hair'?<svg viewBox="0 0 380 170"><defs><linearGradient id="hair-strand" x1="0" x2="1"><stop stop-color="#322321"/><stop offset=".45" stop-color="#976444"/><stop offset="1" stop-color="#ccaa7f"/></linearGradient></defs>{[0,1,2,3,4].map(j=><path d={`M ${75+j*26} -20 C ${10+j*32} 80, ${230+j*16} 80, ${190+j*28} 195`} fill="none" stroke="url(#hair-strand)" stroke-width="22"/> )}<path d="M35 128h310" stroke="#C41230" stroke-dasharray="4 6"/></svg>:<div class="cp-swatches">{['#86384e','#be7b67','#cbb68d','#7a8e7c','#334d66'].map((c,j)=><i style={`--swatch:${c};--n:${j}`}/>)}</div>}<span>Ilustración conceptual</span></div><div class="cp-body"><span class="cp-tag">{p.tag}{current===p.id&&<b>ESTÁS AQUÍ</b>}</span><h3>{p.title}</h3><p>{p.description}</p><small>{p.note}</small>{current===p.id?<a href={p.id==='hair'?'#experiencia':'#modalidades'}>Ver las opciones de esta página <span aria-hidden="true">↓</span></a>:<a href={p.href}>{p.action}<span aria-hidden="true">↗</span></a>}</div></article>)}</div></section>
<style>
.color-paths{max-width:1280px;padding:65px 48px;margin:auto}.color-paths>header{display:grid;grid-template-columns:1.1fr .9fr;column-gap:70px;align-items:end;margin-bottom:32px}.color-paths>header>span{grid-column:1/-1;display:block;font:10px Arial,sans-serif;letter-spacing:.15em;color:#C41230;margin-bottom:20px}.color-paths h2{font:clamp(33px,3.8vw,49px)/1.08 'Playfair Display',Georgia,serif;letter-spacing:-.03em;color:#111}.color-paths h2 em{color:#C41230}.color-paths>header>p{font-size:14px;line-height:1.9;color:#626262;max-width:400px}.cp-lanes{display:grid;grid-template-columns:1fr 1fr;gap:24px}.cp-lane{border:1px solid #ddd;border-radius:10px;overflow:hidden;background:#fff;color:#111;min-width:0}.cp-dark{background:#161616;color:white;border-color:#161616}.cp-art{height:170px;position:relative;background:#ededed;overflow:hidden}.cp-art svg{width:100%;height:100%}.cp-art>span{position:absolute;bottom:10px;left:25px;font:8px Arial,sans-serif;color:#555;letter-spacing:.05em}.cp-dark .cp-art{background:#252525}.cp-dark .cp-art>span{color:#bbb}.cp-swatches{display:flex;align-items:center;justify-content:center;height:100%;gap:10px;transform:rotate(-8deg)}.cp-swatches i{display:block;width:53px;height:105px;border-radius:35px 35px 3px 3px;background:var(--swatch);transform:translateY(calc((var(--n) - 2)*8px));box-shadow:4px 8px 10px #0003}.cp-body{padding:26px}.cp-tag{display:flex;align-items:center;justify-content:space-between;gap:15px;font:9px/1.6 Arial,sans-serif;letter-spacing:.1em;color:#C41230}.cp-dark .cp-tag{color:#ff7188}.cp-tag b{font:7px Arial,sans-serif;letter-spacing:.04em;color:inherit}.cp-body h3{font:30px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.025em;margin:15px 0;color:inherit}.cp-body p{font-size:14px;line-height:1.8;color:#595959;max-width:450px}.cp-dark .cp-body p{color:#ddd}.cp-body small{display:block;font-size:12px;line-height:1.8;color:#626262;margin:18px 0}.cp-dark .cp-body small{color:#ccc}.cp-body a{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:50px;border-top:1px solid #ccc;font-size:12px;color:#C41230}.cp-body a>span{font-size:20px}.cp-dark .cp-body a{color:#fff;border-color:#ffffff35}.cp-body a:focus-visible{outline:3px solid #C41230;outline-offset:4px}@media(max-width:700px){.color-paths{padding:45px 24px}.color-paths>header{display:block}.color-paths>header>p{margin-top:20px}.color-paths h2{font-size:36px}.cp-lanes{grid-template-columns:1fr}.cp-body{padding:24px}.cp-body h3{font-size:28px}}
</style>
