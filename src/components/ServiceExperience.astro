---
import {serviceExperiences} from '@/data/serviceExperiences';
interface Props {service:keyof typeof serviceExperiences; part?:'hero'|'journey'}
const {service,part='hero'}=Astro.props;const d=serviceExperiences[service];
---
{part==='hero'?<section class={`sx-hero sx-${service}`} id={service==='integral'?'umbral':undefined}>
 <div class="sx-hero-inner"><div class="sx-copy"><span class="sx-eyebrow"><i aria-hidden="true"></i>{d.eyebrow}</span><h1>{d.title}{" "}<br/><em>{d.emphasis}</em></h1><p>{d.intro}</p><a class="sx-primary" href="#experiencia">Explorar el servicio <span aria-hidden="true">↘︎</span></a><div class="sx-hero-facts"><strong>{d.fact}</strong><span>{d.scope}</span></div></div>
 <figure class="sx-portrait"><span class="sx-portrait-ring" aria-hidden="true"></span><img src={d.image} alt={d.imageAlt} width="800" height="1000" fetchpriority="high"/><figcaption><span>ATENCIÓN PERSONAL / BOGOTÁ</span>{d.caption}<a href="/nosotros/">Conoce al equipo ↗</a></figcaption><span class="sx-side-note" aria-hidden="true">ROGER MURILLO / IMAGE ADVISORS</span></figure></div>
 <nav class="sx-breadcrumb-links" aria-label="Explorar el servicio"><a href="#experiencia">01 La experiencia ↓</a><a href="#alcance-servicio">02 Alcance y condiciones ↓</a><a href="/servicios/">03 Comparar servicios ↗</a></nav>
</section>:<section id="experiencia" class={`sx-journey sx-${service}`} data-service-experience aria-labelledby="sx-experience-title">
 <header><div><span class="sx-eyebrow">LA EXPERIENCIA / {d.items.length} {service==='hombres'?'ETAPAS DEL SERVICIO':'PUNTOS DE PARTIDA'}</span><h2 id="sx-experience-title">{d.question}</h2></div><p>{d.lead}</p></header>
 <div class="sx-explorer"><div class="sx-tabs" role="tablist" aria-label={service==='hombres'?'Etapas del fondo de armario':'Explorar el servicio'} aria-orientation="vertical">{d.items.map((item,i)=><button disabled role="tab" type="button" id={`sx-tab-${i}`} aria-controls={`sx-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span>0{i+1}</span><span>{item.label}</span><b aria-hidden="true">↗</b></button>)}<p class="sx-tabs-note">{d.fact}<span>{d.scope}</span></p></div>
 <div class="sx-stage"><div class={`sx-art art-${d.art}`} aria-hidden="true"><span class="sx-art-index">RM<span>ESTUDIO DE<br/>IMAGEN PERSONAL</span></span>
 {d.art==='wardrobe'||d.art==='executive'?<><div class="sx-hanger-line"></div><div class="sx-garments">{['#d5d0ca','#C41230','#373737'].map((color,i)=><svg viewBox="0 0 180 220" style={`--garment:${color};--n:${i}`}><path d="M75 22q0-17 14-17t14 14q0 8-14 15L25 65h130L89 34" fill="none" stroke="#aaa" stroke-width="3"/><path d="m62 65-24 14-24 61 29 12 12-30v94h70v-94l12 30 29-12-24-61-24-14-28 13z" fill="var(--garment)"/><path d="m62 65 28 50 28-50M90 115v101" fill="none" stroke="#fff" stroke-opacity=".4" stroke-width="1.3"/></svg>)}</div><span class="sx-art-caption">{d.art==='wardrobe'?'MENOS RUIDO. MÁS CRITERIO.':'PRESENCIA / CONTEXTO / COHERENCIA'}</span></>:d.art==='hair'?<><svg class="sx-face" viewBox="0 0 360 300"><defs><linearGradient id="face-grad" x1="0" x2="1"><stop stop-color="#383838"/><stop offset="1" stop-color="#111"/></linearGradient></defs><ellipse cx="185" cy="135" rx="95" ry="116" fill="url(#face-grad)" stroke="#666"/><path d="M91 119q-2-121 98-108 107 3 91 132-36-31-50-91-47 61-139 67" fill="#080808" stroke="#888"/><path d="m150 249-25 43m98-43 25 43M95 115h180M91 165h188M107 208h158M185 20v236" stroke="#C41230" stroke-dasharray="4 5"/><circle cx="185" cy="165" r="6" fill="#C41230"/><path d="m142 143 21-2m45 0 20 2m-63 64q20 10 41 0" fill="none" stroke="#aaa" stroke-width="2"/><circle cx="185" cy="141" r="138" fill="none" stroke="#ffffff25"/></svg><span class="sx-art-caption">FORMA / TEXTURA / MOVIMIENTO</span></>:<><div class="sx-dossier"><span>RM. <small>PROGRAMA<br/>INTEGRAL</small></span><strong>Tu imagen.<br/><em>Tu criterio.</em></strong><div>{['#151515','#C41230','#a79c91','#dfd6cc'].map(c=><i style={`background:${c}`}/>)}</div><b>IDENTIDAD → IMAGEN → ELECCIÓN</b></div><span class="sx-dossier-circle">11<span>FASES</span></span></>}
 <span class="sx-art-note">Ilustración conceptual del servicio</span></div>
 {d.items.map((item,i)=><div id={`sx-panel-${i}`} class="sx-panel" role="tabpanel" aria-labelledby={`sx-tab-${i}`} tabindex="0"><span class="sx-eyebrow">{item.tag}</span><h3>{item.title}</h3><p>{item.desc}</p><div class="sx-panel-bottom"><small>{item.detail}</small><a href={`/contacto/?interes=${d.interest}#form`}>{d.cta}<span aria-hidden="true">↗</span></a></div></div>)}
 </div></div>
 </section>}
<script>
 document.querySelectorAll<HTMLElement>('[data-service-experience]').forEach(root=>{const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));const panels=Array.from(root.querySelectorAll<HTMLElement>('[role=tabpanel]'));const select=(n:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.disabled=false;tab.setAttribute('aria-selected',String(i===n));tab.tabIndex=i===n?0:-1;panels[i].hidden=i!==n;});root.style.setProperty('--active-step',String(n));if(focus)tabs[n].focus();};select(0);tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',event=>{if(['ArrowDown','ArrowUp','Home','End'].includes(event.key)){event.preventDefault();select(event.key==='Home'?0:event.key==='End'?tabs.length-1:(i+(event.key==='ArrowDown'?1:-1)+tabs.length)%tabs.length,true);}});});});
</script>
<style>
.sx-hero{background:#f6f6f6;border-bottom:1px solid #ddd}.sx-hero-inner{max-width:1280px;margin:auto;padding:58px 48px 45px;display:grid;grid-template-columns:1.1fr .9fr;gap:65px;align-items:center}.sx-eyebrow{font:10px/1.7 Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:#C41230;display:flex;gap:12px;align-items:center}.sx-eyebrow i{width:22px;height:5px;background:#C41230}.sx-copy h1{font:clamp(42px,4.6vw,66px)/1.04 'Playfair Display',Georgia,serif;letter-spacing:-.04em;color:#111;margin:27px 0}.sx-copy h1 em{color:#C41230}.sx-copy>p{font-size:16px;line-height:1.9;color:#555;max-width:550px}.sx-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;background:#C41230;color:white;padding:17px 24px;min-height:54px;font-size:13px;margin-top:27px}.sx-primary>span{font-size:22px}.sx-primary:hover{background:#a10f28}.sx-hero-facts{margin-top:27px;padding-top:20px;border-top:1px solid #ccc;display:flex;flex-direction:column;gap:8px;color:#555;font-size:12px}.sx-hero-facts strong{font-size:16px;color:#111;font-weight:500}.sx-portrait{position:relative;background:#151515;height:480px;isolation:isolate;overflow:hidden;border-radius:130px 4px 4px 4px}.sx-portrait>img{height:100%;width:100%;object-fit:cover;object-position:center 25%;position:relative;z-index:1}.sx-portrait figcaption{position:absolute;bottom:0;left:0;right:0;z-index:2;padding:70px 30px 25px;background:linear-gradient(transparent,#000f);color:white;font:21px/1.2 'Playfair Display',Georgia,serif;border-bottom:4px solid #C41230}.sx-portrait figcaption>span{display:block;font:8px/1.6 Arial,sans-serif;letter-spacing:.15em;color:#ddd;margin-bottom:9px}.sx-portrait figcaption>a{font:10px Arial,sans-serif;display:block;color:#fff;margin-top:15px}.sx-side-note{position:absolute;right:15px;top:30px;color:#fff;z-index:3;font:7px Arial,sans-serif;letter-spacing:.15em;writing-mode:vertical-rl}.sx-portrait-ring{position:absolute;border:1px solid #C41230;width:260px;height:260px;border-radius:50%;right:-40px;top:-40px}.sx-breadcrumb-links{max-width:1184px;margin:auto;display:flex;justify-content:space-between;gap:20px;padding:22px 0;font-size:11px;border-top:1px solid #ccc;color:#555}.sx-breadcrumb-links a{display:flex;align-items:center;min-height:32px}.sx-breadcrumb-links a:hover{color:#C41230}
.sx-journey{max-width:1280px;padding:65px 48px;margin:auto;scroll-margin-top:120px}.sx-journey>header{display:flex;align-items:end;justify-content:space-between;gap:50px;margin-bottom:35px}.sx-journey h2{font:clamp(35px,4vw,53px)/1.06 'Playfair Display',Georgia,serif;letter-spacing:-.035em;max-width:650px;color:#111;margin-top:19px}.sx-journey>header>p{font-size:14px;line-height:1.8;color:#626262;max-width:310px}.sx-explorer{display:grid;grid-template-columns:.75fr 1.25fr;gap:35px}.sx-tabs{padding-top:3px}.sx-tabs button{display:flex;align-items:center;gap:22px;min-height:80px;padding:22px 20px 22px 0;border-bottom:1px solid #d3d3d3;width:100%;text-align:left;color:#555;cursor:pointer}.sx-tabs button>span:first-child{font:12px Georgia,serif;color:#777}.sx-tabs button>span:nth-child(2){font:27px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.02em}.sx-tabs button>b{margin-left:auto;font-size:20px;font-weight:400;color:#C41230}.sx-tabs button[aria-selected=true]{padding-left:20px;background:#151515;color:#fff;border-left:3px solid #C41230}.sx-tabs button[aria-selected=true]>span:first-child{color:#ff7188}.sx-tabs-note{padding:25px 0;font:21px Georgia,serif;color:#111}.sx-tabs-note>span{display:block;font:12px/1.8 Arial,sans-serif;color:#626262;margin-top:10px}.sx-stage{border:1px solid #ddd;border-radius:10px;overflow:hidden;background:#fff}.sx-art{position:relative;background:radial-gradient(ellipse at 65% 50%,#353535,#151515 70%);height:290px;overflow:hidden;color:#fff}.sx-art-index{position:absolute;top:20px;left:25px;display:flex;align-items:center;gap:15px;font:27px Georgia,serif}.sx-art-index>span{font:6px/1.5 Arial,sans-serif;letter-spacing:.1em;color:#ddd}.sx-art-note{position:absolute;bottom:12px;left:25px;font:8px Arial,sans-serif;color:#bbb;letter-spacing:.04em}.sx-art-caption{position:absolute;bottom:45px;left:25px;font:9px Arial,sans-serif;letter-spacing:.13em;max-width:120px;line-height:1.8;color:#ddd}.sx-hanger-line{position:absolute;top:65px;left:10%;right:5%;height:2px;background:#aaa}.sx-garments{position:absolute;inset:65px 10px 20px 34%;display:flex;align-items:start;justify-content:center}.sx-garments svg{position:absolute;width:145px;height:190px;transform:translateX(calc((var(--n) - 1)*65px)) rotate(calc((var(--n) - 1)*8deg));transform-origin:top;filter:drop-shadow(5px 9px 7px #0005);transition:transform .4s}.sx-stage:hover .sx-garments svg{transform:translateX(calc((var(--n) - 1)*75px)) rotate(calc((var(--n) - 1)*11deg))}.sx-face{position:absolute;right:35px;top:2px;width:310px;height:285px;transform:rotate(calc(var(--active-step,0)*3deg));transition:transform .4s}.sx-dossier{position:absolute;right:18%;top:20px;width:205px;padding:22px;background:#f5f5f5;transform:rotate(-8deg);box-shadow:12px 17px 25px #0005;color:#111}.sx-dossier>span{display:flex;justify-content:space-between;font:27px Georgia,serif}.sx-dossier small{font:6px/1.5 Arial,sans-serif}.sx-dossier strong{display:block;font:27px/1 Georgia,serif;margin:20px 0}.sx-dossier em{color:#C41230}.sx-dossier>div{display:flex;gap:7px}.sx-dossier i{height:29px;width:29px;border-radius:50%}.sx-dossier>b{display:block;font:6px Arial,sans-serif;letter-spacing:.08em;margin-top:20px;padding-top:13px;border-top:1px solid #ccc}.sx-dossier-circle{position:absolute;right:8%;bottom:35px;width:90px;height:90px;border-radius:50%;display:flex;justify-content:center;align-items:center;flex-direction:column;background:#C41230;font:36px Georgia,serif;color:#fff}.sx-dossier-circle>span{font:8px Arial,sans-serif;letter-spacing:.1em}.sx-panel{padding:30px}.sx-panel[hidden]{display:none}.sx-panel h3{font:31px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.02em;color:#111;margin:17px 0}.sx-panel>p{font-size:14px;line-height:1.9;color:#555}.sx-panel-bottom{border-top:1px solid #ddd;margin-top:22px;padding-top:20px;display:grid;gap:20px}.sx-panel small{font-size:12px;line-height:1.8;color:#626262}.sx-panel a{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:54px;background:#C41230;color:#fff;padding:16px 20px;font-size:12px}.sx-panel a>span{font-size:20px}.sx-panel a:hover{background:#a10f28}:is(.sx-hero,.sx-journey) :is(a,button,[tabindex]):focus-visible{outline:3px solid #C41230;outline-offset:4px}
@media(max-width:900px){.sx-hero-inner{padding:40px 24px;gap:30px}.sx-copy h1{font-size:46px}.sx-portrait{height:440px}.sx-journey{padding:45px 24px}.sx-explorer{gap:22px}.sx-tabs button>span:nth-child(2){font-size:24px}.sx-breadcrumb-links{padding:20px 24px}.sx-face{right:5px}.sx-art-caption{max-width:90px}}
@media(max-width:700px){.sx-hero-inner{grid-template-columns:1fr;padding:35px 24px;gap:30px}.sx-copy h1{font-size:44px}.sx-copy>p{font-size:15px}.sx-portrait{height:330px;border-radius:80px 4px 4px 4px}.sx-portrait>img{object-position:50% 25%}.sx-portrait figcaption{padding:60px 22px 20px;font-size:20px}.sx-breadcrumb-links{flex-wrap:wrap;justify-content:start;gap:6px 22px;font-size:10px}.sx-journey>header{display:block}.sx-journey>header>p{max-width:none;margin-top:20px}.sx-journey h2{font-size:38px}.sx-explorer{grid-template-columns:1fr;gap:20px}.sx-tabs{display:grid;grid-template-columns:1fr 1fr;gap:7px}.sx-tabs button{min-height:68px;padding:15px 12px;gap:9px;border:1px solid #ddd}.sx-tabs button>span:nth-child(2){font-size:21px}.sx-tabs button[aria-selected=true]{padding-left:12px}.sx-tabs button>b{font-size:17px}.sx-tabs-note{grid-column:1/-1;padding:15px 0 0;font-size:19px}.sx-tabs-note>span{font-size:11px}.sx-art{height:255px}.sx-panel{padding:25px 22px}.sx-panel h3{font-size:29px}.sx-art-index{left:20px}.sx-face{width:255px;height:245px;right:0}.sx-art-caption{left:20px;font-size:7px;max-width:70px;bottom:35px}.sx-garments{left:30%;top:52px}.sx-garments svg{width:125px;height:165px;transform:translateX(calc((var(--n) - 1)*48px)) rotate(calc((var(--n) - 1)*8deg))}.sx-hanger-line{top:52px}.sx-dossier{width:180px;right:20%;padding:17px;top:15px}.sx-dossier strong{font-size:25px}.sx-dossier-circle{width:75px;height:75px;right:7%;font-size:31px}.sx-art-note{left:20px}}
@media(prefers-reduced-motion:reduce){.sx-garments svg,.sx-face{transition:none}.sx-stage:hover .sx-garments svg{transform:translateX(calc((var(--n) - 1)*65px))}}
</style>

<style>.sx-stage,.sx-tabs,.sx-panel{min-width:0}.sx-tabs button{min-width:0}.sx-tabs button>span:nth-child(2){min-width:0;overflow-wrap:anywhere}@media(max-width:700px){.sx-explorer{grid-template-columns:minmax(0,1fr)}.sx-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}.sx-tabs button>span:nth-child(2){font-size:20px}}@media(max-width:380px){.sx-tabs button{padding:13px 8px;gap:7px}.sx-tabs button>span:nth-child(2){font-size:18px}.sx-tabs button[aria-selected=true]{padding-left:8px}}</style>
