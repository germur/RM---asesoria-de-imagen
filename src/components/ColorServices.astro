.cs-choices{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}.cs-choice{display:block;position:relative;min-width:0;text-align:left;cursor:pointer;background:#fff;color:#111;border:1px solid #d8d8d8;border-radius:12px;overflow:hidden;isolation:isolate;transition:box-shadow .3s,border-color .3s,transform .3s}.cs-choice:hover{transform:translateY(-4px);box-shadow:0 20px 45px #00000012}.cs-choice[aria-selected=true]{border-color:#C41230;box-shadow:0 0 0 1px #C41230}.cs-choice:focus-visible{outline:3px solid #C41230;outline-offset:5px}.choice-presencial{background:#161616;color:#fff;margin-top:38px}.choice-top{position:relative;z-index:2;padding:23px 28px;display:flex;align-items:center;justify-content:space-between}.choice-top>span:first-child{display:flex;align-items:center;gap:13px;font-size:11px}.choice-top b{font:11px Georgia,serif;color:#C41230}.choice-presencial .choice-top b{color:#ff7188}.choice-radio{display:flex;align-items:center;justify-content:center;border:1px solid #aaa;width:24px;height:24px;border-radius:50%;font-size:13px;color:transparent}.cs-choice[aria-selected=true] .choice-radio{background:#C41230;border-color:#C41230;color:#fff}.choice-stage{height:310px;display:block;position:relative;overflow:hidden;background:radial-gradient(ellipse at 70% 70%,#e2e2e2,transparent 65%),#f4f4f4}.choice-presencial .choice-stage{background:radial-gradient(ellipse at 65% 60%,#383838,transparent 65%),#161616}.choice-display{position:absolute;top:22px;left:28px;z-index:3;font:clamp(26px,3vw,39px)/1.08 'Playfair Display',Georgia,serif;letter-spacing:-.035em;max-width:200px}.choice-display em{color:#C41230}.choice-presencial .choice-display em{color:#ff7188}.choice-art-note{position:absolute;z-index:4;bottom:13px;left:28px;font:8px/1.4 Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#666}.choice-presencial .choice-art-note{color:#bbb}
.digital-composition{position:absolute;inset:0;display:block}.report-sheet{position:absolute;right:35px;top:36px;width:187px;background:#fff;padding:17px;transform:rotate(11deg);box-shadow:0 20px 30px #0002;z-index:2;transition:transform .5s}.cs-choice:hover .report-sheet{transform:rotate(5deg) translateY(-5px)}.report-monogram{display:flex;align-items:center;justify-content:space-between;font:23px Georgia,serif;letter-spacing:-.08em;color:#111}.report-monogram>span{font:6px/1.4 Arial,sans-serif;letter-spacing:.1em}.report-line{display:block;height:2px;width:35px;background:#C41230;margin:14px 0}.report-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.report-grid i{display:block;height:32px;border-radius:50% 50% 3px 3px;background:var(--swatch)}.report-sign{display:flex;justify-content:space-between;align-items:center;font:6px Arial,sans-serif;letter-spacing:.1em;border-top:1px solid #ddd;padding-top:12px;margin-top:15px}.report-sign>span{font-size:18px;color:#C41230}.phone-palette{position:absolute;right:170px;bottom:21px;z-index:3;width:118px;height:204px;border:5px solid #181818;border-radius:20px;background:#fff;transform:rotate(-10deg);box-shadow:5px 12px 22px #0003;padding:18px 10px 10px;transition:transform .5s}.cs-choice:hover .phone-palette{transform:rotate(-5deg) translateY(-5px)}.phone-speaker{position:absolute;top:5px;left:35px;width:36px;height:6px;background:#181818;border-radius:5px}.phone-label{font:5px Arial,sans-serif;letter-spacing:.07em;color:#333}.phone-circles{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:20px}.phone-circles i{display:block;aspect-ratio:1;border-radius:50%}.phone-bottom{font:6px Georgia,serif;color:#333;display:block;margin-top:16px}.art-orbit{position:absolute;border:1px solid #C4123026;border-radius:50%;width:300px;height:300px;right:-30px;top:30px;transform:rotate(-20deg)}
.studio-composition{position:absolute;inset:0}.studio-orbit{position:absolute;right:-25px;top:40px;width:300px;height:300px;border:1px solid #ffffff26;border-radius:50%}.fabric-fan{position:absolute;right:17px;top:45px;width:245px;height:255px}.fabric-fan>i{position:absolute;left:90px;bottom:20px;width:68px;height:212px;border-radius:45px 45px 6px 6px;background:linear-gradient(95deg,#fff0,#fff2 25%,#0002 55%,#fff1 70%,#0002),var(--fabric);box-shadow:5px 7px 10px #0003;transform:rotate(calc(-60deg + var(--n)*24deg));transform-origin:50% 92%;transition:transform .5s}.cs-choice:hover .fabric-fan>i{transform:rotate(calc(-67deg + var(--n)*27deg))}.fan-pin{position:absolute;bottom:32px;left:118px;width:13px;height:13px;border:3px solid #c5c5c5;background:#333;border-radius:50%;box-shadow:0 2px 5px #0008}.studio-seal{position:absolute;left:28px;bottom:45px;font:29px/1 Georgia,serif;display:block}.studio-seal>span{display:block;font:7px/1.5 Arial,sans-serif;letter-spacing:.13em;color:#ccc;margin-top:8px}
.choice-info{display:block;padding:26px 28px 25px}.choice-tag{font:8px/1.6 Arial,sans-serif;letter-spacing:.14em;color:#626262}.choice-presencial .choice-tag{color:#bbb}.choice-name{display:block;font:30px/1.2 'Playfair Display',Georgia,serif;letter-spacing:-.025em;margin:9px 0 10px}.choice-description{display:block;max-width:350px;font-size:13px;line-height:1.8;color:#595959;min-height:47px}.choice-presencial .choice-description{color:#d0d0d0}.choice-bottom{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:24px;padding-top:22px;border-top:1px solid #ddd}.choice-presencial .choice-bottom{border-color:#ffffff30}.choice-price{display:flex;align-items:baseline;gap:5px;font:clamp(23px,2.5vw,32px)/1.2 Georgia,serif;white-space:nowrap}.choice-price small{font:10px Arial,sans-serif}.choice-price small:first-child{font:20px Georgia,serif}.choice-action{display:flex;align-items:center;gap:10px;font-size:10px;white-space:nowrap}.action-arrow{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#C41230;color:white;font-size:20px}.action-selected{display:none}.cs-choice[aria-selected=true] .action-idle{display:none}.cs-choice[aria-selected=true] .action-selected{display:inline}.cs-art-disclaimer{font:10px/1.7 Arial,sans-serif;color:#626262;margin:18px 0 32px;max-width:650px}
.cs-panel{border-top:1px solid #bdbdbd;padding:28px 0 0;scroll-margin-top:130px}.cs-panel[hidden]{display:none}.cs-panel>header{display:flex;justify-content:space-between;gap:30px;align-items:center;margin-bottom:25px}.cs-panel h3{font:27px/1.2 'Playfair Display',Georgia,serif;color:#111;letter-spacing:-.02em;max-width:500px}.cs-panel dl{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding:25px 0;border-top:1px solid #ddd;border-bottom:1px solid #ddd}.cs-panel dt{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#626262;display:flex;gap:10px;align-items:center;margin-bottom:13px}.cs-panel dt>span{color:#C41230;font:12px Georgia,serif}.cs-panel dd{font-size:15px;line-height:1.6;color:#222;max-width:280px}.experience-bottom{display:flex;align-items:center;justify-content:space-between;gap:35px;padding-top:25px}.experience-bottom>p{font-size:12px;line-height:1.8;max-width:600px;color:#626262}.experience-bottom>a{display:flex;align-items:center;justify-content:space-between;gap:22px;min-height:54px;padding:16px 22px;color:#fff;background:#C41230;font-size:12px;flex-shrink:0}.experience-bottom>a>span{font-size:20px}.experience-bottom>a:hover{background:#a10f28}.cs-footer{display:flex;gap:15px;align-items:start;margin-top:25px;max-width:750px;font-size:12px;line-height:1.8;color:#626262}.cs-footer>span{font-size:24px;color:#C41230}.cs-footer a{color:#111;text-decoration:underline;text-underline-offset:4px}.color-services :is(a,button,[tabindex]):focus-visible{outline:3px solid #C41230;outline-offset:5px}
