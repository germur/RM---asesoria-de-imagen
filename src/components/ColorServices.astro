---
const swatches=['#784552','#af7560','#d2b995','#b09d67','#788975','#3d5962','#3e404f','#b7837f','#ded1b6','#74647d','#a5443d','#68513e'];
const options=[
 {id:'digital',number:'01',label:'Informe digital',eyebrow:'Desde donde estés',tag:'ANÁLISIS POR FOTOGRAFÍAS',title:'Tu paleta.\nSiempre contigo.',description:'Para tener tus colores a mano cuando eliges qué ponerte.',price:'150.000',facts:[['El punto de partida','Tus fotografías por WhatsApp'],['Acompañamiento','Indicaciones y revisión personal de Roger'],['El resultado','Informe con paleta y círculos cromáticos']],note:'El plazo de entrega se confirma al coordinar. La iluminación y la cámara influyen en el análisis por fotografías.',cta:'Quiero mi informe digital'},
 {id:'presencial',number:'02',label:'Sesión presencial',eyebrow:'En el estudio · Bogotá',tag:'2,5–3 HORAS / INFORME INCLUIDO',title:'El color se ve.\nY se aprende.',description:'Para descubrir tus colores con textiles y aprender a combinarlos.',price:'1.000.000',facts:[['El punto de partida','Una cita en nuestro estudio en Bogotá'],['La experiencia','Comparación con textiles y práctica de combinaciones'],['El resultado','Tu paleta explicada y el informe digital incluido']],note:'Sesión de aproximadamente 2,5 a 3 horas. Disponibilidad y preparación se confirman con el equipo antes de reservar.',cta:'Consultar disponibilidad presencial'}
];
---
<section id="modalidades" class="color-services" aria-labelledby="color-services-title">
 <header class="cs-intro"><div><span class="cs-kicker"><i aria-hidden="true"></i> DOS FORMAS DE DESCUBRIRTE</span><h2 id="color-services-title">Tu color.<br/><em>A tu manera.</em></h2></div><div class="cs-intro-copy"><p>¿Una paleta para consultar o una experiencia para aprender?</p><span>Compara ambas opciones.<br/>Elige una para conocer el proceso.</span></div></header>
 <div class="cs-choices" role="tablist" aria-label="Elige la modalidad del estudio de color">
 {options.map((o,i)=><button disabled type="button" role="tab" id={`tab-${o.id}`} class={`cs-choice choice-${o.id}`} aria-controls={`panel-${o.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>
  <span class="choice-top"><span><b>{o.number}</b>{o.eyebrow}</span><span class="choice-radio" aria-hidden="true">✓</span></span>
  <span class="choice-stage" aria-hidden="true">
   <span class="choice-display">{o.id==='digital'?<>Tu paleta.<br/><em>Siempre contigo.</em></>:<>El color se ve.<br/><em>Y se aprende.</em></>}</span>
   {o.id==='digital'?<span class="digital-composition"><span class="report-shadow"></span><span class="report-sheet"><span class="report-monogram">RM<span>ESTUDIO<br/>DE COLOR</span></span><span class="report-line"></span><span class="report-grid">{swatches.map((c,j)=><i style={`--swatch:${c};--n:${j}`} />)}</span><span class="report-sign">TU PALETA PERSONAL <span>↗</span></span></span><span class="phone-palette"><span class="phone-speaker"></span><span class="phone-label">COLOR / PERSONAL</span><span class="phone-circles">{swatches.slice(0,6).map(c=><i style={`background:${c}`}/>)}</span><span class="phone-bottom">Una guía para elegir.</span></span><span class="art-orbit"></span></span>:<span class="studio-composition"><span class="studio-orbit"></span><span class="fabric-fan">{['#6e3045','#c27f69','#d4b17b','#7c8d7c','#335468','#b69b62'].map((c,j)=><i style={`--fabric:${c};--n:${j}`} />)}<span class="fan-pin"></span></span><span class="studio-seal">2,5–3<span>HORAS<br/>EN EL ESTUDIO</span></span></span>}
   <span class="choice-art-note">Composición ilustrativa</span>
  </span>
  <span class="choice-info"><span class="choice-tag">{o.tag}</span><span class="choice-name">{o.label}</span><span class="choice-description">{o.description}</span><span class="choice-bottom"><span class="choice-price"><small>$</small>{o.price}<small>COP</small></span><span class="choice-action"><span class="action-idle">Ver experiencia</span><span class="action-selected">Seleccionada</span><span class="action-arrow" aria-hidden="true">↗</span></span></span></span>
 </button>)}
 </div>
 <p class="cs-art-disclaimer">Los gráficos ilustran cada modalidad; no son muestras de un informe ni fotografías de una sesión.</p>
 <div class="cs-experience" aria-live="polite">
 {options.map(o=><div id={`panel-${o.id}`} class="cs-panel" role="tabpanel" aria-labelledby={`tab-${o.id}`} tabindex="0">
  <header><span class="cs-kicker">ASÍ TRABAJAMOS / {o.number}</span><h3>{o.id==='digital'?'De tus fotografías a tu paleta.':'Una sesión para mirar, probar y aprender.'}</h3></header>
  <dl>{o.facts.map(([label,value],i)=><div><dt><span>0{i+1}</span>{label}</dt><dd>{value}</dd></div>)}</dl>
  <div class="experience-bottom"><p>{o.note}</p><a href="#consulta-color" data-color-choice={o.id}>{o.cta}<span aria-hidden="true">↗</span></a></div>
 </div>)}
 </div>
 <footer class="cs-footer"><span aria-hidden="true">↳</span><p>¿Quieres explorar primero? <a href="/herramientas/test-colorimetria-online/">Prueba el test gratuito</a>. Es una orientación automática; estos estudios incluyen atención personal.</p></footer>
</section>
<script>
 const root=document.querySelector<HTMLElement>('.color-services');
 if(root){
 const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));const panels=Array.from(root.querySelectorAll<HTMLElement>('[role=tabpanel]'));
 const select=(index:number,focus=false)=>{const mode=index===0?'digital':'presencial';tabs.forEach((tab,i)=>{tab.disabled=false;tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].hidden=i!==index;});document.querySelectorAll<HTMLElement>('[data-color-process]').forEach(el=>el.hidden=el.dataset.colorProcess!==mode);const inquiry=document.querySelector<HTMLSelectElement>('#color-interest');if(inquiry)inquiry.value=mode;document.dispatchEvent(new CustomEvent('color-mode-change',{detail:mode}));if(focus)tabs[index].focus();};
 select(0);
 document.querySelectorAll<HTMLElement>('[data-color-choice]').forEach(el=>el.addEventListener('click',()=>select(el.dataset.colorChoice==='presencial'?1:0)));
 document.querySelector('#color-interest')?.addEventListener('change',event=>select((event.target as HTMLSelectElement).value==='presencial'?1:0));
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();select(event.key==='Home'?0:event.key==='End'?1:(i+1)%2,true);}});});
 }
</script>
<style>
