@media(max-width:380px){.choice-display{font-size:27px}.report-sheet{right:10px;width:150px;top:75px}.phone-palette{right:115px;transform:rotate(-10deg) scale(.75)}.fabric-fan{right:-32px;top:55px;transform:scale(.8)}.choice-price{font-size:24px}.choice-action{font-size:8px}.choice-info{padding:22px 18px}}
