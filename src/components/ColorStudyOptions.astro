---
const { fromResult = false } = Astro.props;
const options = [
    { id: 'digital', number: '01', title: 'Informe digital', price: '$150.000 COP', context: 'A distancia', description: 'Roger revisa tus fotografías y prepara un informe con tu paleta y ejemplos de combinaciones.', action: 'Consultar por mi informe digital' },
    { id: 'presencial', number: '02', title: 'Sesión en Bogotá', price: '$1.000.000 COP', context: 'En el estudio · 2,5 a 3 horas', description: 'Compara textiles cerca del rostro, aprende a combinar tus colores y llévate el informe digital.', action: 'Consultar una cita presencial' },
] as const;
---
<section id="estudio-personal" class="bg-[#151515] text-white scroll-mt-28" aria-labelledby="estudio-color-title">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-20">
        <div class="grid md:grid-cols-[1.1fr_.9fr] gap-4 md:gap-12 items-end mb-8 md:mb-10">
            <div>
                <p class="text-[11px] uppercase tracking-[.2em] text-[#ff9aac] mb-4">Colorimetría personal / Roger Murillo</p>
                <h2 id="estudio-color-title" class="font-serif text-4xl md:text-5xl leading-tight">
                    {fromResult ? 'De esta orientación' : 'Encuentra tu paleta'}<br />
                    <em class="text-[#ff9aac]">{fromResult ? 'a tu paleta personal.' : 'con un estudio personal.'}</em>
                </h2>
            </div>
            <p class="text-neutral-300 leading-relaxed">Si quieres tomar decisiones de vestuario o maquillaje con una guía propia, elige cómo prefieres trabajar el color con el estudio.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-4 md:gap-6">
            {options.map((option) => {
                const interest = `colorimetria-${option.id}`;
                return (
                    <article class="border border-neutral-600 bg-[#202020] p-6 md:p-8 flex flex-col items-start">
                        <p class="text-xs text-[#ff9aac] mb-4"><span class="mr-3">{option.number}</span>{option.context}</p>
                        <h3 class="font-serif text-3xl mb-2">{option.title}</h3>
                        <p class="font-medium mb-4">{option.price}</p>
                        <p class="text-neutral-300 leading-relaxed mb-6 flex-1">{option.description}</p>
                        <a class="inline-flex min-h-12 items-center gap-4 bg-brand-primary text-white px-5 py-3 text-sm font-medium hover:bg-white hover:text-brand-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                            href={`/contacto/?interes=${interest}&herramienta=colorimetria#form`}
                            data-tool-funnel="colorimetria" data-tool-service={interest}>
                            {option.action}<span aria-hidden="true">↗</span>
                        </a>
                    </article>
                );
            })}
        </div>
        <p class="mt-5 text-sm text-neutral-300">Te confirmamos disponibilidad y condiciones antes de reservar. <a href="/servicios/colorimetria-bogota/#modalidades" class="text-white underline underline-offset-4">Ver el alcance de cada modalidad</a>.</p>
    </div>
</section>
