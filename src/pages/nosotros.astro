---
import FirmExperience from "@/components/FirmExperience.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const organizationSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "AboutPage",
            "@id": "https://rogermurillo.co/nosotros/#aboutpage",
            url: "https://rogermurillo.co/nosotros/",
            about: { "@id": "https://rogermurillo.co/#organization" },
            mainEntity: [
                { "@id": "https://rogermurillo.co/nosotros/#roger" },
                { "@id": "https://rogermurillo.co/nosotros/#adriana" },
            ],
        },
        {
            "@type": "Person",
            "@id": "https://rogermurillo.co/nosotros/#roger",
            name: "Roger Murillo",
            jobTitle: "Director Creativo & Estratega de Imagen",
            description: "Asesor de imagen con más de 35 años de experiencia. Especialista en visagismo, arquitectura facial y peluquería de autor.",
            image: "https://rogermurillo.co/images/roger-portrait-bw.webp",
            worksFor: { "@id": "https://rogermurillo.co/#organization" },
            knowsAbout: ["Visagismo", "Arquitectura facial", "Asesoría de imagen", "Peluquería de autor", "Imagen ejecutiva"],
            sameAs: ["https://www.instagram.com/rogermurilloai/"],
        },
        {
            "@type": "Person",
            "@id": "https://rogermurillo.co/nosotros/#adriana",
            name: "Adriana Garzón",
            jobTitle: "Consultora Senior & Especialista en Colorimetría",
            description: "Especialista en colorimetría, salud capilar y diseño de color, con más de 22 años de experiencia.",
            image: "https://rogermurillo.co/images/adriana-portrait-bw.webp",
            worksFor: { "@id": "https://rogermurillo.co/#organization" },
            knowsAbout: ["Colorimetría", "Salud capilar", "Diseño de color", "Asesoría de imagen"],
            alumniOf: [
                { "@type": "EducationalOrganization", name: "IDB Barcelona" },
                { "@type": "EducationalOrganization", name: "New York Institute" },
            ],
            sameAs: ["https://www.instagram.com/rogermurilloai/"],
        },
    ],
});
---

<MainLayout navbarTheme="light" breadcrumbsInFlow
    title="Asesores de Imagen Personal · Visagismo · Colorimetría | Roger Murillo & Adriana Garzón"
    description="Roger Murillo y Adriana Garzón: expertos en consultoría de imagen, visagismo profesional y colorimetría en Bogotá. Conoce al equipo y su forma de trabajar cabello, color y vestuario."
    schema={organizationSchema}
>

    <FirmExperience />
</MainLayout>
