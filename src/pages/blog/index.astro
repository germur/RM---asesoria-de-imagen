---
import MainLayout from '@/layouts/MainLayout.astro';
import EditorialHero from '@/components/EditorialHero.astro';
import ResourceCatalog from '@/components/ResourceCatalog.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>(b.data.updatedDate||b.data.pubDate).valueOf()-(a.data.updatedDate||a.data.pubDate).valueOf());
const items=[
 {href:'/blog/cuanto-cuesta-asesoria-imagen-bogota/',title:'Elegir una asesoría empieza por su alcance',description:'Compara colorimetría, fondo de armario y acompañamiento integral. Qué incluye cada servicio y qué preguntar antes de reservar.',meta:'Guía de contratación / Bogotá',category:'Servicios',image:'/images/roger-portrait-bw.webp'},
 {href:'/blog/guia-visagismo/',title:'Corte, barba y gafas: una mirada al conjunto',description:'Proporciones, textura y rutina como punto de partida para decidir sin reglas rígidas.',meta:'Guía / Visagismo',category:'Cabello y rostro',motif:'face'},
 ...posts.map(post=>({href:`/blog/${post.id}/`,title:post.data.title,description:post.data.description,meta:`Lectura / ${(post.data.updatedDate||post.data.pubDate).toLocaleDateString('es-CO',{year:'numeric',month:'long'})}`,category:post.id==='colorimetria'?'Color':post.id==='visagismo'?'Cabello y rostro':'Estilo',...(post.data.heroImage?{image:post.data.heroImage}:{motif:post.id==='colorimetria'?'color':post.id==='visagismo'?'face':'identity'})}))
];
---
<MainLayout title="Blog de Imagen y Estilo Ejecutivo | Roger Murillo" description="Guías prácticas de colorimetría, visagismo, armario y asesoría de imagen. Lecturas para decidir con criterio." navbarTheme="light" breadcrumbsInFlow>
 <EditorialHero eyebrow="Journal / Ideas que se llevan puestas" title="Observa distinto." emphasis="Elige mejor." description="Guías para llevar el color, las proporciones y el estilo a decisiones reales. Del primer corte al siguiente cambio de vida." />
 <ResourceCatalog items={items} label="Lecturas de imagen personal" />
</MainLayout>
