---
import MainLayout from "@/layouts/MainLayout.astro";
import ColorQuiz from "@/components/tools/ColorQuiz";

const description = "Haz el test de colorimetría online gratis. Responde tres preguntas y obtén una orientación sobre tu estación de color y qué tonos probar. Sin fotos ni registro.";
const toolSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Test de colorimetría online gratis",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Web",
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
    },
    description,
};
---

<MainLayout navbarTheme="light" breadcrumbsInFlow
    title="Test de Colorimetría Online Gratis · Orienta tu Paleta | Roger Murillo"
    {description}
    schema={JSON.stringify(toolSchema)}
>
    <section class="py-8 md:py-16 bg-white">
        <div class="container mx-auto px-6 max-w-3xl text-center">
            <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-3 md:mb-5">
                Herramienta gratuita
            </p>

            <h1 class="font-serif text-4xl md:text-6xl leading-[1.1] text-brand-black mb-4 md:mb-6">
                Test de colorimetría <br />
                <span class="italic text-brand-primary">online gratis</span>
            </h1>

            <p class="text-base md:text-lg text-neutral-700 leading-relaxed max-w-xl mx-auto mb-5 md:mb-8">
                Responde tres preguntas y obtén una orientación sobre tu estación de color y qué tonos explorar.
            </p>

            <div class="relative">
                <ColorQuiz client:load />
            </div>
        </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-24">
        <div class="container mx-auto px-6 max-w-3xl">
            <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-4">
                El método
            </p>
            <h2 class="font-serif text-3xl md:text-5xl leading-tight text-brand-black mb-6">
                ¿Cómo funciona el test de colorimetría?
            </h2>
            <p class="text-neutral-700 leading-relaxed mb-8">
                La colorimetría personal estudia cómo se ven distintos colores cerca de tu rostro.
                El cuestionario cruza tres respuestas para sugerirte una paleta que puedas explorar.
            </p>
            <dl class="divide-y divide-neutral-300 border-y border-neutral-300">
                <div class="py-4">
                    <dt class="font-serif text-xl text-brand-black">Subtono orientativo</dt>
                    <dd class="text-neutral-700 mt-1">Partimos de cómo sueles describir la reacción de tu piel al sol.</dd>
                </div>
                <div class="py-4">
                    <dt class="font-serif text-xl text-brand-black">Contraste</dt>
                    <dd class="text-neutral-700 mt-1">Compara qué tan claros u oscuros se ven tu piel, tus ojos y tu cabello entre sí.</dd>
                </div>
                <div class="py-4">
                    <dt class="font-serif text-xl text-brand-black">Color natural del cabello</dt>
                    <dd class="text-neutral-700 mt-1">Indica si tu tono natural es claro u oscuro.</dd>
                </div>
            </dl>
            <p class="mt-8 border-l-2 border-brand-primary pl-5 text-neutral-700 leading-relaxed">
                El resultado es un punto de partida para probar colores. Si quieres un informe personalizado
                o comparar textiles durante una sesión, consulta el
                <a href="/servicios/colorimetria-bogota/" class="text-brand-primary underline underline-offset-4">estudio de colorimetría personal</a>.
            </p>
        </div>
    </section>
</MainLayout>
