---
import MainLayout from "@/layouts/MainLayout.astro";


const seoData = {
    title: "Página no encontrada | Roger Murillo",
    description:
        "Lo sentimos, la página que buscas no existe. Regresa al inicio o explora nuestras herramientas de imagen.",
    h1: "404: Estilo no Encontrado",
};
---

<MainLayout title={seoData.title} description={seoData.description} noindex navbarTheme="light">
    <section class="py-32 px-6 text-center bg-[#fafaf9]">
        <div class="max-w-2xl mx-auto">
            <h1 class="text-6xl md:text-8xl font-serif text-[#d4af37] mb-6">
                404
            </h1>
            <h2 class="text-3xl text-[#0c0a09] font-serif mb-6">
                Parece que te has perdido en el armario.
            </h2>
            <p class="text-xl text-stone-600 mb-12">
                La página que buscas no existe o ha sido movida. Pero ya que
                estás aquí, ¿por qué no aprovechas para descubrir tu perfil de
                imagen?
            </p>

            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="/servicios/" class="bg-brand-black text-white px-6 py-4">Explorar servicios</a>
                <a href="/contacto/" class="border border-brand-black px-6 py-4">Consultar con el estudio</a>
                <a href="/herramientas/" class="border border-brand-black px-6 py-4">Ver herramientas gratuitas</a>
            </div>
        </div>
    </section>
</MainLayout>

<script is:inline>
if (typeof gtag === 'function') gtag('event', 'pagina_no_encontrada', {ruta: location.pathname});
</script>
