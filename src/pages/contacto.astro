---
import MainLayout from "../layouts/MainLayout.astro";

const contactSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ContactPage",
            "@id": "https://rogermurillo.co/contacto/#contactpage",
            name: "Contacto · Roger Murillo Asesoría de Imagen",
            about: { "@id": "https://rogermurillo.co/#organization" },
        },
        {
            "@type": "FAQPage",
            "@id": "https://rogermurillo.co/contacto/#faq",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "¿Enviar el formulario reserva una cita?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "No. Primero te contactamos para confirmar el servicio, las condiciones y la disponibilidad. La reserva se coordina después.",
                    },
                },
                {
                    "@type": "Question",
                    name: "¿Necesito saber qué servicio contratar?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: 'No. Puedes elegir «Aún no lo sé» y contarnos qué buscas. El equipo te orientará sobre las opciones.',
                    },
                },
                {
                    "@type": "Question",
                    name: "¿Cómo funciona el informe digital de colorimetría?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Te indicamos por WhatsApp cómo tomar las fotografías y revisamos que sean adecuadas antes de realizar el análisis y preparar tu informe personal.",
                    },
                },
                {
                    "@type": "Question",
                    name: "¿Atienden fuera de Bogotá?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "La colorimetría presencial y la peluquería se realizan en el estudio. El fondo de armario incluye visita a domicilio y acompañamiento de compras; consulta cobertura y condiciones. También puedes consultar por el informe digital de colorimetría.",
                    },
                },
            ],
        },
    ],
};
---

<MainLayout
    title="Contacto y citas en Bogotá | Roger Murillo"
    description="Agenda tu consultoría de imagen personal o ejecutiva en Bogotá. Estudio privado a puerta cerrada. Atención 1 a 1 con Roger Murillo y Adriana Garzón."
    schema={contactSchema}
    navbarTheme="light"
>
    <section class="contact-cover"><div><span class="contact-kicker">CONVERSEMOS / ROGER MURILLO</span><h1>Tu próximo cambio.<br/><em>Empecemos por ti.</em></h1><p>Cabello, color o vestuario. Cuéntanos qué necesitas y acordamos contigo el siguiente paso.</p><a href="#form">Preparar mi consulta <span aria-hidden="true">↘</span></a></div><aside><span class="contact-orbit" aria-hidden="true">RM<span>↗</span></span><p>Una consulta.<br/><em>Un camino propio.</em></p><small>ATENCIÓN CON CITA PREVIA · BOGOTÁ</small></aside></section>
    <!-- FORM -->
    <section id="form" class="contact-form-section relative bg-white overflow-hidden">
        <span class="absolute -right-10 top-10 font-serif italic text-[22vw] leading-[0.8] text-neutral-50 select-none pointer-events-none">Agenda</span>

        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="grid lg:grid-cols-12 gap-16">
                <div class="lg:col-span-4 lg:pr-8">
                    <p class="text-[10px] tracking-[0.4em] uppercase text-brand-primary mb-6">TU CONSULTA · 3 PASOS</p>
                    <h2 class="font-serif text-5xl md:text-6xl leading-[0.95] text-brand-black mb-10">
                        Hablemos de <span class="italic text-brand-primary">tu idea.</span>
                    </h2>
                    <p class="text-base text-neutral-500 font-light leading-relaxed mb-10">
                        Cuéntanos qué buscas. Te contactaremos para confirmar el alcance, la disponibilidad y cómo reservar.
                    </p>
                    <p id="course-inquiry" class="hidden inquiry-context" role="status">
                        Solicitas información del curso de colorimetría profesional. Te contactaremos para compartir los detalles y la disponibilidad; este envío no reserva una plaza.
                    </p>

                    <div class="space-y-4 border-t border-neutral-200 pt-8">
                        <div class="flex items-center gap-4 step-indicator" data-step="1">
                            <span class="w-10 h-10 border border-neutral-300 rounded-full flex items-center justify-center font-serif italic text-sm step-circle">01</span>
                            <span class="text-[11px] tracking-[0.25em] uppercase text-neutral-500 step-label">Sobre ti</span>
                        </div>
                        <div class="flex items-center gap-4 step-indicator" data-step="2">
                            <span class="w-10 h-10 border border-neutral-300 rounded-full flex items-center justify-center font-serif italic text-sm step-circle">02</span>
                            <span class="text-[11px] tracking-[0.25em] uppercase text-neutral-500 step-label">Tu objetivo</span>
                        </div>
                        <div class="flex items-center gap-4 step-indicator" data-step="3">
                            <span class="w-10 h-10 border border-neutral-300 rounded-full flex items-center justify-center font-serif italic text-sm step-circle">03</span>
                            <span class="text-[11px] tracking-[0.25em] uppercase text-neutral-500 step-label">Confirmar</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8">
                    <form id="rm-form" class="relative" name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
                        <input type="hidden" name="form-name" value="contacto" />
                        <p class="hidden" aria-hidden="true"><label>No llenar: <input name="bot-field" /></label></p>
                        <input type="hidden" name="objetivos" id="f-goals-hidden" />
                        <input type="hidden" name="horario" id="f-slot-hidden" />
                        <input type="hidden" name="pagina_entrada" id="f-entry-hidden" />
                        <input type="hidden" name="referente" id="f-referrer-hidden" />
                        <input type="hidden" name="interes_origen" id="f-interest-hidden" />
                        <!-- STEP 1 -->
                        <div class="form-step" data-step="1">
                            <p tabindex="-1" class="form-step-heading text-[10px] tracking-[0.3em] uppercase text-neutral-400 mb-8">Paso 01 &mdash; Sobre ti</p>
                            <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
                                <div class="rm-field">
                                    <input type="text" id="f-name" name="nombre" placeholder=" " autocomplete="name" required/>
                                    <label for="f-name">Nombre completo *</label>
                                </div>
                                <div class="rm-field">
                                    <input type="email" id="f-email" name="email" placeholder=" " autocomplete="email" required/>
                                    <label for="f-email">Correo electrónico *</label>
                                </div>
                                <div class="rm-field">
                                    <input type="tel" id="f-phone" name="telefono" placeholder=" " autocomplete="tel"/>
                                    <label for="f-phone">WhatsApp (opcional)</label>
                                </div>
                                <div class="rm-field"><input type="text" id="f-city" name="ciudad" placeholder=" " autocomplete="address-level2"/><label for="f-city">Ciudad (opcional)</label></div>
                            </div>
                            <div class="flex justify-end mt-14">
                                <button type="button" class="next-btn inline-flex items-center gap-4 bg-brand-black text-white px-10 py-5 text-[11px] tracking-[0.25em] uppercase hover:bg-brand-primary transition-colors duration-500" data-to="2">
                                    Continuar
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- STEP 2 -->
                        <div class="form-step hidden" data-step="2">
                            <p tabindex="-1" class="form-step-heading text-[10px] tracking-[0.3em] uppercase text-neutral-400 mb-8">Paso 02 &mdash; Tu objetivo</p>
                            <p class="text-[11px] tracking-[0.25em] uppercase text-brand-black mb-5">¿Qué te trae a la firma?</p><p class="selection-help">Puedes elegir más de una opción o marcar «Aún no lo sé».</p>
                            <div class="grid md:grid-cols-2 gap-3 mb-10" id="goals">
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors"><input type="checkbox" class="sr-only" value="Colorimetría digital"/> Colorimetría digital</label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors"><input type="checkbox" class="sr-only" value="Colorimetría presencial"/> Colorimetría presencial</label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Fondo de armario y personal shopper"/> Fondo de armario y personal shopper
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Curso de colorimetría profesional"/> Curso de colorimetría profesional
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Asesoría integral"/> Asesoría integral
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Curso de automaquillaje"/> Curso de automaquillaje
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Imagen ejecutiva"/> Imagen ejecutiva
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Colorimetría"/> Colorimetría
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Visagismo y corte"/> Visagismo y corte
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Transición personal"/> Transición personal
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Peluquería"/> Peluquería
                                </label>
                                <label class="goal-chip cursor-pointer border border-neutral-200 px-5 py-4 text-sm hover:border-brand-black transition-colors">
                                    <input type="checkbox" class="sr-only" value="Otro"/> Aún no lo sé
                                </label>
                            </div>
                            <div class="rm-field">
                                <textarea id="f-context" name="contexto" placeholder=" " rows="4"></textarea>
                                <label for="f-context">Contexto (opcional)</label>
                            </div>
                            <div class="flex justify-between mt-14">
                                <button type="button" class="prev-btn text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-black transition-colors" data-to="1">← Volver</button>
                                <button type="button" class="next-btn inline-flex items-center gap-4 bg-brand-black text-white px-10 py-5 text-[11px] tracking-[0.25em] uppercase hover:bg-brand-primary transition-colors duration-500" data-to="3">
                                    Continuar
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- STEP 3 -->
                        <div class="form-step hidden" data-step="3">
                            <p tabindex="-1" class="form-step-heading text-[10px] tracking-[0.3em] uppercase text-neutral-400 mb-8">Paso 03 &mdash; Confirmar tu consulta</p>
                            <p class="text-[11px] tracking-[0.25em] uppercase text-brand-black mb-5">¿Cuándo prefieres que te contactemos?</p><p class="selection-help">Opcional. Es una preferencia de contacto; la cita se acuerda después.</p>
                            <div class="grid grid-cols-3 md:grid-cols-4 gap-2 mb-10" id="slots">
                                <button type="button" class="time-slot border border-neutral-200 py-3 text-[11px] tracking-[0.2em] uppercase">Mañana</button>
                                <button type="button" class="time-slot border border-neutral-200 py-3 text-[11px] tracking-[0.2em] uppercase">Mediodía</button>
                                <button type="button" class="time-slot border border-neutral-200 py-3 text-[11px] tracking-[0.2em] uppercase">Tarde</button>
                                <button type="button" class="time-slot border border-neutral-200 py-3 text-[11px] tracking-[0.2em] uppercase">Sin preferencia</button>
                            </div>
                            <div class="rm-field">
                                <input type="text" id="f-date" name="fecha_tentativa" placeholder=" "/>
                                <label for="f-date">¿Tienes una fecha en mente? (opcional)</label>
                            </div>
                            <label class="flex items-start gap-3 mt-8 text-sm text-neutral-500 font-light cursor-pointer">
                                <input type="checkbox" class="mt-1.5" id="f-terms" name="consentimiento" value="aceptado" required/>
                                <span>Acepto que mi información se use para responder esta consulta y coordinar el servicio o curso solicitado. <a href="/legales/privacidad/" class="privacy-link">Política de privacidad</a>.</span>
                            </label>
                            <div class="flex justify-between mt-14">
                                <button type="button" class="prev-btn text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-black transition-colors" data-to="2">← Volver</button>
                                <button type="submit" class="inline-flex items-center gap-4 bg-brand-primary text-white px-10 py-5 text-[11px] tracking-[0.25em] uppercase hover:bg-brand-black transition-colors duration-500">
                                    Enviar solicitud
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        </div>

                        <p id="form-error" class="form-error hidden" role="alert"></p><p class="form-assurance">Enviar esta consulta no confirma una cita ni realiza un cobro.</p><!-- SUCCESS -->
                        <div class="form-step hidden text-center py-16" data-step="4" role="status" tabindex="-1">
                            <div class="inline-flex w-20 h-20 rounded-full bg-brand-primary items-center justify-center mb-10">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                            <h3 class="font-serif text-4xl md:text-5xl text-brand-black mb-6">Recibimos tu solicitud.</h3>
                            <p id="form-success-message" class="text-lg text-neutral-500 font-light leading-relaxed max-w-md mx-auto">
                                Te contactaremos para confirmar el alcance, la disponibilidad y los pasos para reservar.
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="contact-next"><div><span class="contact-kicker">DESPUÉS DE ENVIAR</span><h2>Así seguimos<br/><em>la conversación.</em></h2></div><ol><li><b>01</b><div><h3>Revisamos tu consulta.</h3><p>El servicio elegido y lo que nos cuentes orientan la conversación.</p></div></li><li><b>02</b><div><h3>Acordamos los detalles.</h3><p>Te contactamos para confirmar alcance, precio, modalidad y disponibilidad.</p></div></li><li><b>03</b><div><h3>Coordinamos la reserva.</h3><p>Con las condiciones claras, acordamos cómo continuar.</p></div></li></ol><div class="contact-direct"><p>¿Prefieres escribir directamente?</p><a href="https://wa.me/573214189010" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a href="mailto:contacto@rogermurillo.co">Correo ↗</a></div></section>
    <!-- LOCATION -->
    <section class="relative bg-brand-black text-white py-32 md:py-48 overflow-hidden">
        <div class="container mx-auto px-6 max-w-7xl">
            <div class="grid lg:grid-cols-12 gap-16 items-end mb-16">
                <div class="lg:col-span-7">
                    <p class="text-[10px] tracking-[0.4em] uppercase text-brand-primary mb-6">El estudio</p>
                    <h2 class="font-serif text-5xl md:text-7xl leading-[0.95]">
                        Al norte de<br/><span class="italic text-neutral-500">Bogotá.</span>
                    </h2>
                </div>
                <div class="lg:col-span-5">
                    <p class="text-lg text-neutral-400 font-light leading-relaxed">
                        Atención con cita previa. Confirma el lugar y la modalidad de tu servicio antes de desplazarte.
                    </p>
                </div>
            </div>

            <div class="grid lg:grid-cols-12 gap-px bg-neutral-800">
                <div class="lg:col-span-8 bg-brand-black h-[500px] relative ph-studio">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.1440236850794!2d-74.06593672418667!3d4.745016041270061!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3f850847721223%3A0x836e954dff5dd886!2sROGER%20MURILLO%20IMAGE%20ADVISORS!5e0!3m2!1sen!2sco!4v1777071797708!5m2!1sen!2sco"
                        title="Ubicación del estudio Roger Murillo en Bogotá" width="100%" height="100%"
                        style="border:0; filter: grayscale(100%) invert(90%) contrast(83%);"
                        allowfullscreen=""
                        loading="lazy"
                    ></iframe>
                    <span class="absolute top-6 left-6 text-[10px] tracking-[0.3em] uppercase text-neutral-500 bg-black/40 backdrop-blur px-3 py-1.5 z-10">Colina Campestre</span>
                </div>
                <div class="lg:col-span-4 bg-brand-black p-10 space-y-10">
                    <div>
                        <p class="text-[10px] tracking-[0.3em] uppercase text-neutral-500 mb-3">Dirección</p>
                        <p class="font-serif text-2xl leading-tight">Calle 163 B No. 48-80<br/>Local 208</p>
                        <p class="text-sm text-neutral-500 mt-2">Ed. Britalia Comercial y Empresarial &middot; Bogotá</p>
                    </div>
                    <div class="border-t border-neutral-800 pt-8">
                        <p class="text-[10px] tracking-[0.3em] uppercase text-neutral-500 mb-3">Horario</p>
                        <p class="text-sm text-neutral-300 leading-relaxed">Lunes &mdash; Sábado<br/><span class="text-white">09:00 &mdash; 19:00</span></p>
                    </div>
                    <div class="border-t border-neutral-800 pt-8">
                        <a href="https://maps.google.com/?q=Roger+Murillo+Image+Advisors+Bogota" target="_blank" class="inline-flex items-center gap-3 text-[11px] tracking-[0.25em] uppercase hover:text-brand-primary transition-colors">
                            Abrir en Maps
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 17L17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="relative bg-white py-32 md:py-40">
        <div class="container mx-auto px-6 max-w-4xl">
            <p class="text-[10px] tracking-[0.4em] uppercase text-brand-primary mb-6 text-center">Dudas frecuentes</p>
            <h2 class="font-serif text-5xl md:text-6xl leading-[0.95] text-brand-black mb-16 text-center">Antes de <span class="italic text-neutral-400">escribirnos.</span></h2>

            <div class="divide-y divide-neutral-200 border-t border-b border-neutral-200">
                <details class="group py-8 cursor-pointer">
                    <summary class="flex justify-between items-start list-none gap-6">
                        <span class="font-serif text-2xl text-brand-black leading-tight">¿Enviar el formulario reserva una cita?</span>
                        <span class="text-neutral-300 group-open:rotate-45 transition-transform text-3xl leading-none shrink-0">+</span>
                    </summary>
                    <p class="text-base text-neutral-500 font-light leading-relaxed mt-6 max-w-2xl">
                        No. Primero te contactamos para confirmar el servicio, las condiciones y la disponibilidad. La reserva se coordina después.
                    </p>
                </details>
                <details class="group py-8 cursor-pointer">
                    <summary class="flex justify-between items-start list-none gap-6">
                        <span class="font-serif text-2xl text-brand-black leading-tight">¿Necesito saber qué servicio contratar?</span>
                        <span class="text-neutral-300 group-open:rotate-45 transition-transform text-3xl leading-none shrink-0">+</span>
                    </summary>
                    <p class="text-base text-neutral-500 font-light leading-relaxed mt-6 max-w-2xl">
                        No. Puedes elegir «Aún no lo sé» y contarnos qué buscas. El equipo te orientará sobre las opciones.
                    </p>
                </details>
                <details class="group py-8 cursor-pointer">
                    <summary class="flex justify-between items-start list-none gap-6">
                        <span class="font-serif text-2xl text-brand-black leading-tight">¿Cómo funciona el informe digital de colorimetría?</span>
                        <span class="text-neutral-300 group-open:rotate-45 transition-transform text-3xl leading-none shrink-0">+</span>
                    </summary>
                    <p class="text-base text-neutral-500 font-light leading-relaxed mt-6 max-w-2xl">
                        Te indicamos por WhatsApp cómo tomar las fotografías y revisamos que sean adecuadas antes de realizar el análisis y preparar tu informe personal.
                    </p>
                </details>
                <details class="group py-8 cursor-pointer">
                    <summary class="flex justify-between items-start list-none gap-6">
                        <span class="font-serif text-2xl text-brand-black leading-tight">¿Atienden fuera de Bogotá?</span>
                        <span class="text-neutral-300 group-open:rotate-45 transition-transform text-3xl leading-none shrink-0">+</span>
                    </summary>
                    <p class="text-base text-neutral-500 font-light leading-relaxed mt-6 max-w-2xl">
                        La colorimetría presencial y la peluquería se realizan en el estudio. El fondo de armario incluye visita a domicilio y acompañamiento de compras; consulta cobertura y condiciones. También puedes consultar por el informe digital de colorimetría.
                    </p>
                </details>
            </div>
        </div>
    </section>
</MainLayout>

<style>
