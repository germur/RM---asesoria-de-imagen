<script is:inline>
    const form = document.getElementById('rm-form');
    let currentStep = 1;
    let started = false;
    let submitting = false;
    let submitted = false;
    const interests = {
        'curso-colorimetria-profesional': 'Curso de colorimetría profesional',
        'automaquillaje': 'Curso de automaquillaje',
        'integral': 'Asesoría integral',
        'peluqueria': 'Peluquería',
        'ejecutiva': 'Imagen ejecutiva',
        'colorimetria': 'Colorimetría',
        'colorimetria-digital': 'Colorimetría digital',
        'colorimetria-presencial': 'Colorimetría presencial',
        'fondo-armario': 'Fondo de armario y personal shopper',
        'visagismo': 'Visagismo y corte',
    };
    const interest = new URLSearchParams(location.search).get('interes');
    const selectedInterest = Object.hasOwn(interests, interest) ? interests[interest] : null;
    const isCourseInquiry = selectedInterest?.startsWith('Curso ');
    const getRequestType = () => {
        const selected = Array.from(document.querySelectorAll('#goals input:checked')).map(input => input.value);
        const hasCourse = selected.some(value => value.startsWith('Curso '));
        const hasService = selected.some(value => !value.startsWith('Curso '));
        return hasCourse ? (hasService ? 'mixta' : 'curso') : 'servicio';
    };
    const trackForm = (event, params = {}) => {
        if (typeof gtag === 'function') {
            gtag('event', event, { form_id: 'rm-form', tipo_solicitud: getRequestType(), ...params });
        }
    };
    const validateStep = (n) => {
        const invalid = Array.from(document.querySelectorAll(`.form-step[data-step="${n}"] input,.form-step[data-step="${n}"] select,.form-step[data-step="${n}"] textarea`))
            .find(field => !field.checkValidity());
        if (invalid) {
            goTo(n);
            invalid.reportValidity();
            return false;
        }
        return true;
    };
    const steps = document.querySelectorAll('.form-step');
    const indicators = document.querySelectorAll('.step-indicator');
    const goTo = (n) => {
        currentStep = n;
        steps.forEach(s => s.classList.toggle('hidden', s.dataset.step !== String(n)));
        indicators.forEach(i => {
            const step = Number(i.dataset.step);
            const circle = i.querySelector('.step-circle');
            const label = i.querySelector('.step-label');
            if (step < n) {
                circle.style.background = '#0a0a0a'; circle.style.color = '#fff'; circle.style.borderColor = '#0a0a0a';
                label.style.color = '#0a0a0a';
            } else if (step === n) {
                circle.style.background = '#C41230'; circle.style.color = '#fff'; circle.style.borderColor = '#C41230';
                label.style.color = '#C41230';
            } else {
                circle.style.background = 'transparent'; circle.style.color = '#9a9a9a'; circle.style.borderColor = '#e5e5e5';
                label.style.color = '#9a9a9a';
            }
        });
    };
    document.querySelectorAll('.next-btn,.prev-btn').forEach(b =>
        b.addEventListener('click', () => {
            const destino = Number(b.dataset.to);
            if (b.classList.contains('next-btn') && !validateStep(currentStep)) return;
            // Embudo del formulario: permite ver en que paso abandonan
            if (b.classList.contains('next-btn')) {
                trackForm('form_contacto_paso', { paso: destino });
            }
            goTo(destino);
            document.querySelector(`.form-step[data-step="${destino}"] .form-step-heading`)?.focus();
        })
    );
    goTo(1);

    document.querySelectorAll('.goal-chip').forEach(chip => {
        const inp = chip.querySelector('input');
        inp.classList.remove('hidden');
        inp.classList.add('sr-only');
        const updateChip = () => {
            chip.style.background = inp.checked ? '#0a0a0a' : '';
            chip.style.color = inp.checked ? '#fff' : '';
            chip.style.borderColor = inp.checked ? '#0a0a0a' : '';
        };
        if (selectedInterest && inp.value === selectedInterest) inp.checked = true;
        inp.addEventListener('change', updateChip);
        updateChip();
    });
    if (selectedInterest) {
        const notice = document.getElementById('course-inquiry');
        notice.textContent = `Tu consulta: ${selectedInterest}. Puedes cambiarla en el paso 2.`;
        notice.classList.remove('hidden');
    }
    document.getElementById('f-interest-hidden').value = selectedInterest || '';
    try {
        const attribution = JSON.parse(sessionStorage.getItem('rm_entry_context') || '{}');
        document.getElementById('f-entry-hidden').value = attribution.entry || location.pathname;
        document.getElementById('f-referrer-hidden').value = attribution.referrer || '';
    } catch { /* El formulario sigue funcionando con almacenamiento bloqueado. */ }

    document.querySelectorAll('#slots .time-slot').forEach(s => {
        s.addEventListener('click', () => {
            document.querySelectorAll('#slots .time-slot').forEach(x => x.classList.remove('selected'));
            s.classList.add('selected');
        });
    });

    if (form) {
        form.addEventListener('input', () => {
            if (started) return;
            started = true;
            trackForm('form_contacto_inicio');
        });
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitting || submitted) return;
            for (const n of [1, 2, 3]) {
                if (!validateStep(n)) return;
            }
            submitting = true;
            document.getElementById('form-error')?.classList.add('hidden');

            // Recolectar chips de objetivos y horario en los campos ocultos
            const goals = Array.from(document.querySelectorAll('#goals input:checked')).map(i => i.value);
            document.getElementById('f-goals-hidden').value = goals.join(', ');
            const slot = document.querySelector('#slots .time-slot.selected');
            document.getElementById('f-slot-hidden').value = slot ? slot.textContent.trim() : '';

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Enviando…';

            try {
                const data = new URLSearchParams(new FormData(form));
                const res = await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: data.toString(),
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                submitted = true;
                if (getRequestType() === 'curso') {
                    document.getElementById('form-success-message').textContent = 'Recibimos tu consulta. Te contactaremos para compartir los detalles y la disponibilidad del curso.';
                } else {
                    document.getElementById('form-success-message').textContent = 'Recibimos tu solicitud. Te contactaremos para confirmar el servicio, su disponibilidad y los pasos para reservar.';
                }
                // Evento clave: solicitud de consultoria enviada con exito
                trackForm('form_contacto_enviado', {
                        objetivos: document.getElementById('f-goals-hidden').value,
                        horario: document.getElementById('f-slot-hidden').value,
                });
                goTo(4);
                document.querySelector('.form-step[data-step="4"]')?.focus();
            } catch (err) {
                submitting = false;
                trackForm('form_contacto_error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                const error = document.getElementById('form-error');
                if (error) { error.textContent = 'No se pudo enviar. Conservamos tus respuestas: intenta de nuevo o escríbenos por WhatsApp al +57 321 418 9010.'; error.classList.remove('hidden'); }
            }
        });
    }
</script>
