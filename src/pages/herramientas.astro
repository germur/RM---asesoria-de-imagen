const tools = [{"href": "/herramientas/test-colorimetria-online/", "title": "Test de colorimetría", "description": "Explora tus preferencias y obtén una primera orientación de estación. No sustituye el análisis personal de color.", "meta": "Cuestionario / Sin registro", "category": "Color", "motif": "color"}, {"href": "/herramientas/calculadora-rostro/", "title": "Calculadora de rostro", "description": "Compara proporciones como punto de partida para conversar sobre corte, barba o gafas.", "meta": "Medidas / Orientación inicial", "category": "Forma", "motif": "face"}, {"href": "/herramientas/calculadora-tipo-cuerpo/", "title": "Calculadora de cuerpo", "description": "Explora relaciones entre tus medidas y conoce las categorías de silueta como guía para el vestuario.", "meta": "Medidas / Morfología", "category": "Forma", "motif": "body"}, {"href": "/herramientas/test-impacto-ejecutivo/", "title": "Test de impacto ejecutivo", "description": "Reflexiona sobre tu vestuario y presencia en el contexto profesional. Una autoevaluación para reconocer prioridades.", "meta": "Autoevaluación / Contexto profesional", "category": "Imagen", "motif": "voice"}, {"href": "/herramientas/reto-revoluciona-tu-imagen/", "title": "Revoluciona tu imagen", "description": "Un recorrido de ejercicios para observar tu identidad, tus elecciones y la imagen que quieres construir.", "meta": "Ejercicios / Reflexión personal", "category": "Imagen", "motif": "identity"}];
---
<MainLayout title="Herramientas Gratuitas de Imagen Personal | Roger Murillo" description="Explora colorimetría, proporciones del rostro, silueta e imagen profesional con herramientas gratuitas y orientativas." navbarTheme="light" breadcrumbsInFlow>
 <EditorialHero eyebrow="Laboratorio / Herramientas gratuitas" title="Empieza por observar." emphasis="Descubre qué explorar." description="Cinco formas de acercarte al color, las proporciones y tu estilo. Sin registro: una orientación para hacer mejores preguntas, no un diagnóstico definitivo." href="#herramientas" action="Elegir mi herramienta" />
