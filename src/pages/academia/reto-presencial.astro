---
import MainLayout from "@/layouts/MainLayout.astro";
import { ArrowRight } from "lucide-react";

const seoData = {
    title: "Reto Revoluciona Tu Imagen · 9 Clases Presenciales | Roger Murillo",
    description:
        "Programa presencial de 9 meses para construir una identidad consciente. Grupos íntimos de máximo 10 personas. Incluye libro oficial, coaching privado y comunidad exclusiva.",
};

const clases = [
    { n: "01", emoji: "🎞", title: "El Guion", sub: "Tu Identidad", desc: "Dejamos el piloto automático y entramos a la sala creativa para definir tus valores, tus metas y el personaje que vas a interpretar con éxito los próximos 10 años." },
    { n: "02", emoji: "🏠", title: "El Set de Rodaje", sub: "Tu Cuerpo", desc: "Te enseñamos a recuperar las llaves de tu propia casa. Entenderás que tu cuerpo es el escenario principal de tu película y aprenderás a habitarlo con presencia y seguridad." },
    { n: "03", emoji: "🧵", title: "La Segunda Piel", sub: "Los Textiles", desc: "Aprenderás el lenguaje de las texturas, las caídas y los tejidos para darle vida, confort y dinamismo a las diferentes locaciones y roles de tu día a día." },
    { n: "04", emoji: "🎨", title: "De Cine Mudo a Color", sub: "Colorimetría", desc: "Aprenderás la psicología del color y su correcta combinación para eliminar la invisibilidad y destacar tus mayores cualidades usando la paleta exacta que empodera tu mensaje." },
    { n: "05", emoji: "🎭", title: "El Género de tu Película", sub: "Los Estilos", desc: "Identifica tu verdadera esencia para que dejes de ser una copia de las tendencias. Aprenderás a contar tu propia historia a través de lo que vistes." },
    { n: "06", emoji: "🌟", title: "Premio Óscar", sub: "Puntos Focales", desc: "Te enseñamos la estrategia visual para dirigir la mirada de los demás exactamente hacia donde tú quieres, resaltando tus mayores cualidades." },
    { n: "07", emoji: "📍", title: "Cambio de Locación", sub: "Ocasión de Uso", desc: "El arte del 'saber estar'. Descubrirás cómo adaptarte a los códigos de etiqueta del mundo real y corporativo sin perder tu identidad." },
    { n: "08", emoji: "👜", title: "La Utilería", sub: "Accesorios", desc: "Aprenderás a combinar estratégicamente zapatos, carteras y joyas para darle el toque de finura, elegancia y contemporaneidad que eleva cualquier producción." },
    { n: "09", emoji: "🥂", title: "La Alfombra Roja", sub: "El Estreno", desc: "Sella tu transformación. Clase de pasarela y proyección frente a la cámara. El momento de firmar tu nueva historia." },
];
---

<MainLayout title={seoData.title} description={seoData.description}>

    <style>
        .reveal{opacity:0;transform:translateY(36px);transition:opacity 1s cubic-bezier(.16,1,.3,1) var(--delay,0s),transform 1s cubic-bezier(.16,1,.3,1) var(--delay,0s)}
        .reveal.is-in{opacity:1;transform:translateY(0)}
        .clase-card{border-left:2px solid transparent;transition:border-color .4s, background .4s}
        .clase-card:hover{border-left-color:#C41230;background:rgba(196,18,48,.03)}
    </style>

    <!-- HERO -->
    <section class="pt-40 pb-32 md:pt-48 md:pb-40 bg-brand-black text-white relative overflow-hidden">
        <span class="absolute -right-[8%] top-[10%] font-serif italic text-[30vw] leading-none text-white/[0.03] pointer-events-none select-none">🎬</span>
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="flex items-center gap-5 mb-14">
                <span class="w-12 h-px bg-brand-primary"></span>
                <p class="text-[10px] tracking-[0.4em] uppercase text-white/60">Academia · Presencial</p>
            </div>
            <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[0.88] mb-8">
                Reto Revoluciona<br/><span class="italic text-brand-primary">Tu Imagen.</span>
            </h1>
            <p class="text-lg text-white/60 font-light leading-relaxed max-w-2xl mb-6">
                La vida como una película y tú como su protagonista. Un programa de 9 meses que va mucho más allá de la moda, diseñado para construir una identidad consciente que empodera tu singularidad, seguridad y presencia.
            </p>
            <p class="text-base text-white/40 font-light italic border-l-2 border-brand-primary pl-6 max-w-xl mb-12">
                "La imagen personal no comienza en la ropa. Comienza en la identidad."
            </p>
            <div class="flex flex-col sm:flex-row gap-5">
                <a href="/contacto" class="inline-flex items-center gap-3 bg-brand-primary text-white px-10 py-4 text-[11px] font-medium uppercase tracking-[0.25em] hover:bg-white hover:text-brand-black transition-colors duration-500">
                    Inscribirme <ArrowRight className="w-3.5 h-3.5" />
                </a>
            </div>
        </div>
    </section>

    <!-- POR QUÉ PRESENCIAL -->
    <section class="py-24 md:py-32 bg-neutral-50">
        <div class="container mx-auto px-6 max-w-4xl text-center">
            <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-6">¿Por qué presencial?</p>
            <h2 class="font-serif text-3xl md:text-5xl leading-[1.05] text-brand-black mb-8">
                Los cursos virtuales ya no nos transforman igual.
            </h2>
            <p class="text-lg text-neutral-500 font-light leading-relaxed max-w-2xl mx-auto mb-6">
                Mientras escuchas una clase estás respondiendo correos, revisando el celular, y al final terminas sin interiorizar nada. El Reto rompe con el molde virtual y te invita a regresar a la interacción real, al debate, a nutrirte de las experiencias de otras personas frente a frente.
            </p>
            <p class="text-base text-neutral-600 font-medium">
                2 horas, una vez al mes. 9 meses = 9 clases. El tiempo perfecto de gestación para dar a luz a tu nueva versión.
            </p>
        </div>
    </section>

    <!-- LAS 9 CLASES -->
    <section class="py-28 md:py-40 bg-white">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="max-w-xl mb-20">
                <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-6">Las 9 clases</p>
                <h2 class="font-serif text-4xl md:text-5xl leading-[1.05] text-brand-black">
                    Tu guion, escena<br/><span class="italic text-neutral-400">por escena.</span>
                </h2>
            </div>
            <div class="space-y-0">
                {clases.map((c, i) => (
                    <div class="clase-card grid md:grid-cols-12 gap-6 py-8 px-6 border-t border-neutral-200 reveal" style={`--delay:${i * 0.05}s`}>
                        <div class="md:col-span-1">
                            <span class="font-serif text-3xl italic text-brand-primary">{c.n}</span>
                        </div>
                        <div class="md:col-span-1">
                            <span class="text-2xl">{c.emoji}</span>
                        </div>
                        <div class="md:col-span-3">
                            <p class="font-serif text-xl text-brand-black">{c.title}</p>
                            <p class="text-[10px] tracking-[0.2em] uppercase text-neutral-400 mt-1">{c.sub}</p>
                        </div>
                        <div class="md:col-span-7">
                            <p class="text-sm text-neutral-600 font-light leading-relaxed">{c.desc}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- FORMATO -->
    <section class="py-28 md:py-32 bg-neutral-50">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="grid md:grid-cols-3 gap-12">
                <div class="reveal">
                    <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-4">Formato</p>
                    <h3 class="font-serif text-2xl text-brand-black mb-4">Grupos íntimos</h3>
                    <p class="text-sm text-neutral-500 font-light leading-relaxed">Máximo 10 personas. De 7:00 pm a 9:00 pm, acompañados de una buena copa de vino, en un ambiente seguro donde puedes compartir, debatir y redescubrirte.</p>
                </div>
                <div class="reveal" style="--delay:.1s">
                    <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-4">Frecuencia</p>
                    <h3 class="font-serif text-2xl text-brand-black mb-4">Una vez al mes</h3>
                    <p class="text-sm text-neutral-500 font-light leading-relaxed">2 horas de desconexión total del celular y la rutina. Un espacio para regalarte tiempo de calidad contigo misma.</p>
                </div>
                <div class="reveal" style="--delay:.2s">
                    <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-4">Ubicación</p>
                    <h3 class="font-serif text-2xl text-brand-black mb-4">Bogotá · Colina Campestre</h3>
                    <p class="text-sm text-neutral-500 font-light leading-relaxed">Estudio privado de Roger Murillo. Un espacio diseñado para pensar, no para posar.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- INVERSIÓN -->
    <section class="py-28 md:py-40 bg-brand-black text-white">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div>
                    <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-8">Inversión</p>
                    <h2 class="font-serif text-5xl md:text-6xl leading-[0.92] mb-8">
                        Dos caminos<br/><span class="italic text-neutral-500">para vivirlo.</span>
                    </h2>
                    <p class="text-white/60 font-light leading-relaxed max-w-md">
                        "No viniste a improvisar tu papel. Viniste a protagonizar tu propia obra maestra."
                    </p>
                </div>
                <div class="space-y-6">
                    <div class="border border-white/15 p-8">
                        <p class="text-[10px] tracking-[0.3em] uppercase text-white/50 mb-3">Opción 1 · Clase individual</p>
                        <p class="font-serif text-4xl mb-2">$100,000 <span class="text-xl text-white/40">COP</span></p>
                        <p class="text-sm text-white/40">Asiste a la clase mensual que más te interese.</p>
                    </div>
                    <div class="border-2 border-brand-primary p-8 relative">
                        <span class="absolute -top-3 right-6 bg-brand-primary text-white text-[9px] tracking-[0.3em] uppercase px-3 py-1">Recomendado</span>
                        <p class="text-[10px] tracking-[0.3em] uppercase text-brand-primary mb-3">Opción 2 · Paquete "Obra Maestra"</p>
                        <p class="font-serif text-4xl mb-4">$800,000 <span class="text-xl text-white/40">COP</span></p>
                        <ul class="space-y-2 text-sm text-white/60 font-light mb-6">
                            <li class="flex items-start gap-2"><span class="text-brand-primary mt-0.5">✓</span> 9 clases presenciales VIP (valor $900,000)</li>
                            <li class="flex items-start gap-2"><span class="text-brand-primary mt-0.5">✓</span> Libro físico "Revoluciona tu Imagen" ($120,000)</li>
                            <li class="flex items-start gap-2"><span class="text-brand-primary mt-0.5">✓</span> 30 min coaching privado 1 a 1 con Roger o Adriana</li>
                            <li class="flex items-start gap-2"><span class="text-brand-primary mt-0.5">✓</span> Grupo privado de WhatsApp exclusivo para tu generación</li>
                        </ul>
                        <a href="/contacto" class="block text-center bg-brand-primary text-white px-8 py-4 text-[11px] tracking-[0.25em] uppercase hover:bg-white hover:text-brand-black transition-colors duration-500">
                            Reservar mi cupo →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-24 md:py-32 bg-white text-center">
        <div class="container mx-auto px-6 max-w-3xl">
            <p class="font-serif italic text-3xl md:text-4xl text-brand-black leading-snug mb-8">
                "No viniste a improvisar tu papel.<br/><span class="text-brand-primary">Viniste a protagonizar tu propia obra maestra."</span>
            </p>
            <a href="/contacto" class="inline-flex items-center gap-3 bg-brand-black text-white px-10 py-4 text-[11px] font-medium uppercase tracking-[0.25em] hover:bg-brand-primary transition-colors duration-500">
                Quiero mi cupo <ArrowRight className="w-3.5 h-3.5" />
            </a>
        </div>
    </section>

    <script>
        const ro = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); ro.unobserve(e.target) } }), { threshold: .15, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
    </script>

</MainLayout>
