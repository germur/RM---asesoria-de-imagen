---
import MainLayout from '@/layouts/MainLayout.astro';
import EditorialHero from '@/components/EditorialHero.astro';
import SeasonAtlas from '@/components/SeasonAtlas.astro';
import reports from '@/data/seasons.json';
---
<MainLayout title="Las 12 Estaciones de Colorimetría | Guía Completa Roger Murillo" description="Explora las doce estaciones de colorimetría: muestras digitales, neutros y combinaciones. Una guía para comparar familias de color sin reglas rígidas." navbarTheme="light" breadcrumbsInFlow>
 <EditorialHero eyebrow="Atlas / Colorimetría personal" title="Doce paletas." emphasis="Muchas formas de llevarlas." description="Temperatura, claridad e intensidad: explora las familias de color y compara sus matices. Empieza por la curiosidad, sin forzarte a una etiqueta." />
 <SeasonAtlas />
 <section class="atlas-continuity"><div><span>Del mapa a tu paleta</span><h2>¿Quieres estudiarlo<br/><em>con nosotros?</em></h2><p>Informe digital por $150.000 COP o sesión presencial en Bogotá por $1.000.000 COP, con informe incluido.</p><a href="/servicios/colorimetria-bogota/">Comparar modalidades de estudio ↗</a></div><div><span>Después del cuestionario</span><h2>Orientaciones<br/><em>por estación.</em></h2><div class="report-links">{reports.map(report=><a href={`/resultados/${report.slug}/`}>{report.title}<span aria-hidden="true">↗</span></a>)}</div></div></section>
 <style>.atlas-continuity{background:#eae9df;padding:60px max(24px,calc((100vw - 1184px)/2));display:grid;grid-template-columns:1fr 1fr;gap:70px}.atlas-continuity>div>span{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#7c7f69;display:block;margin-bottom:22px}.atlas-continuity h2{font:38px/1.1 'Playfair Display',Georgia,serif;color:#34452a;margin-bottom:23px}.atlas-continuity h2 em{color:#8c7859}.atlas-continuity p{font-size:13px;line-height:1.9;color:#747b63;max-width:420px}.atlas-continuity>div>a{display:inline-flex;margin-top:25px;padding:17px 20px;background:#34472d;color:white;font-size:12px}.report-links a{display:flex;justify-content:space-between;gap:20px;font-size:13px;color:#5d6a4e;padding:13px 0;border-bottom:1px solid #cad0b9}.report-links a span{font-size:18px}@media(max-width:650px){.atlas-continuity{grid-template-columns:1fr;gap:40px;padding:40px 24px}}</style>
</MainLayout>
