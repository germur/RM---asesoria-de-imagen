---
import MainLayout from '@/layouts/MainLayout.astro';
import EditorialHero from '@/components/EditorialHero.astro';
import ResourceCatalog from '@/components/ResourceCatalog.astro';
const items = [{"href": "/libro/", "title": "Revoluciona tu Imagen", "description": "El manual fundacional. Físico + digital.", "meta": "$19 USD", "category": "Lecturas", "image": "/images/book-editorial.svg"}, {"href": "/academia/curso-descubrete/", "title": "Descúbrete", "description": "El poder de tu imagen personal.", "meta": "$25 USD", "category": "Cursos online", "image": "/images/course-descubrete.webp"}, {"href": "/academia/crea-tu-iconologia/", "title": "Diseñate", "description": "Crea tu iconología personal.", "meta": "$35 USD", "category": "Cursos online", "image": "/images/course-disenate.webp"}, {"href": "/academia/disena-tu-voz/", "title": "Conquista", "description": "Diseña tu voz y tu mensaje.", "meta": "$40 USD", "category": "Cursos online", "image": "/images/course-conquista.webp"}, {"href": "/academia/el-correcto-uso-del-color/", "title": "Destaca", "description": "El correcto uso del color.", "meta": "$40 USD", "category": "Cursos online", "image": "/images/course-destaca.webp"}, {"href": "/academia/reto-presencial/", "title": "Reto Presencial", "description": "Programa intensivo grupal. Max 10 personas, 7-9pm.", "meta": "$800k COP", "category": "Formación y consulta", "motif": "voice"}, {"href": "/academia/curso-automaquillaje/", "title": "Automaquillaje", "description": "Aprende a maquillarte paso a paso con técnica profesional.", "meta": "$650k COP", "category": "Formación y consulta", "motif": "voice"}, {"href": "/academia/reto-colegios/", "title": "Reto Colegios", "description": "Programa para estudiantes, padres y docentes.", "meta": "Cotizar", "category": "Formación y consulta", "motif": "voice"}, {"href": "/academia/curso-colorimetria-profesional/", "title": "Colorimetría Profesional", "description": "Domina la ciencia del color para ejercer como asesor.", "meta": "Cotizar", "category": "Formación y consulta", "motif": "color"}];
---
<MainLayout title="Academia de Imagen Personal · Cursos Online | Roger Murillo" description="Cursos, lecturas y formación de imagen personal, colorimetría y estilo. Compara los recursos de la academia Roger Murillo." navbarTheme="light" breadcrumbsInFlow>
 <EditorialHero eyebrow="Academia / Imagen personal" title="Aprender a mirar." emphasis="Elegir con criterio." description="Color, estilo y comunicación: encuentra una lectura para empezar, un curso para profundizar o una formación para trabajar con el equipo." image="/images/course-destaca.webp" imageAlt="Fotografía editorial de la academia Roger Murillo" href="#catalogo" action="Explorar la academia" />
 <div id="catalogo" style="scroll-margin-top:125px"><ResourceCatalog items={items} label="Catálogo de la academia" /></div>
 <section class="container mx-auto px-6 py-12 max-w-4xl">
  <h2 class="font-serif text-3xl mb-4">Color para tus reuniones y negociaciones</h2>
  <p class="text-neutral-700 leading-relaxed">Antes de elegir un curso, explora cómo adaptar el color al contexto, las prendas que ya tienes y la iluminación. Nuestra <a class="text-brand-primary underline underline-offset-4" href="/academia/colorimetria/colores-para-negociar/">guía de colores para reuniones y negociaciones</a> te propone combinaciones para probar y conecta con las opciones de formación y asesoría.</p>
 </section>
</MainLayout>
