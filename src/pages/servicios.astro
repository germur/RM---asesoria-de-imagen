---
import ColorPaths from '@/components/ColorPaths.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import ServicesEntry from '@/components/ServicesEntry.astro';
import ServiceRoutes from '@/components/ServiceRoutes.astro';
import RealCases from '@/components/RealCases.astro';
const faqs=[
 {q:'¿Necesito contratar un programa completo?',a:'No. Puedes consultar por colorimetría, fondo de armario con compras o peluquería y visagismo. El programa integral tiene un alcance distinto y se trabaja por fases.'},
 {q:'¿Dónde se realizan los servicios?',a:'Peluquería y colorimetría presencial se realizan en el estudio de Bogotá. El fondo de armario incluye visita a domicilio y compras en Bogotá y alrededores; otras ciudades añaden gastos de desplazamiento. El estudio digital de color se realiza a partir de fotografías.'},
 {q:'¿Cómo confirmo el alcance y el precio?',a:'Consulta la página del servicio y escribe al equipo con tu objetivo. La disponibilidad y las condiciones se confirman antes de reservar. La guía de precios ayuda a comparar qué incluye cada opción.'},
];
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Servicios de asesoría de imagen y peluquería en Bogotá',url:'https://rogermurillo.co/servicios/'};
---
<MainLayout title="Asesoría de Imagen en Bogotá · Colorimetría, Armario y Peluquería | Roger Murillo" description="Compara colorimetría digital y presencial, fondo de armario y personal shopper, peluquería, imagen ejecutiva y asesoría integral en Bogotá." schema={schema} navbarTheme="light" breadcrumbsInFlow>
 <ServicesEntry />
 <div id="elegir-servicio" style="scroll-margin-top:125px"><ServiceRoutes /></div>
 <section class="service-decisions"><div><span>Antes de contratar</span><h2>El alcance importa.<br/><em>Tanto como el precio.</em></h2><p>Una sesión de color no incluye lo mismo que una revisión de armario o un acompañamiento de un año. Mira el proceso, los entregables y las condiciones de cada opción.</p><a href="/blog/cuanto-cuesta-asesoria-imagen-bogota/">Leer la guía de alcance y precios <span aria-hidden="true">↗</span></a></div><div class="service-faqs">{faqs.map(faq=><details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
 <ColorPaths current="hub" />
 <RealCases />
 <style>.service-decisions{max-width:1280px;padding:75px 48px;margin:auto;display:grid;grid-template-columns:.9fr 1.1fr;gap:70px}.service-decisions>div>span{display:block;font-size:9px;letter-spacing:.17em;text-transform:uppercase;color:#626262;margin-bottom:26px}.service-decisions h2{font:40px/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.03em;color:#111111}.service-decisions h2 em{color:#C41230}.service-decisions>div>p{font-size:13px;line-height:1.9;color:#595959;max-width:430px;margin-top:25px}.service-decisions>div>a{display:inline-flex;gap:25px;align-items:center;min-height:48px;border-bottom:1px solid #C41230;font-size:11px;color:#C41230;margin-top:20px}.service-decisions>div>a>span{font-size:20px}.service-faqs details{border-bottom:1px solid #dddddd}.service-faqs summary{padding:24px 0;display:flex;justify-content:space-between;align-items:center;gap:25px;list-style:none;cursor:pointer;color:#111111;font-size:15px}.service-faqs summary::-webkit-details-marker{display:none}.service-faqs summary>span{font-size:25px;color:#C41230}.service-faqs details[open] summary>span{transform:rotate(45deg)}.service-faqs p{font-size:13px;line-height:1.9;color:#595959;padding:0 25px 25px 0}@media(max-width:700px){.service-decisions{padding:45px 24px;grid-template-columns:1fr;gap:30px}.service-decisions h2{font-size:35px}}</style>
</MainLayout>
