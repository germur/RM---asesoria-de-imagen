---
import MainLayout from "@/layouts/MainLayout.astro";
import AnimatedTitleWords from "@/components/ui/AnimatedTitleWords.astro";

const seoData = {
    title: "Asesoría de Imagen Personal en Bogotá · Programa Integral | Roger Murillo",
    description: "Asesoría de imagen personal en Bogotá: 11 fases con visagismo, colorimetría, armario y acompañamiento 1 a 1. Estudio privado, máximo 4 cupos al mes. Conoce el proceso y la inversión.",
};

// FAQ · construida solo con datos que ya estan en esta pagina
const faqs = [
    {
        q: "¿Cuánto cuesta una asesoría de imagen personal?",
        a: "El programa integral tiene una inversión de $1.650 USD (aprox. $6.500.000 COP, sujeto a la TRM del día). Se paga en dos momentos: un abono inicial de $500 USD que da inicio a la Fase I, y el saldo de $1.150 USD al aprobar el informe de diagnóstico.",
    },
    {
        q: "¿Qué incluye la asesoría de imagen integral?",
        a: "Es un programa de 11 fases que cubre diagnóstico de identidad, visagismo, colorimetría, morfología corporal, auditoría y depuración de armario, rutas de compra y acompañamiento personalizado, hasta la entrega del dossier final de imagen.",
    },
    {
        q: "¿Cuánto dura el proceso completo?",
        a: "Es un acompañamiento por fases, no una sesión suelta. El ritmo se ajusta a cada persona y avanza a medida que se completan y aprueban las etapas del proceso, comenzando por el diagnóstico.",
    },
    {
        q: "¿Dónde se realiza la asesoría?",
        a: "En el estudio privado a puerta cerrada en Bogotá: Calle 163 B No. 48-80, Local 208, Edificio Britalia Comercial y Empresarial. La agenda es limitada a un máximo de 4 cupos al mes para garantizar dedicación total.",
    },
    {
        q: "¿La asesoría es para hombres y para mujeres?",
        a: "Para ambos. El programa se diseña sobre la identidad, la morfología y los objetivos de cada persona, sin importar el género. Trabajamos con ejecutivos, líderes, profesionales y figuras públicas.",
    },
    {
        q: "¿Cómo empiezo?",
        a: "El primer paso es solicitar una valoración a través del formulario de contacto. En ella evaluamos tu punto de partida y tus objetivos para confirmar si el programa es el adecuado para ti antes de iniciar.",
    },
];

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Service",
            "@id": "https://rogermurillo.co/servicios/asesoria-integral-imagen/#service",
            name: "Asesoría de Imagen Personal Integral",
            serviceType: "Asesoría de imagen personal",
            provider: { "@id": "https://rogermurillo.co/#organization" },
            areaServed: [
                { "@type": "City", name: "Bogotá" },
                { "@type": "Country", name: "Colombia" },
            ],
            description: seoData.description,
            offers: {
                "@type": "Offer",
                price: "1650",
                priceCurrency: "USD",
                availability: "https://schema.org/LimitedAvailability",
                url: "https://rogermurillo.co/servicios/asesoria-integral-imagen/",
            },
        },
        {
            "@type": "FAQPage",
            "@id": "https://rogermurillo.co/servicios/asesoria-integral-imagen/#faq",
            mainEntity: faqs.map((f) => ({
                "@type": "Question",
                name: f.q,
                acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
        },
    ],
});
---

<MainLayout title={seoData.title} description={seoData.description} schema={schema}>

    <style>
        .reveal{opacity:0;transform:translateY(36px);transition:opacity 1s cubic-bezier(.16,1,.3,1) var(--delay,0s),transform 1s cubic-bezier(.16,1,.3,1) var(--delay,0s)}
        .reveal.is-in{opacity:1;transform:translateY(0)}
        .pillar:hover .pillar-num{color:var(--color-brand-primary);-webkit-text-stroke-color:var(--color-brand-primary)}
        .pillar-num{transition:all .5s}
        .num-huge{font-style:italic;color:rgba(196,18,48,.08);line-height:.8;position:absolute;pointer-events:none;user-select:none}
        .tag{display:inline-block;font-size:10px;letter-spacing:.3em;text-transform:uppercase;padding:6px 14px;border:1px solid currentColor;border-radius:999px}

        /* Door opening effect — pure CSS, no JS */
        .door-wrap{position:absolute;inset:0;z-index:20;pointer-events:none;overflow:hidden}
        .door{
            position:absolute;top:0;bottom:0;width:50%;
            background:
                /* Red center seam */
                linear-gradient(90deg,transparent calc(100% - 2px),rgba(201,17,30,.6) 100%),
                /* Vertical wood grain */
                repeating-linear-gradient(180deg,rgba(255,255,255,.02) 0 2px,transparent 2px 60px),
                /* Base gradient — darker than hero bg so doors visible */
                linear-gradient(135deg,#1a1a1a 0%,#0f0f0f 50%,#050505 100%);
            box-shadow:inset 0 0 120px rgba(0,0,0,.8), 0 0 40px rgba(0,0,0,.6);
            transform-origin:center;
        }
        .door-left{left:0;animation:doorOpenLeft 1.8s cubic-bezier(.76,0,.24,1) .5s both}
        .door-right{right:0;animation:doorOpenRight 1.8s cubic-bezier(.76,0,.24,1) .5s both;
            background:
                linear-gradient(90deg,rgba(201,17,30,.6) 0%,transparent 2px),
                repeating-linear-gradient(180deg,rgba(255,255,255,.02) 0 2px,transparent 2px 60px),
                linear-gradient(225deg,#1a1a1a 0%,#0f0f0f 50%,#050505 100%);
        }
        .door-handle{
            position:absolute;top:50%;width:4px;height:80px;
            background:linear-gradient(180deg,#C9111E,#7a0a12);
            box-shadow:0 0 20px rgba(201,17,30,.8),inset 0 1px 0 rgba(255,255,255,.2);
            transform:translateY(-50%);
            border-radius:2px;
        }
        .door-left .door-handle{right:22px}
        .door-right .door-handle{left:22px}
        @keyframes doorOpenLeft{
            0%{transform:translateX(0)}
            100%{transform:translateX(-101%)}
        }
        @keyframes doorOpenRight{
            0%{transform:translateX(0)}
            100%{transform:translateX(101%)}
        }

        /* Chapter sidebar */
        .chapter-nav{position:fixed;left:2rem;top:50%;transform:translateY(-50%);z-index:30;display:none;flex-direction:column;gap:1.25rem}
        @media (min-width:1280px){.chapter-nav{display:flex}}
        .chapter-nav a{display:flex;align-items:center;gap:.75rem;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:rgba(10,10,10,.35);transition:color .4s;text-decoration:none}
        .chapter-nav a::before{content:"";width:18px;height:1px;background:currentColor;transition:width .4s}
        .chapter-nav a.is-active{color:var(--color-brand-primary,#C9111E)}
        .chapter-nav a.is-active::before{width:36px}
        .chapter-nav a:hover{color:var(--color-brand-primary,#C9111E)}
        .chapter-nav.on-dark a{color:rgba(255,255,255,.45)}
        .chapter-nav.on-dark a.is-active{color:#fff}
    </style>

    <!-- Chapter sidebar (desktop only) -->
    <nav class="chapter-nav" aria-label="Índice del servicio">
        <a href="#umbral" data-target="umbral">Umbral</a>
        <a href="#metodo" data-target="metodo">Método</a>
        <a href="#sesion" data-target="sesion">Sesión</a>
        <a href="#inversion" data-target="inversion">Inversión</a>
    </nav>

    <script>
        // Active chapter highlight + dark/light nav color based on section bg
        const sections = ['umbral','metodo','sesion','inversion']
            .map(id => document.getElementById(id))
            .filter(Boolean);
        const links = document.querySelectorAll('.chapter-nav a');
        const nav = document.querySelector('.chapter-nav');

        const darkSections = new Set(['umbral','inversion']); // bg-brand-black

        const activeObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    links.forEach(l => l.classList.toggle('is-active', l.dataset.target === id));
                    if (nav) nav.classList.toggle('on-dark', darkSections.has(id));
                }
            });
        }, { rootMargin: '-40% 0px -50% 0px' });

        sections.forEach(s => activeObserver.observe(s));
    </script>

    <!-- HERO -->
    <section id="umbral" class="pt-40 pb-32 md:pt-48 md:pb-40 bg-brand-black text-white relative overflow-hidden">
        <!-- Door opening effect -->
        <div class="door-wrap" aria-hidden="true">
            <div class="door door-left">
                <span class="door-handle"></span>
            </div>
            <div class="door door-right">
                <span class="door-handle"></span>
            </div>
        </div>
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="flex items-center gap-5 mb-14">
                <span class="w-12 h-px bg-brand-primary"></span>
                <p class="text-[10px] tracking-[0.4em] uppercase text-white/60">Signature · Servicio 01</p>
            </div>
            <h1 class="font-serif leading-[0.85]">
                <AnimatedTitleWords text="A puerta" class="block text-5xl md:text-8xl lg:text-9xl text-white" />
                <AnimatedTitleWords text="cerrada." class="block text-5xl md:text-8xl lg:text-9xl italic text-brand-primary pl-[8%]" delay={300} />
            </h1>
            <div class="mt-16 max-w-xl ml-auto border-l-2 border-brand-primary pl-8">
                <p class="text-lg font-light text-white/70 leading-relaxed">Porque la imagen personal no se diseña en un pasillo. Se construye en silencio, con dos miradas honestas y el tiempo que pida la verdad.</p>
            </div>
        </div>
    </section>

    <!-- QUÉ ES -->
    <section id="metodo" class="py-32 md:py-40 bg-white relative overflow-hidden">
        <span class="num-huge font-serif text-[28vw] -right-[4%] -top-[8%] absolute">01</span>
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="grid lg:grid-cols-12 gap-12">
                <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
                    <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-6">Qué es</p>
                    <h2 class="font-serif text-4xl md:text-6xl leading-[0.95] text-brand-black mb-8">
                        Una sesión de<br/><span class="italic">estrategia</span><br/>personal.
                    </h2>
                    <p class="text-base text-neutral-500 font-light leading-relaxed max-w-md">No es una cita de peluquería. Es la conversación que define cómo quieres ser visto los próximos cinco años — y el plan técnico para llegar ahí.</p>
                </div>
                <div class="lg:col-span-7 space-y-16">
                    <div class="reveal border-l border-neutral-200 pl-8">
                        <p class="font-serif italic text-brand-primary text-xl mb-4">i.</p>
                        <h3 class="font-serif text-3xl text-brand-black mb-3">Construcción consciente de identidad</h3>
                        <p class="text-neutral-600 font-light leading-relaxed">Unimos la profundidad del coaching con el diseño estético estratégico para que dejes de ser espectadora y asumas el rol de directora y protagonista de tu propia historia.</p>
                    </div>
                    <div class="reveal border-l border-neutral-200 pl-8" style="--delay:.1s">
                        <p class="font-serif italic text-brand-primary text-xl mb-4">ii.</p>
                        <h3 class="font-serif text-3xl text-brand-black mb-3">Dos perspectivas, una ruta</h3>
                        <p class="text-neutral-600 font-light leading-relaxed">Roger aporta la mirada masculina, el coaching y la psicología. Adriana, la mirada femenina, el color y la estética. Tu imagen se valida desde ambos lados.</p>
                    </div>
                    <div class="reveal border-l border-neutral-200 pl-8" style="--delay:.2s">
                        <p class="font-serif italic text-brand-primary text-xl mb-4">iii.</p>
                        <h3 class="font-serif text-3xl text-brand-black mb-3">11 fases de transformación</h3>
                        <p class="text-neutral-600 font-light leading-relaxed">Desde la auditoría en tu hogar hasta la última ruta de accesorios. Un proceso integral con acompañamiento VIP por WhatsApp durante un año.</p>
                    </div>
                    <div class="reveal border-l border-neutral-200 pl-8" style="--delay:.3s">
                        <p class="font-serif italic text-brand-primary text-xl mb-4">iv.</p>
                        <h3 class="font-serif text-3xl text-brand-black mb-3">Libro + Informe + Academia</h3>
                        <p class="text-neutral-600 font-light leading-relaxed">Incluye el libro físico <em>Revoluciona tu Imagen</em>, informe de asesoría con estudio morfológico, guía de prendas, análisis digital de colorimetría, análisis físico con 200 telas, y acceso a cursos virtuales.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TRES PILARES -->
    <section class="py-32 md:py-40 bg-brand-black text-white relative overflow-hidden">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="max-w-2xl mb-24">
                <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-6">Tres pilares</p>
                <h2 class="font-serif text-5xl md:text-7xl leading-[0.92]">
                    Lo que protege<br/>el <span class="italic text-neutral-500">umbral.</span>
                </h2>
            </div>
            <div class="grid md:grid-cols-3 gap-12 md:gap-6">
                <div class="pillar reveal">
                    <span class="pillar-num font-serif italic text-[12vw] leading-none text-transparent block" style="-webkit-text-stroke:1px rgba(255,255,255,.2)">01</span>
                    <div class="border-t border-white/20 pt-6 mt-4">
                        <h3 class="font-serif text-3xl mb-4">Intimidad</h3>
                        <p class="text-sm text-white/50 font-light leading-relaxed">Un cupo por franja. Sin salas compartidas, sin miradas cruzadas. Tu proceso ocurre en un espacio solo tuyo.</p>
                    </div>
                </div>
                <div class="pillar reveal" style="--delay:.1s">
                    <span class="pillar-num font-serif italic text-[12vw] leading-none text-transparent block" style="-webkit-text-stroke:1px rgba(255,255,255,.2)">02</span>
                    <div class="border-t border-white/20 pt-6 mt-4">
                        <h3 class="font-serif text-3xl mb-4">Confianza</h3>
                        <p class="text-sm text-white/50 font-light leading-relaxed">Dos consultores certificados. El criterio está sustentado en formación (IDB, New York Institute) y 15 años de trayectoria.</p>
                    </div>
                </div>
                <div class="pillar reveal" style="--delay:.2s">
                    <span class="pillar-num font-serif italic text-[12vw] leading-none text-transparent block" style="-webkit-text-stroke:1px rgba(255,255,255,.2)">03</span>
                    <div class="border-t border-white/20 pt-6 mt-4">
                        <h3 class="font-serif text-3xl mb-4">Confort</h3>
                        <p class="text-sm text-white/50 font-light leading-relaxed">Estudio privado en Bogotá diseñado para pensar, no para posar. Café, tiempo sin reloj y conversación honesta.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PULL QUOTE -->
    <section class="py-32 md:py-40 bg-neutral-50 relative overflow-hidden">
        <div class="container mx-auto px-6 max-w-5xl">
            <p class="font-serif italic text-4xl md:text-6xl lg:text-7xl leading-[1.05] text-brand-black">
                <span class="text-brand-primary">"</span>La imagen personal<br/>
                no empieza en la ropa.<br/>
                <span class="text-neutral-400">Empieza en la</span> identidad<span class="text-brand-primary">."</span>
            </p>
            <div class="mt-12 flex items-center gap-5">
                <span class="w-12 h-px bg-brand-primary"></span>
                <p class="text-[10px] tracking-[0.3em] uppercase text-neutral-500">Roger & Adriana · Premisa del estudio</p>
            </div>
        </div>
    </section>

    <!-- PROCESO DE 11 FASES -->
    <section id="sesion" class="py-32 md:py-40 bg-white">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="max-w-2xl mb-20">
                <p class="text-xs tracking-[0.3em] uppercase text-brand-primary mb-6">Tu proceso de transformación</p>
                <h2 class="font-serif text-5xl md:text-6xl leading-[0.95] text-brand-black">
                    11 fases.<br/><span class="italic text-neutral-400">Una revolución personal.</span>
                </h2>
            </div>
            <div class="space-y-0">
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">01</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Visita inicial</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Auditoría en tu hogar</p><p class="text-sm text-neutral-500 font-light">Inmersión en tu fondo de armario: marcas, tallas y estilos. Fotografías técnicas para estudio morfológico y facial, test de color inicial para diseñar tu paleta personal.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">02</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Entrevista de identidad</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Sesión profunda con Roger</p><p class="text-sm text-neutral-500 font-light">Sesión virtual para alinear tu imagen al 100% con tus necesidades reales y tus metas de vida. Foco consciente y coherente.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">03</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Acompañamiento VIP</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Canal exclusivo por WhatsApp</p><p class="text-sm text-neutral-500 font-light">Roger, Adriana y tú. Al enviarnos tu outfit diario, convertimos el día a día en la mejor herramienta para potenciar tu comunicación no verbal en tiempo real. Un año de acompañamiento.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">04</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Entrega del informe</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">El diseño de tu nueva imagen</p><p class="text-sm text-neutral-500 font-light">En un espacio neutral, te presentamos tu nueva propuesta de imagen. No avanzamos hasta que sientas que refleja tu verdadera esencia con total satisfacción.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">05</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Ruta de compras 1</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Prendas íntimas + recorrido estratégico</p><p class="text-sm text-neutral-500 font-light">Te enseñamos a navegar el mercado de la moda: marcas aliadas, tallas, silueta, colores, textiles y estilo personal. Aprende a ser tu propia personal shopper.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">06</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Peluquería</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Transformación capilar</p><p class="text-sm text-neutral-500 font-light">En nuestra peluquería especializada: cambio de cabello según tu morfología facial, diagnóstico capilar y pautas de estilismo en casa.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">07</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Automaquillaje</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Clases presenciales personalizadas</p><p class="text-sm text-neutral-500 font-light">Desde rutinas de skin care hasta técnicas profesionales de maquillaje según la ocasión. Construimos juntas tu kit esencial.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">08</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Ruta de compras 2</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Construcción de tu nueva morfología</p><p class="text-sm text-neutral-500 font-light">Acompañada por Roger y Adriana en tiendas. Comprar se convierte en un momento divertido, inteligente y altamente productivo.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">09</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Integración final</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Fondo de armario 2.0</p><p class="text-sm text-neutral-500 font-light">Regresamos a tu clóset para integrar las nuevas adquisiciones. Te enseñamos a combinar cada pieza y a organizar el espacio estratégicamente.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">10</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Academia virtual</p></div>
                    <div class="md:col-span-7"><p class="font-serif text-2xl text-brand-black mb-2">Cursos de color, textiles y estilos</p><p class="text-sm text-neutral-500 font-light">Acceso a formación especializada online para que domines permanentemente el lenguaje de tu imagen.</p></div>
                </div>
                <div class="grid md:grid-cols-12 gap-6 py-10 border-t border-b border-neutral-200 reveal">
                    <div class="md:col-span-2"><p class="font-serif text-3xl italic text-brand-primary">11</p></div>
                    <div class="md:col-span-3"><p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400">Ruta de compras 3</p></div>
