---
import MainLayout from "@/layouts/MainLayout.astro";
import ServiceExperience from "@/components/ServiceExperience.astro";
import ServicePreparation from "@/components/ServicePreparation.astro";

const title = "Corte de cabello en Bogotá con visagismo | Roger Murillo";
const description = "Agenda tu corte de cabello en Bogotá con visagismo. Revisamos tu rostro, la textura de tu pelo y tu rutina para diseñar un corte que puedas mantener en casa.";
const bookingUrl = "/contacto/?interes=peluqueria#form";
const url = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${url}#service`,
    name: "Corte de cabello con visagismo en Bogotá",
    serviceType: "Corte de cabello personalizado",
    provider: { "@id": "https://rogermurillo.co/#organization" },
    areaServed: { "@type": "City", name: "Bogotá" },
    url,
};
---

<MainLayout {title} {description} {schema} navbarTheme="light" breadcrumbsInFlow>
    <ServiceExperience service="corte" />
    <ServiceExperience service="corte" part="journey" />

    <section class="cut-note" aria-labelledby="cut-note-title">
        <div class="cut-note-inner">
            <p class="cut-note-label">VISAGISMO / GUÍA DEL ESTUDIO</p>
            <h2 id="cut-note-title">¿Qué quieres que haga <em>tu corte?</em></h2>
            <div class="cut-note-copy">
                <p>Dar movimiento, conservar el largo o simplificar el peinado son objetivos distintos. Identificar el tuyo nos ayuda a decidir cómo trabajar el contorno y el volumen de tu cabello.</p>
                <a href="/herramientas/calculadora-rostro/">Explorar la forma de mi rostro <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </section>

    <ServicePreparation service="cut" />

    <nav class="service-next-links" aria-label="Seguir explorando">
        <a href="/servicios/peluqueria/">Ver todos los servicios de peluquería ↗</a>
        <a href={bookingUrl}>Solicitar una cita de corte ↗</a>
    </nav>
</MainLayout>

<style>
    .cut-note {
        background: #151515;
        color: white;
        border-bottom: 3px solid #c41230;
    }
    .cut-note-inner {
        max-width: 1280px;
        margin: auto;
        padding: 72px 48px;
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
        gap: 20px 65px;
        align-items: end;
    }
    .cut-note-label {
        grid-column: 1 / -1;
        color: #ff899d;
        font-size: 10px;
        letter-spacing: .15em;
    }
    .cut-note h2 {
        font: clamp(36px, 4.3vw, 58px)/1.06 'Playfair Display', Georgia, serif;
        letter-spacing: -.035em;
    }
    .cut-note em { color: #ff899d; }
    .cut-note-copy {
        border-left: 1px solid #6b6062;
        padding-left: 28px;
        color: #dfd9d9;
        font-size: 15px;
        line-height: 1.85;
    }
    .cut-note a {
        display: inline-flex;
        align-items: center;
        gap: 18px;
        min-height: 44px;
        margin-top: 10px;
        color: white;
        text-decoration: underline;
        text-underline-offset: 5px;
    }
    .cut-note a:focus-visible { outline: 2px solid #ff899d; outline-offset: 4px; }
    @media (max-width: 700px) {
        .cut-note-inner { padding: 46px 24px; grid-template-columns: 1fr; gap: 18px; }
        .cut-note-copy { padding-left: 16px; }
    }
</style>
