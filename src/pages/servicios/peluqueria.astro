---
import PageChapters from "@/components/PageChapters.astro";
import ServiceExperience from '@/components/ServiceExperience.astro';
import ServicePreparation from '@/components/ServicePreparation.astro';
import ColorPaths from '@/components/ColorPaths.astro';
import MainLayout from "@/layouts/MainLayout.astro";
import ServiceRoutes from "@/components/ServiceRoutes.astro";
import RealCases from "@/components/RealCases.astro";
import { ArrowRight } from "lucide-react";

const seoData = {
    title: "Peluquería y visagismo en Bogotá | Roger Murillo",
    description:
        "Peluquería con asesoría de imagen en Bogotá: corte, color y visagismo para hombres y mujeres. Atención con cita previa en Colina Campestre.",
    image: "/og-image.jpg",
};

const servicios = [
    {
        n: "01",
        title: "Arquitectura del Corte",
        desc: "Un corte va mucho más allá de pasar la tijera. Realizamos un análisis morfológico detallado para entender la forma de tu cabeza, tus facciones y la calidad de tu fibra capilar. Construimos una arquitectura capilar exacta que armoniza con tu edad, profesión y estilo personal. Le \"ponemos la cabeza a tu cuerpo\".",
        sub: "Hombre & Mujer",
    },
    {
        n: "02",
        title: "Color, Balayage & Iluminaciones",
        desc: "Iniciamos con un test de colorimetría estacional para analizar cómo reaccionan tus niveladores naturales (piel, ojos y cabello) ante la luz. Revisamos el tono que buscas y el estado del cabello para definir una propuesta de color y sus condiciones antes del proceso.",
        sub: "Hombre & Mujer",
    },
    {
        n: "03",
        title: "Maquillaje & Peinado",
        desc: "Funcionamos como un escáner estético: revisamos tu tarjeta de invitación, la ocasión de uso, el vestido elegido, tu morfología y tu paleta de color. Diseñamos en perfecta coherencia el peinado y el maquillaje ideal para potenciar tu presencia escénica con simplicidad altamente refinada.",
        sub: "Total Look · Eventos",
    },
    {
        n: "04",
        title: "Reconstrucción Capilar",
        desc: "Revisamos el estado y la textura del cabello para orientar los cuidados y tratamientos cosméticos. El equipo confirma las opciones y su alcance según tu caso.",
        sub: "Hombre & Mujer",
    },
    {
        n: "05",
        title: "Evaluación con Capilógrafo",
        desc: "La observación con capilógrafo ayuda a conversar sobre el aspecto del cuero cabelludo y el cabello antes de definir cuidados cosméticos. Esta evaluación no sustituye una consulta dermatológica ni diagnostica enfermedades o deficiencias nutricionales.",
        sub: "Evaluación cosmética",
    },
    {
        n: "06",
        title: "Asesoría de Imagen & Visagismo",
        desc: "Revisamos profundamente tu morfología facial, la forma de tu cabeza, las proporciones de tu cuello y espalda, y la estructura de tu pelo. Escuchamos tus necesidades para construir un estilo coherente. Hacemos de tu pelo el accesorio más importante: le ponemos la cabeza a tu cuerpo.",
        sub: "Hombre & Mujer",
    },
];

const diferenciales = [
    { n: "01", title: "A puerta cerrada",  desc: "Intimidad total. Sin esperas. Sin ruido." },
    { n: "02", title: "Doble perspectiva", desc: "La visión masculina y femenina trabajando juntas." },
    { n: "03", title: "Productos premium", desc: "L'Oréal, Kérastase, Olaplex. Solo lo mejor." },
];
const hairFaqs = [{"q": "¿La asesoría de cabello es para hombres y mujeres?", "a": "Sí. El corte y el color se revisan según tu rostro, la textura del cabello, tus preferencias y tu rutina. Puedes consultar por una necesidad capilar sin solicitar el programa integral de imagen."}, {"q": "¿Qué diferencia hay entre un corte y una asesoría de imagen integral?", "a": "La peluquería se centra en el cabello, el corte, el color y el peinado. El programa integral incluye además vestuario, armario, análisis de color, rutas de compra y acompañamiento por fases."}, {"q": "¿Cómo consulto el precio y la disponibilidad?", "a": "Indica qué servicio necesitas al enviar tu solicitud. El equipo confirma el alcance, el valor y la disponibilidad antes de reservar. Los cuatro cupos mensuales anunciados corresponden al programa integral."}, {"q": "¿Dónde se realiza la cita?", "a": "En el estudio de Calle 163 B No. 48-80, Local 208, Edificio Britalia Comercial y Empresarial, Bogotá. La atención es con cita previa."}, {"q": "¿Puedo usar la calculadora de rostro antes de consultar?", "a": "Sí. Es una orientación inicial para conversar sobre tus preferencias. No sustituye la revisión de proporciones, textura y caída del cabello durante la cita."}];
const hairSchema = {"@context":"https://schema.org","@type":"Service","@id":"https://rogermurillo.co/servicios/peluqueria/#service","name":"Peluquería con asesoría de imagen y visagismo en Bogotá","serviceType":"Peluquería y visagismo","provider":{"@id":"https://rogermurillo.co/#organization"},"areaServed":{"@type":"City","name":"Bogotá"},"url":"https://rogermurillo.co/servicios/peluqueria/"};

---

<MainLayout title={seoData.title} description={seoData.description} schema={hairSchema} navbarTheme="light" breadcrumbsInFlow>
    <div id="rm-progress" class="fixed top-0 left-0 right-0 h-[2px] bg-brand-primary z-[80] origin-left" style="transform:scaleX(0)"></div>

    <!-- HERO -->
    <ServiceExperience service="peluqueria" />
    <ServiceExperience service="peluqueria" part="journey" />
    <ColorPaths current="hair" />
    <PageChapters />

    <!-- SERVICES GRID -->
    <section class="bg-neutral-50 py-28 md:py-40">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="max-w-xl mb-20 reveal">
                <p class="text-[10px] tracking-[0.4em] uppercase text-brand-primary mb-6">Servicios</p>
                <h2 class="font-serif text-4xl md:text-6xl leading-[1] text-brand-black">
                    Todo bajo<br/>
                    <span class="italic text-neutral-400">un mismo techo.</span>
                </h2>
            </div>

            <div class="hair-menu">
                {servicios.map((service,i)=><details open={i===0}><summary><span class="hair-menu-number">{service.n}</span><span>{service.title}<small>{service.sub}</small></span><span class="hair-menu-plus" aria-hidden="true">+</span></summary><div class="hair-menu-detail"><p>{service.desc}</p><a href="/contacto/?interes=peluqueria#form">Consultar este servicio <span aria-hidden="true">↗</span></a></div></details>)}
            </div>
            <style>
                .hair-menu{border-top:1px solid #d3d3d3}.hair-menu details{border-bottom:1px solid #d3d3d3}.hair-menu summary{display:flex;align-items:center;gap:30px;padding:28px 0;cursor:pointer;list-style:none;color:#111111}.hair-menu summary::-webkit-details-marker{display:none}.hair-menu-number{font:15px Georgia,serif;color:#777777;align-self:start;margin-top:6px}.hair-menu summary>span:nth-child(2){flex:1;font:clamp(26px,3vw,38px) 'Playfair Display',Georgia,serif;letter-spacing:-.025em}.hair-menu small{display:block;font:9px/1.6 Arial,sans-serif;text-transform:uppercase;letter-spacing:.15em;color:#626262;margin-top:9px}.hair-menu-plus{font-size:28px;color:#C41230;border:1px solid #d3d3d3;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;transition:transform .2s}.hair-menu details[open] .hair-menu-plus{transform:rotate(45deg)}.hair-menu-detail{padding:0 50px 30px;display:grid;grid-template-columns:1fr auto;gap:35px;align-items:end}.hair-menu-detail p{max-width:700px;font-size:14px;line-height:1.9;color:#555555}.hair-menu-detail a{display:flex;align-items:center;gap:20px;font-size:11px;color:#C41230;border-bottom:1px solid #C41230;padding:12px 0;white-space:nowrap}.hair-menu-detail a>span{font-size:20px}@media(max-width:700px){.hair-menu summary{gap:15px;padding:23px 0}.hair-menu-detail{padding:0 0 25px 30px;grid-template-columns:1fr;gap:12px}.hair-menu-detail a{justify-self:start}}
            </style>
        </div>
    </section>

    <RealCases />

    <!-- DIFFERENTIATOR -->
    <section class="py-28 md:py-40 bg-white">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="grid md:grid-cols-12 gap-16 md:gap-24 items-start">
                <div class="md:col-span-7 reveal">
                    <p class="text-[10px] tracking-[0.4em] uppercase text-neutral-400 mb-6">El Diferencial</p>
                    <h2 class="font-serif text-4xl md:text-6xl leading-[1] text-brand-black mb-10">
                        Peluquería<br/>
                        <span class="italic">con ciencia detrás.</span>
                    </h2>
                    <p class="text-lg text-neutral-500 font-light leading-relaxed mb-8">
                        Aquí no entras a "cortarte el pelo". Entras a un estudio privado donde dos profesionales
                        &mdash;uno con perspectiva masculina, otra con perspectiva femenina&mdash; analizan tu rostro,
                        tu estilo de vida y tus objetivos antes de tomar la tijera.
                    </p>
                    <blockquote class="text-base md:text-lg text-brand-black font-light leading-relaxed border-l-2 border-brand-primary pl-6 italic max-w-lg">
                        La imagen personal no empieza en la ropa &mdash; empieza en la identidad.
                        Y tu cabello es parte fundamental de esa identidad.
                    </blockquote>
                </div>

                <div class="md:col-span-5 md:pt-20 reveal" style="--delay:.1s">
                    {diferenciales.map((d) => (
                        <div class="diff-row py-7">
                            <p class="text-[10px] tracking-[0.3em] uppercase text-brand-primary mb-2">{d.n}</p>
                            <h3 class="font-serif text-xl text-brand-black mb-2">{d.title}</h3>
                            <p class="text-sm text-neutral-500 font-light leading-relaxed">{d.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-28 md:py-40 bg-brand-black text-white text-center relative overflow-hidden">
        <span class="num-huge text-[40vw] -right-[18%] top-1/2 -translate-y-1/2" style="color:rgba(255,255,255,.03)">✂</span>
        <div class="container mx-auto px-6 max-w-3xl relative z-10">
            <p class="text-[10px] tracking-[0.4em] uppercase text-neutral-500 mb-8">Solo con cita previa</p>
            <h2 class="font-serif text-4xl md:text-6xl leading-[1.02] mb-10">
                Reserva tu cita<br/>
                <span class="text-neutral-500 italic">de peluquería.</span>
            </h2>
            <p class="text-base md:text-lg text-neutral-400 font-light leading-relaxed max-w-xl mx-auto mb-12">
                Trabajamos exclusivamente con cita previa. Agenda tu espacio y vive la experiencia "A Puerta Cerrada".
            </p>
            <a href="/contacto/?interes=peluqueria#form" class="cta-btn inline-flex items-center gap-3 bg-brand-primary text-white px-12 py-5 text-[11px] font-medium uppercase tracking-[0.25em] hover:bg-white hover:text-brand-black">
                Agendar Cita
                <ArrowRight className="w-3.5 h-3.5" />
            </a>
        </div>
    </section>
    <ServicePreparation service="hair" />

    <nav class="service-next-links" aria-label="Otros servicios"><a href="/servicios/">Comparar todos los servicios ↗</a><a href="/servicios/colorimetria-bogota/">Colorimetría personal ↗</a><a href="/servicios/asesoria-imagen-hombres-bogota/">Fondo de armario para hombres ↗</a></nav>
</MainLayout>

<style is:global>
    /* Editorial service shared styles */
    .reveal { opacity:0; transform:translateY(36px); transition: opacity 1s cubic-bezier(.16,1,.3,1) var(--delay,0s), transform 1s cubic-bezier(.16,1,.3,1) var(--delay,0s); }
    .reveal.is-in { opacity:1; transform:translateY(0); }

    .hero-line { opacity:0; transform:translateY(100%); animation: heroLineIn 1.1s cubic-bezier(.22,1,.36,1) forwards; display:block; }
    .hero-line:nth-child(1) { animation-delay:.15s; }
    .hero-line:nth-child(2) { animation-delay:.3s; }
    .hero-line:nth-child(3) { animation-delay:.45s; }
    @keyframes heroLineIn { to { opacity:1; transform:translateY(0); } }

    .num-huge { font-family:'Playfair Display',serif; font-style:italic; line-height:.8; position:absolute; pointer-events:none; user-select:none; }
    .ph { position:relative; overflow:hidden; }
    .ph::after { content:""; position:absolute; inset:0; background: linear-gradient(135deg, rgba(255,255,255,.04) 0%, transparent 50%, rgba(0,0,0,.25) 100%); }

    .marker { display:inline-block; width:28px; height:1px; background:#C41230; vertical-align:middle; margin-right:14px; }

    /* Scissor animation */
    .scissor { animation: snip 3.2s cubic-bezier(.7,0,.3,1) infinite; transform-origin:center; }
    @keyframes snip { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }

    /* Service cards · negro entra desde arriba en hover, todos los textos a blanco */
    .svc-card { transition: background .5s cubic-bezier(.16,1,.3,1), color .5s; position:relative; overflow:hidden; }
    .svc-card::before { content:""; position:absolute; left:0; top:0; width:100%; height:0; background:#0a0a0a; transition: height .6s cubic-bezier(.7,0,.3,1); z-index:0; }
    .svc-card:hover::before { height:100%; }
    .svc-card > * { position:relative; z-index:1; }
    .svc-card:hover .svc-title { color:#fff; }
    .svc-card:hover .svc-num { color:#C41230; }
    .svc-card:hover .svc-sub { color: rgba(255,255,255,.55); border-color: rgba(255,255,255,.15); }
    .svc-card:hover .svc-desc { color: rgba(255,255,255,.8); }
    .svc-title { transition: color .5s; }
    .svc-desc { transition: color .5s; }
    .svc-sub { transition: color .5s, border-color .5s; }
    .svc-num { font-family:'Playfair Display',serif; font-style:italic; color:#C41230; line-height:.85; transition: color .4s; }

    .diff-row { border-top: 1px solid rgba(10,10,10,.1); }
    .diff-row:last-child { border-bottom: 1px solid rgba(10,10,10,.1); }

    .cta-btn { transition: background .5s, color .5s; }
</style>

<script>
    // Scroll progress bar
    const bar = document.getElementById('rm-progress');
    if (bar) {
        addEventListener('scroll', () => {
            const h = document.documentElement;
            const p = h.scrollTop / (h.scrollHeight - h.clientHeight);
            bar.style.transform = `scaleX(${p})`;
        });
    }
    // Reveal on scroll
    const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && e.target.classList.add('is-in')), { threshold: .12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
